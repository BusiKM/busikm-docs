rules_version = '2';

// Reguły Firestore dla BusiKM — kolekcja `wiadomosci` z formularza kontaktowego.
//
// Klucze klienta Firebase są publiczne z założenia, więc to te reguły, a nie
// klucze, decydują o bezpieczeństwie. Pozwalamy wyłącznie utworzyć wiadomość
// i tylko taką, która przejdzie walidację. Odczyt, edycja i kasowanie są
// zamknięte dla wszystkich — zgłoszenia czyta się z konsoli albo Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {

    match /wiadomosci/{id} {
      allow read, update, delete: if false;
      allow create: if poprawnaWiadomosc(request.resource.data);
    }

    // Wszystko inne zablokowane.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function poprawnaWiadomosc(d) {
    return d.keys().hasOnly(['imie', 'email', 'temat', 'tresc', 'createdAt', 'source'])
      && d.keys().hasAll(['imie', 'email', 'temat', 'tresc', 'createdAt'])
      && d.imie is string && d.imie.size() > 0 && d.imie.size() <= 120
      && d.email is string && d.email.size() <= 160 && d.email.matches('.+@.+[.].+')
      && d.tresc is string && d.tresc.size() > 0 && d.tresc.size() <= 4000
      && d.temat in ['pytanie przed zakupem', 'pomoc techniczna', 'rozliczenia i faktury', 'coś innego']
      && d.createdAt == request.time
      && (!('source' in d) || d.source == 'busikm-landing');
  }
}
