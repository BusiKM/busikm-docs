# Zmienne środowiskowe landingu BusiKM.
# Skopiuj do `.env.local` na czas pracy lokalnej, a na produkcji ustaw
# w panelu Vercela (Project → Settings → Environment Variables).

# Identyfikator Google Analytics 4, format G-XXXXXXXXXX.
# Bez niego licznik w ogóle się nie ładuje — dlatego podglądy i praca
# lokalna nie zaśmiecają statystyk. Ustaw wyłącznie dla środowiska
# „Production".
NEXT_PUBLIC_GA_ID=

# Kod weryfikacyjny z Google Search Console (metoda „znacznik HTML").
# Wklej samą wartość atrybutu `content`, bez całego znacznika.
GOOGLE_SITE_VERIFICATION=

# --- Formularz kontaktowy -----------------------------------------------
# Firebase (klient) — klucze publiczne aplikacji webowej. Bez kompletu tych
# zmiennych formularz cofa się do `mailto:` i nadal działa.
# Konsola Firebase → Ustawienia projektu → Twoje aplikacje → konfiguracja SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Powiadomienie e-mail o nowej wiadomości (trasa /api/powiadom, wysyłka Resend).
# Klucz z resend.com — nigdy nie commitować.
RESEND_API_KEY=
# Skrzynka, na którą mają trafiać zgłoszenia:
POWIADOM_NA=kontakt@busikm.pl
# Nadawca. Po weryfikacji domeny w Resend: "BusiKM <formularz@busikm.pl>".
# Do pierwszych testów działa "BusiKM <onboarding@resend.dev>".
POWIADOM_OD=BusiKM <onboarding@resend.dev>
