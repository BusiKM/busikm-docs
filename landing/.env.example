# Zmienne środowiskowe landingu BusiKM.
# Skopiuj do `.env.local` na czas pracy lokalnej, a na produkcji ustaw
# w panelu Vercela (Project → Settings → Environment Variables).

# Identyfikator Google Analytics 4, format G-XXXXXXXXXX.
# Bez niego licznik w ogóle się nie ładuje — dlatego podglądy i praca
# lokalna nie zaśmiecają statystyk. Ustaw wyłącznie dla środowiska
# „Production".
NEXT_PUBLIC_GA_ID=

# Kod weryfikacyjny z Google Search Console (metoda „znacznik HTML").
# Wklej samą wartość atrybutu `content`, bez całego znacznika.
GOOGLE_SITE_VERIFICATION=

# --- Formularz kontaktowy -----------------------------------------------
# Firebase (klient) — klucze publiczne aplikacji webowej. Bez kompletu tych
# zmiennych formularz cofa się do `mailto:` i nadal działa.
# Konsola Firebase → Ustawienia projektu → Twoje aplikacje → konfiguracja SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Powiadomienie e-mail o nowej wiadomości (trasa /api/powiadom, wysyłka Resend).
# Klucz z resend.com — nigdy nie commitować.
RESEND_API_KEY=
# Skrzynka, na którą mają trafiać zgłoszenia:
POWIADOM_NA=kontakt@busikm.pl
# Nadawca. Domena busikm.pl jest w Resend zweryfikowana, więc wysyłamy
# z własnego adresu — skrzynka `formularz@` nie musi istnieć, bo odpowiedzi
# idą przez `reply_to` na adres osoby, która napisała.
# Wartość w cudzysłowie: bez niego nawiasy ostre wysypują plik przy
# wczytaniu go shellem.
POWIADOM_OD="BusiKM <formularz@busikm.pl>"

# --- Lista mailingowa (Klaviyo) ------------------------------------------
# Klucz prywatny z Klaviyo → Settings → API keys → Create Private API Key.
# Zakres: Profiles (Write) + Subscriptions (Write). NIGDY nie commitować
# i nie przesyłać w wiadomościach — w Vercelu ma być typu Secret.
KLAVIYO_API_KEY=
# Identyfikator listy: Audience → Lists & Segments → wybrana lista → Settings.
# Sześć znaków, np. XyZ123. Nie jest tajny.
KLAVIYO_LISTA_ID=
