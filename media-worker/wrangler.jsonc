{
  "name": "busikm-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "busikm-public"
    }
  ],
  // Uruchamia akcję „Rolki” w GitHubie (src/index.ts, scheduled).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
