---
// Announcement bar — sits below the fixed header on all marketing pages.
// Hidden automatically on /g2v2-przygotowanie (would link to itself).

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hide = path === '/g2v2-przygotowanie';

// Build-time fallback (gets refreshed client-side after hydration).
const target = new Date('2026-07-02T00:00:00+02:00').getTime();
const now = Date.now();
const diff = target - now;
const dayWord = (n: number): string => (n === 1 ? 'dzień' : 'dni');

// Trzy stany:
//  - przed 2 lipca:  "X dni do obowiązku ..."
//  - 2 lipca (dzień wejścia obowiązku): "Od dzisiaj obowiązuje ..."
//  - po 2 lipca:     "X dni od obowiązku ..."
let initialLg: string;
let initialSm: string;
if (diff > 0) {
  const d = Math.ceil(diff / 86400000);
  initialLg = `<strong class="font-bold">${d}</strong> ${dayWord(d)} do obowiązku tachografu G2V2 dla busów 2,5–3,5 t`;
  initialSm = `<strong class="font-bold">${d}</strong> ${dayWord(d)} do tachografu G2V2`;
} else {
  const since = Math.floor((now - target) / 86400000);
  if (since === 0) {
    initialLg = 'Od dzisiaj obowiązuje tachograf G2V2 dla busów 2,5–3,5 t';
    initialSm = 'Od dzisiaj: tachograf G2V2';
  } else {
    initialLg = `<strong class="font-bold">${since}</strong> ${dayWord(since)} od obowiązku tachografu G2V2 dla busów 2,5–3,5 t`;
    initialSm = `<strong class="font-bold">${since}</strong> ${dayWord(since)} od tachografu G2V2`;
  }
}
---

{!hide && (
  <a
    href="/g2v2-przygotowanie"
    class="announcement-bar group block bg-[#FFF8EE] hover:bg-[#FFF1DC] dark:bg-warning/10 dark:hover:bg-warning/15 border-b border-warning/15 transition-colors duration-200"
    aria-label="Tachograf G2V2 dla busów 2,5–3,5 t — obowiązek od 2 lipca 2026"
  >
    <div class="max-w-[1200px] mx-auto px-5 py-2.5 flex items-center justify-center gap-2.5 sm:gap-3 text-center">
      <!-- Tachograph dial icon -->
      <svg class="w-3.5 h-3.5 text-warning shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <line x1="12" y1="6" x2="12" y2="12"/>
        <line x1="12" y1="12" x2="15.5" y2="14.5"/>
      </svg>
      <span class="relative flex h-1.5 w-1.5 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning opacity-60"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-warning"></span>
      </span>
      <span class="text-[12px] sm:text-[12.5px] font-medium text-text tracking-[0.005em]">
        <span id="g2v2-bar-lg" class="hidden sm:inline tabular-nums" set:html={initialLg} />
        <span id="g2v2-bar-sm" class="sm:hidden tabular-nums" set:html={initialSm} />
      </span>
      <span class="text-[12px] sm:text-[12.5px] font-semibold text-warning inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform duration-200">
        Sprawdź
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </a>

  <script is:inline>
    (function() {
      var lg = document.getElementById('g2v2-bar-lg');
      var sm = document.getElementById('g2v2-bar-sm');
      if (!lg || !sm) return;
      var target = new Date('2026-07-02T00:00:00+02:00').getTime();
      var DAY = 86400000;
      function word(n) { return n === 1 ? 'dzień' : 'dni'; }
      function num(n) { return '<strong class="font-bold">' + n + '</strong>'; }
      function tick() {
        var now = Date.now();
        var diff = target - now;
        if (diff > 0) {
          var d = Math.ceil(diff / DAY);
          lg.innerHTML = num(d) + ' ' + word(d) + ' do obowiązku tachografu G2V2 dla busów 2,5–3,5 t';
          sm.innerHTML = num(d) + ' ' + word(d) + ' do tachografu G2V2';
        } else {
          var since = Math.floor((now - target) / DAY);
          if (since === 0) {
            lg.innerHTML = 'Od dzisiaj obowiązuje tachograf G2V2 dla busów 2,5–3,5 t';
            sm.innerHTML = 'Od dzisiaj: tachograf G2V2';
          } else {
            lg.innerHTML = num(since) + ' ' + word(since) + ' od obowiązku tachografu G2V2 dla busów 2,5–3,5 t';
            sm.innerHTML = num(since) + ' ' + word(since) + ' od tachografu G2V2';
          }
        }
      }
      tick();
      setInterval(tick, 60000);
    })();
  </script>
)}
