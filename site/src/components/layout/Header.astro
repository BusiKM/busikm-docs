---
import { APP_LOGIN_URL } from '../../lib/app-url';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { detectLocale, t, getAlternateUrl } from '../../i18n';

const currentPath = Astro.url.pathname;
const locale = Astro.currentLocale ?? detectLocale(currentPath);
const tr = t(locale);
const isEn = locale === 'en';

// Nav routing per locale
const navLinks = isEn
  ? [
      { href: '/en/features', label: tr.nav.features },
      { href: '/en/pricing', label: tr.nav.pricing },
      { href: '/en/technology', label: tr.nav.technology },
    ]
  : [
      { href: '/funkcje', label: tr.nav.features },
      { href: '/cennik', label: tr.nav.pricing },
      { href: '/technologia', label: tr.nav.technology },
      { href: '/docs', label: tr.nav.docs },
    ];

const dlaKogo = isEn
  ? [
      { href: getAlternateUrl('/dla-biur-rachunkowych', 'en'), ...tr.forWhom.accountingFirms },
      { href: getAlternateUrl('/dla-wlascicieli', 'en'), ...tr.forWhom.owners },
      { href: getAlternateUrl('/dla-ksiegowych', 'en'), ...tr.forWhom.accountants },
      { href: getAlternateUrl('/dla-kierowcow', 'en'), ...tr.forWhom.drivers },
    ]
  : [
      { href: '/dla-biur-rachunkowych', ...tr.forWhom.accountingFirms },
      { href: '/dla-wlascicieli', ...tr.forWhom.owners },
      { href: '/dla-ksiegowych', ...tr.forWhom.accountants },
      { href: '/dla-kierowcow', ...tr.forWhom.drivers },
    ];

const roadmapHref = isEn ? '/en/' : '/roadmapa';
const g2v2Href = isEn ? '/en/' : '/g2v2-przygotowanie';
const aetrHref = isEn ? '/en/' : '/aetr';

const isDlaKogoActive = dlaKogo.some(l => currentPath === l.href || currentPath.startsWith(l.href));
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="transform: translateZ(0); backface-visibility: hidden;"
>
  <!-- Frosted glass backdrop — revealed on scroll (dark/light aware) -->
  <div
    id="header-backdrop"
    class="absolute inset-0 bg-surface/80 backdrop-blur-xl border-b border-border-subtle opacity-0 transition-opacity duration-300"
  ></div>

  <div class="relative w-full px-5 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-[60px]">

      <!-- Logo -->
      <Logo size="md" variant="wordmark" />

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Główna nawigacja">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                'nav-link px-3.5 py-1.5 rounded-full text-[13.5px] font-medium tracking-[-0.01em] transition-all duration-200',
                isActive
                  ? 'text-brand bg-brand/8'
                  : 'text-text/70 hover:text-text hover:bg-surface-2',
              ]}
            >
              {link.label}
            </a>
          );
        })}

        <!-- Dla kogo dropdown -->
        <div class="relative" id="dropdown-wrapper">
          <button
            id="dropdown-toggle"
            class:list={[
              'nav-link px-3.5 py-1.5 rounded-full text-[13.5px] font-medium tracking-[-0.01em] transition-all duration-200 flex items-center gap-1.5 cursor-pointer',
              isDlaKogoActive
                ? 'text-brand bg-brand/8'
                : 'text-text/70 hover:text-text hover:bg-surface-2',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            {tr.nav.forWhom}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform duration-200" id="dropdown-chevron">
              <path d="M2.5 4L5 6.5L7.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div
            id="dropdown-menu"
            class="absolute top-full left-1/2 -translate-x-1/2 w-[280px] opacity-0 scale-95 pointer-events-none transition-all duration-200 origin-top"
          >
            <div class="bg-surface/95 backdrop-blur-xl rounded-2xl border border-border-subtle shadow-[0_12px_48px_rgba(0,0,0,0.12)] dark:shadow-[0_12px_48px_rgba(0,0,0,0.7)] p-2">
              {dlaKogo.map(item => {
                const active = currentPath === item.href || currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      'flex flex-col px-4 py-3 rounded-xl transition-colors duration-150',
                      active
                        ? 'bg-brand/8'
                        : 'hover:bg-surface-2',
                    ]}
                  >
                    <span class:list={[
                      'text-[13.5px] font-semibold tracking-[-0.01em]',
                      active ? 'text-brand' : 'text-text',
                    ]}>{item.label}</span>
                    <span class="text-[11.5px] text-text-tertiary mt-0.5">{item.desc}</span>
                  </a>
                );
              })}
            </div>
          </div>
        </div>

        {!isEn && (
          <a
            href={roadmapHref}
            class:list={[
              'nav-link px-3.5 py-1.5 rounded-full text-[13.5px] font-medium tracking-[-0.01em] transition-all duration-200',
              currentPath.startsWith('/roadmapa')
                ? 'text-brand bg-brand/8'
                : 'text-text/70 hover:text-text hover:bg-surface-2',
            ]}
          >
            {tr.nav.roadmap}
          </a>
        )}

        {!isEn && (
          <a
            href={aetrHref}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13.5px] font-medium tracking-[-0.01em] transition-all duration-200',
              currentPath.startsWith('/aetr')
                ? 'text-brand bg-brand/10'
                : 'text-text/70 hover:text-brand hover:bg-brand/[0.06]',
            ]}
          >
            <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
            AETR
          </a>
        )}

        {!isEn && (
          <a
            href={g2v2Href}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13.5px] font-medium tracking-[-0.01em] transition-all duration-200',
              currentPath.startsWith('/g2v2-przygotowanie')
                ? 'text-warning bg-warning/10'
                : 'text-text/70 hover:text-warning hover:bg-warning/[0.06]',
            ]}
          >
            <span class="w-1.5 h-1.5 rounded-full bg-warning animate-pulse"></span>
            {tr.nav.g2v2}
          </a>
        )}
      </nav>

      <!-- CTA + utilities -->
      <div class="flex items-center gap-2">
        <!-- Lang switcher — desktop only (mobile w drawer) -->
        <div class="hidden sm:block">
          <LangSwitcher />
        </div>

        <!-- Theme toggle -->
        <ThemeToggle />

        <a
          href={APP_LOGIN_URL}
          data-app-login
          class="hidden sm:inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-brand text-white text-[13px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200 shadow-[0_1px_3px_rgba(0,92,232,0.3)]"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          {tr.nav.tryDemo}
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden w-9 h-9 flex flex-col items-center justify-center gap-[5px] rounded-full hover:bg-surface-2 transition-colors"
          aria-label="Menu"
          aria-expanded="false"
        >
          <span class="hamburger-line w-5 h-[1.5px] bg-text rounded-full transition-all duration-300 origin-center"></span>
          <span class="hamburger-line w-5 h-[1.5px] bg-text rounded-full transition-all duration-300 origin-center"></span>
          <span class="hamburger-line w-5 h-[1.5px] bg-text rounded-full transition-all duration-300 origin-center"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out"
  >
    <div class="relative bg-surface/95 backdrop-blur-xl border-t border-border-subtle px-5 pb-6 pt-4">
      <nav class="flex flex-col gap-0.5 mb-4">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                'px-4 py-3 rounded-xl text-[15px] font-medium transition-colors',
                isActive
                  ? 'text-brand bg-brand/8'
                  : 'text-text hover:bg-surface-2',
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Dla kogo — expanded in mobile -->
      <p class="px-4 mb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-text-tertiary">{tr.nav.forWhom}</p>
      <nav class="flex flex-col gap-0.5 mb-4">
        {dlaKogo.map(item => {
          const active = currentPath === item.href || currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'px-4 py-3 rounded-xl transition-colors',
                active ? 'text-brand bg-brand/8' : 'text-text hover:bg-surface-2',
              ]}
            >
              <span class="text-[15px] font-medium">{item.label}</span>
              <span class="block text-[12px] text-text-tertiary mt-0.5">{item.desc}</span>
            </a>
          );
        })}
      </nav>

      {!isEn && (
        <a
          href={roadmapHref}
          class:list={[
            'block px-4 py-3 rounded-xl text-[15px] font-medium transition-colors mb-1',
            currentPath.startsWith('/roadmapa')
              ? 'text-brand bg-brand/8'
              : 'text-text hover:bg-surface-2',
          ]}
        >
          {tr.nav.roadmap}
        </a>
      )}

      {!isEn && (
        <a
          href={aetrHref}
          class:list={[
            'flex items-center gap-2 px-4 py-3 rounded-xl text-[15px] font-medium transition-colors mb-1',
            currentPath.startsWith('/aetr')
              ? 'text-brand bg-brand/10'
              : 'text-text hover:bg-brand/[0.06] hover:text-brand',
          ]}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          AETR
          <span class="text-[12px] text-text-tertiary ml-auto">Filar compliance</span>
        </a>
      )}

      {!isEn && (
        <a
          href={g2v2Href}
          class:list={[
            'flex items-center gap-2 px-4 py-3 rounded-xl text-[15px] font-medium transition-colors mb-4',
            currentPath.startsWith('/g2v2-przygotowanie')
              ? 'text-warning bg-warning/10'
              : 'text-text hover:bg-warning/[0.06] hover:text-warning',
          ]}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-warning animate-pulse"></span>
          {tr.nav.g2v2}
          <span class="text-[12px] text-text-tertiary ml-auto">2 lipca 2026</span>
        </a>
      )}

      <!-- Language + theme switchers w mobile drawer -->
      <div class="flex items-center justify-between px-4 py-3 mb-2 border-t border-border-subtle pt-4">
        <LangSwitcher />
        <ThemeToggle />
      </div>

      <a
        href={APP_LOGIN_URL}
        data-app-login
        class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors mb-2"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        {tr.nav.tryDemo}
      </a>
      <a
        href="https://calendly.com/busikm/30min"
        target="_blank"
        rel="noopener"
        class="block text-center w-full py-3 rounded-2xl border border-border text-text text-[14px] font-semibold hover:bg-surface-2 transition-colors"
      >
        {tr.nav.bookMeeting}
      </a>
    </div>
  </div>
</header>

<!-- Spacer to push content below fixed header -->
<div class="h-[60px]"></div>

<script>
  // Frosted glass on scroll — RAF-throttled for smooth performance
  const backdrop = document.getElementById('header-backdrop');
  let lastScrolled = false;
  let ticking = false;

  const updateHeader = () => {
    const scrolled = window.scrollY > 12;
    if (scrolled !== lastScrolled) {
      backdrop?.style.setProperty('opacity', scrolled ? '1' : '0');
      lastScrolled = scrolled;
    }
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });
  updateHeader();

  // Dropdown
  const dropdownToggle = document.getElementById('dropdown-toggle');
  const dropdownMenu = document.getElementById('dropdown-menu');
  const dropdownWrapper = document.getElementById('dropdown-wrapper');
  const chevron = document.getElementById('dropdown-chevron');

  function openDropdown() {
    dropdownMenu?.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
    dropdownMenu?.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
    chevron?.style.setProperty('transform', 'rotate(180deg)');
    dropdownToggle?.setAttribute('aria-expanded', 'true');
  }
  function closeDropdown() {
    dropdownMenu?.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    dropdownMenu?.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
    chevron?.style.setProperty('transform', '');
    dropdownToggle?.setAttribute('aria-expanded', 'false');
  }

  dropdownToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = dropdownToggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeDropdown() : openDropdown();
  });

  // Hover open/close for desktop
  dropdownWrapper?.addEventListener('mouseenter', openDropdown);
  dropdownWrapper?.addEventListener('mouseleave', closeDropdown);

  // Click outside
  document.addEventListener('click', (e) => {
    if (!dropdownWrapper?.contains(e.target as Node)) closeDropdown();
  });

  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const lines = document.querySelectorAll('.hamburger-line') as NodeListOf<HTMLElement>;
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      menu!.style.maxHeight = menu!.scrollHeight + 'px';
      lines[0].style.transform = 'translateY(6.5px) rotate(45deg)';
      lines[1].style.opacity = '0';
      lines[2].style.transform = 'translateY(-6.5px) rotate(-45deg)';
    } else {
      menu!.style.maxHeight = '0';
      lines[0].style.transform = '';
      lines[1].style.opacity = '';
      lines[2].style.transform = '';
    }
  });
</script>
