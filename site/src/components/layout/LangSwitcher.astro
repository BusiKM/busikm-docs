---
/**
 * LangSwitcher — BKM-552.
 * Pill toggle PL ↔ EN. Aktualny locale podświetlony brand color.
 * Strony PL-only (np. /g2v2-przygotowanie) → przełącznik EN linkuje do `/en/`.
 */
import { detectLocale, getAlternateUrl } from '../../i18n';

const currentLocale = detectLocale(Astro.url.pathname);
const plHref = getAlternateUrl(Astro.url.pathname, 'pl');
const enHref = getAlternateUrl(Astro.url.pathname, 'en');
---

<div
  class="lang-switcher inline-flex items-center rounded-full bg-surface-2 border border-border-subtle p-0.5 text-[11px] font-semibold tracking-[0.05em] uppercase"
  role="group"
  aria-label="Język strony"
>
  <a
    href={plHref}
    class:list={[
      'px-2.5 py-1 rounded-full transition-colors duration-200',
      currentLocale === 'pl'
        ? 'bg-brand text-white shadow-sm'
        : 'text-text-secondary hover:text-text',
    ]}
    aria-current={currentLocale === 'pl' ? 'true' : 'false'}
    hreflang="pl"
  >
    PL
  </a>
  <a
    href={enHref}
    class:list={[
      'px-2.5 py-1 rounded-full transition-colors duration-200',
      currentLocale === 'en'
        ? 'bg-brand text-white shadow-sm'
        : 'text-text-secondary hover:text-text',
    ]}
    aria-current={currentLocale === 'en' ? 'true' : 'false'}
    hreflang="en"
  >
    EN
  </a>
</div>
