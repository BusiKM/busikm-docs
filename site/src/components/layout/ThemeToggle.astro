---
/**
 * ThemeToggle — BKM-547
 * 3-state cycle button: light → dark → system → light.
 * Vanilla JS island; no React. Parity z busikm-web ThemeToggle.tsx.
 *
 * Storage: localStorage.theme ∈ {light, dark, system}
 * System mode respektuje prefers-color-scheme i przełącza live przy zmianie OS.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle relative w-9 h-9 inline-flex items-center justify-center rounded-full text-text hover:bg-surface-2 transition-colors duration-200 cursor-pointer"
  aria-label="Przełącz motyw"
  title="Przełącz motyw (jasny / ciemny / systemowy)"
>
  <!-- Sun (light) -->
  <svg class="theme-icon theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2"/>
    <path d="M12 20v2"/>
    <path d="m4.93 4.93 1.41 1.41"/>
    <path d="m17.66 17.66 1.41 1.41"/>
    <path d="M2 12h2"/>
    <path d="M20 12h2"/>
    <path d="m6.34 17.66-1.41 1.41"/>
    <path d="m19.07 4.93-1.41 1.41"/>
  </svg>

  <!-- Moon (dark) -->
  <svg class="theme-icon theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>

  <!-- Monitor (system) -->
  <svg class="theme-icon theme-icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
    <rect width="20" height="14" x="2" y="3" rx="2"/>
    <line x1="8" x2="16" y1="21" y2="21"/>
    <line x1="12" x2="12" y1="17" y2="21"/>
  </svg>

  <!-- Indicator badge for active mode (1.5px dot bottom-right) -->
  <span class="theme-indicator absolute bottom-1 right-1 w-1.5 h-1.5 rounded-full bg-brand pointer-events-none" aria-hidden="true"></span>
</button>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'theme';
    const html = document.documentElement;
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const icons = {
      light: btn.querySelector('.theme-icon-light'),
      dark: btn.querySelector('.theme-icon-dark'),
      system: btn.querySelector('.theme-icon-system'),
    };

    function showIcon(mode) {
      Object.entries(icons).forEach(([key, el]) => {
        if (el) el.style.display = key === mode ? '' : 'none';
      });
    }

    function applyTheme(mode) {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = mode === 'dark' || (mode === 'system' && prefersDark);
      html.classList.toggle('dark', isDark);
      html.dataset.theme = mode;
      showIcon(mode);
    }

    function getCurrent() {
      try { return localStorage.getItem(STORAGE_KEY) || 'system'; } catch (e) { return 'system'; }
    }

    function setMode(mode) {
      try { localStorage.setItem(STORAGE_KEY, mode); } catch (e) {}
      applyTheme(mode);
    }

    // Init na podstawie storage (anti-flicker script juz mial wlasny `.dark` set)
    applyTheme(getCurrent());

    // Cycle: light -> dark -> system -> light
    const cycle = { light: 'dark', dark: 'system', system: 'light' };
    btn.addEventListener('click', () => {
      const current = getCurrent();
      setMode(cycle[current] || 'light');
    });

    // Reaguj na zmianę OS-level preference TYLKO gdy user wybrał system mode
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const handleMq = () => {
      if (getCurrent() === 'system') applyTheme('system');
    };
    if (mq.addEventListener) mq.addEventListener('change', handleMq);
    else if (mq.addListener) mq.addListener(handleMq);
  })();
</script>
