---
interface Props {
  color?: 'dark' | 'white';
  size?: 'sm' | 'md' | 'lg';
}
const { color = 'dark', size = 'md' } = Astro.props;

const iconSizes = { sm: 24, md: 28, lg: 34 };
const iconH = iconSizes[size];

const icons: Record<string, string> = {
  dark: '/logo/ios-icon-iOS-Default.png',
  white: '/logo/ios-icon-iOS-ClearDark.png',
};

const src = icons[color];
---

<a href="/" class="inline-flex items-center gap-2 shrink-0" aria-label="BusiKM — strona główna">
  <img
    src={src}
    alt=""
    height={iconH}
    width={iconH}
    style={`height:${iconH}px;width:${iconH}px;border-radius:22%;`}
    loading="eager"
  />
  <span class:list={[
    'font-display text-xl font-bold tracking-[-0.01em]',
    color === 'white' ? 'text-white' : 'text-[#005CE8]',
  ]}>
    BusiKM
  </span>
</a>

<style>
  a { text-decoration: none; }
</style>
