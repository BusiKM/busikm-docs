---
interface Props {
  active: 'home' | 'route' | 'receipts' | 'account';
}
const { active } = Astro.props;

const tabs = [
  { id: 'home', label: 'Start' },
  { id: 'route', label: 'Trasa' },
  { id: 'receipts', label: 'Paragony' },
  { id: 'account', label: 'Konto' },
] as const;
---

<nav class="nav-driver">
  <div class="nav-grid">
    {tabs.map((tab) => {
      const isActive = tab.id === active;
      return (
        <div class={`tab ${isActive ? 'is-active' : ''}`}>
          <div class="tab-icon">
            {tab.id === 'home' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            )}
            {tab.id === 'route' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
            )}
            {tab.id === 'receipts' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="M19 7h-3.586l-2-2H10.586l-2 2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="13" r="4"/></svg>
            )}
            {tab.id === 'account' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            )}
          </div>
          <span class="tab-label">{tab.label}</span>
        </div>
      );
    })}
  </div>
</nav>

<style>
  .nav-driver {
    border-top: 1px solid #e5e7eb;
    padding: 8px 4px 14px;
  }
  .nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 6px 4px;
    border-radius: 12px;
    color: #6b7280;
  }
  .tab.is-active {
    color: #2563eb;
    background: #eff6ff;
  }
  .tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tab-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .tab.is-active .tab-label {
    font-weight: 600;
  }
</style>
