---
// Pixel replica of busikm-mobile-prototype/src/app/components/DriverHome.tsx (idle state).
// Static — Tailwind defaults from the prototype, not site brand tokens.
---
<div class="dh-screen">
  <div class="dh-pad">
    {/* Hero card — Gotowy do jazdy */}
    <div class="dh-hero">
      <div class="dh-hero-inner">
        <div class="dh-hero-row">
          <div>
            <p class="dh-eyebrow">Status trasy</p>
            <h2 class="dh-h1">Gotowy do jazdy</h2>
          </div>
          <div class="dh-play-orb">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><polygon points="6 3 20 12 6 21 6 3"/></svg>
          </div>
        </div>
        <button type="button" class="dh-cta-primary">Rozpocznij nową trasę</button>
      </div>
    </div>

    {/* Czas pracy — amber */}
    <div class="dh-amber">
      <svg class="dh-amber-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div class="dh-amber-body">
        <p class="dh-amber-label">Czas pracy dzisiaj</p>
        <p class="dh-amber-big">6h 23min</p>
        <p class="dh-amber-sub">Pozostało 1h 37min do limitu</p>
      </div>
    </div>

    {/* Szybkie akcje */}
    <div class="dh-actions">
      <h3 class="dh-section-title">Szybkie akcje</h3>
      <div class="dh-action-grid">
        <div class="dh-action-card">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7h-3.586l-2-2H10.586l-2 2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><circle cx="12" cy="13" r="4"/></svg>
          <span>Zeskanuj paragon</span>
        </div>
        <div class="dh-action-card">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Historia tras</span>
        </div>
      </div>
    </div>

    {/* Ostatnia trasa preview */}
    <div class="dh-recent">
      <div class="dh-recent-head">
        <h3 class="dh-section-title">Ostatnia trasa</h3>
        <span class="dh-recent-link">Wszystkie</span>
      </div>
      <div class="dh-recent-card">
        <div class="dh-recent-info">
          <p class="dh-recent-route">Warszawa → Berlin</p>
          <p class="dh-recent-meta">13 maja · 8h 15min</p>
        </div>
        <span class="dh-recent-km">187 km</span>
      </div>
    </div>
  </div>
</div>

<style>
  .dh-screen {
    background: #F5F5F7;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-sans);
    color: #111827;
  }
  .dh-pad {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 14px 16px 16px;
  }
  .dh-hero {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    overflow: hidden;
  }
  .dh-hero-inner {
    background: linear-gradient(135deg, #eff6ff 0%, #e0e7ff 100%);
    padding: 16px;
  }
  .dh-hero-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .dh-eyebrow {
    font-size: 10.5px;
    color: #4b5563;
    margin-bottom: 2px;
  }
  .dh-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: #111827;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .dh-play-orb {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #3b82f6;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 14px rgba(59,130,246,0.35);
  }
  .dh-cta-primary {
    width: 100%;
    background: #2563eb;
    color: white;
    border: 0;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.005em;
    font-family: inherit;
    cursor: default;
  }
  .dh-amber {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .dh-amber-icon {
    color: #d97706;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .dh-amber-label {
    font-size: 11.5px;
    font-weight: 500;
    color: #78350f;
  }
  .dh-amber-big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: #78350f;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .dh-amber-sub {
    font-size: 10.5px;
    color: #92400e;
    margin-top: 2px;
  }
  .dh-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dh-section-title {
    font-size: 11.5px;
    font-weight: 600;
    color: #374151;
  }
  .dh-action-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .dh-action-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 500;
    color: #111827;
    text-align: center;
  }
  .dh-recent {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .dh-recent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .dh-recent-link {
    font-size: 10.5px;
    font-weight: 500;
    color: #2563eb;
  }
  .dh-recent-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 11px 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .dh-recent-route {
    font-size: 12px;
    font-weight: 600;
    color: #111827;
  }
  .dh-recent-meta {
    font-size: 10.5px;
    color: #6b7280;
    margin-top: 1px;
  }
  .dh-recent-km {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: #2563eb;
  }
</style>
