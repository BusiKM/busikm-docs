---
// Pixel replica of busikm-mobile-prototype/src/app/components/OwnerStats.tsx.
// Recharts bar/line replaced by static SVG (we don't ship Recharts to the landing).
const weeklyData = [
  { day: 'Pon', km: 1240, cost: 850 },
  { day: 'Wt', km: 1580, cost: 920 },
  { day: 'Śr', km: 1320, cost: 780 },
  { day: 'Czw', km: 1690, cost: 1050 },
  { day: 'Pt', km: 1450, cost: 890 },
  { day: 'Sob', km: 890, cost: 520 },
  { day: 'Ndz', km: 450, cost: 280 },
];

const maxKm = Math.max(...weeklyData.map((d) => d.km));
const maxCost = Math.max(...weeklyData.map((d) => d.cost));

// Bar chart geometry — 7 bars, viewBox 240x110
const barWidth = 22;
const barGap = 12;
const barAreaH = 80;
const baseY = 90;

// Line chart geometry — same viewBox
const linePoints = weeklyData.map((d, i) => {
  const x = 14 + i * (barWidth + barGap) + barWidth / 2;
  const y = baseY - (d.cost / maxCost) * barAreaH;
  return `${x},${y.toFixed(1)}`;
}).join(' ');
---
<div class="os-screen">
  <div class="os-pad">
    {/* Header */}
    <div>
      <h2 class="os-h1">Statystyki</h2>
      <p class="os-sub">Podsumowanie ostatnich 7 dni</p>
    </div>

    {/* Key metrics */}
    <div class="os-metrics">
      <div class="os-metric os-metric-green">
        <div class="os-metric-row">
          <div class="os-metric-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Przychód tydzień</span>
          </div>
          <span class="os-trend os-trend-up">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            +12%
          </span>
        </div>
        <p class="os-metric-val">14 520 zł</p>
      </div>
      <div class="os-metric os-metric-amber">
        <div class="os-metric-row">
          <div class="os-metric-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="15" y2="22"/><line x1="4" y1="9" x2="14" y2="9"/><path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18"/><path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2v0a2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5"/></svg>
            <span>Koszty tydzień</span>
          </div>
          <span class="os-trend os-trend-up">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            +8%
          </span>
        </div>
        <p class="os-metric-val">5 290 zł</p>
      </div>
    </div>

    {/* Bar chart card */}
    <div class="os-card">
      <h3 class="os-card-title">Przebieg tygodniowy</h3>
      <svg viewBox="0 0 240 110" class="os-chart" preserveAspectRatio="xMidYMid meet">
        <g stroke="#f0f0f0" stroke-width="1" stroke-dasharray="3 3">
          <line x1="0" y1="10" x2="240" y2="10"/>
          <line x1="0" y1="30" x2="240" y2="30"/>
          <line x1="0" y1="50" x2="240" y2="50"/>
          <line x1="0" y1="70" x2="240" y2="70"/>
          <line x1="0" y1="90" x2="240" y2="90"/>
        </g>
        {weeklyData.map((d, i) => {
          const x = 14 + i * (barWidth + barGap);
          const h = (d.km / maxKm) * barAreaH;
          const y = baseY - h;
          return (
            <g>
              <rect x={x} y={y} width={barWidth} height={h} rx="4" ry="4" fill="#3b82f6"/>
              <text x={x + barWidth / 2} y="103" font-size="8" text-anchor="middle" fill="#9ca3af">{d.day}</text>
            </g>
          );
        })}
      </svg>
    </div>

    {/* Summary gradient card */}
    <div class="os-summary">
      <div class="os-summary-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Podsumowanie miesiąca</span>
      </div>
      <div class="os-summary-grid">
        <div>
          <p class="os-summary-val">34</p>
          <p class="os-summary-lbl">zleceń zrealizowanych</p>
        </div>
        <div>
          <p class="os-summary-val">92%</p>
          <p class="os-summary-lbl">rentowność</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .os-screen {
    background: #F5F5F7;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-sans);
    color: #111827;
  }
  .os-pad {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 14px 10px;
  }
  .os-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    color: #111827;
    letter-spacing: -0.012em;
    line-height: 1.1;
    margin-bottom: 2px;
  }
  .os-sub {
    font-size: 11px;
    color: #6b7280;
  }
  .os-metrics {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .os-metric {
    border-radius: 12px;
    padding: 9px 11px;
  }
  .os-metric-green { background: #ecfdf5; color: #047857; }
  .os-metric-amber { background: #fffbeb; color: #b45309; }
  .os-metric-blue { background: #eff6ff; color: #2563eb; }
  .os-metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .os-metric-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    color: #4b5563;
  }
  .os-trend {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 9.5px;
    font-weight: 600;
  }
  .os-trend-up { color: #059669; }
  .os-metric-val {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: #111827;
    line-height: 1.05;
  }
  .os-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 10px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
  }
  .os-card-title {
    font-size: 11.5px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 6px;
  }
  .os-chart {
    width: 100%;
    height: 86px;
    display: block;
  }
  .os-summary {
    background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%);
    border-radius: 12px;
    padding: 12px 14px;
    color: white;
    box-shadow: 0 8px 18px rgba(79,70,229,0.28);
  }
  .os-summary-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
  }
  .os-summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .os-summary-val {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.05;
  }
  .os-summary-lbl {
    font-size: 10px;
    color: rgba(255,255,255,0.85);
    margin-top: 2px;
  }
</style>
