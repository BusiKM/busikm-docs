---
interface Props {
  label?: string;
  statusTime?: string;
  /**
   * Container width in px. Default 280. Height locked at width * 19/9.
   */
  width?: number;
}

const { label, statusTime = '9:41', width = 280 } = Astro.props;
const sizeStyle = `--phone-w:${width}px;`;
---

<figure class="phone-frame" style={sizeStyle} aria-label={label ?? 'BusiKM mobile app preview'}>
  <div class="phone-body">
    <div class="phone-screen">
      {/* Dynamic island */}
      <div class="dyn-island" aria-hidden="true"></div>

      {/* Status bar */}
      <div class="status-bar">
        <span class="status-time">{statusTime}</span>
        <span class="status-icons" aria-hidden="true">
          {/* Signal */}
          <svg width="16" height="10" viewBox="0 0 16 10" fill="currentColor"><rect x="0" y="6" width="2.5" height="4" rx="0.5"/><rect x="4" y="4" width="2.5" height="6" rx="0.5"/><rect x="8" y="2" width="2.5" height="8" rx="0.5"/><rect x="12" y="0" width="2.5" height="10" rx="0.5"/></svg>
          {/* Wifi */}
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M1 3.5C2.7 1.8 4.7 1 7 1s4.3.8 6 2.5"/><path d="M3 5.5C4.1 4.4 5.5 4 7 4s2.9.4 4 1.5"/><path d="M5 7.5C5.6 7 6.3 6.8 7 6.8s1.4.2 2 .7"/><circle cx="7" cy="9" r="0.8" fill="currentColor"/></svg>
          {/* Battery */}
          <svg width="24" height="11" viewBox="0 0 24 11" fill="none"><rect x="0.5" y="0.5" width="21" height="10" rx="2.5" stroke="currentColor" stroke-opacity="0.55"/><rect x="2" y="2" width="16" height="7" rx="1.2" fill="currentColor"/><rect x="22.5" y="3.5" width="1.2" height="4" rx="0.5" fill="currentColor" fill-opacity="0.55"/></svg>
        </span>
      </div>

      {/* Content slot */}
      <div class="phone-content">
        <slot />
      </div>

      {/* Bottom navigation slot */}
      <div class="phone-nav">
        <slot name="nav" />
      </div>

      {/* Home indicator */}
      <div class="home-indicator" aria-hidden="true"></div>
    </div>
  </div>
</figure>

<style>
  .phone-frame {
    margin: 0;
    width: var(--phone-w);
    height: calc(var(--phone-w) * 19 / 9);
    flex-shrink: 0;
  }
  .phone-body {
    width: 100%;
    height: 100%;
    border-radius: 44px;
    padding: 8px;
    background: linear-gradient(180deg, #1f1f24 0%, #0a0a0b 60%, #1a1a1f 100%);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.35),
      0 12px 30px -12px rgba(0, 0, 0, 0.25),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.07);
    position: relative;
  }
  .phone-body::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(140deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 30%) padding-box,
      linear-gradient(320deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0) 30%) padding-box;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 36px;
    background: #F5F5F7;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .dyn-island {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 33%;
    max-width: 96px;
    height: 22px;
    background: #0a0a0b;
    border-radius: 999px;
    z-index: 10;
  }
  .status-bar {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 22px 6px;
    color: #0a0a0b;
    font-family: var(--font-sans);
  }
  .status-time {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: -0.01em;
  }
  .status-icons {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .phone-content {
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    position: relative;
    background: #F5F5F7;
  }
  .phone-nav {
    flex-shrink: 0;
    background: #fff;
  }
  .home-indicator {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 35%;
    max-width: 110px;
    height: 4px;
    background: #0a0a0b;
    border-radius: 999px;
    z-index: 10;
  }

  /* Compact mode for stacked layouts on mobile screens */
  @media (max-width: 640px) {
    .phone-frame {
      --phone-w: 240px;
    }
  }
</style>
