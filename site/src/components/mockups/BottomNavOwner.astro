---
interface Props {
  active: 'home' | 'fleet' | 'stats' | 'account';
}
const { active } = Astro.props;

const tabs = [
  { id: 'home', label: 'Start' },
  { id: 'fleet', label: 'Flota' },
  { id: 'stats', label: 'Statystyki' },
  { id: 'account', label: 'Konto' },
] as const;
---

<nav class="nav-owner">
  <div class="nav-grid">
    {tabs.map((tab) => {
      const isActive = tab.id === active;
      return (
        <div class={`tab ${isActive ? 'is-active' : ''}`}>
          <div class="tab-icon">
            {tab.id === 'home' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            )}
            {tab.id === 'fleet' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            )}
            {tab.id === 'stats' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            )}
            {tab.id === 'account' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style={isActive ? 'stroke-width:2.4' : 'stroke-width:2'}><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            )}
          </div>
          <span class="tab-label">{tab.label}</span>
        </div>
      );
    })}
  </div>
</nav>

<style>
  .nav-owner {
    border-top: 1px solid #e5e7eb;
    padding: 8px 4px 14px;
  }
  .nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 6px 2px;
    border-radius: 12px;
    color: #6b7280;
  }
  .tab.is-active {
    color: #2563eb;
    background: #eff6ff;
  }
  .tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tab-label {
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .tab.is-active .tab-label {
    font-weight: 600;
  }
</style>
