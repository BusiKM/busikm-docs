---
import { t, detectLocale, getHreflangAlternates } from '../i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const siteUrl = 'https://busikm.pl';
const locale = Astro.currentLocale ?? detectLocale(Astro.url.pathname);
const tr = t(locale);

const {
  title,
  description = tr.meta.siteDescription,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const fullTitle = title.includes('BusiKM') ? title : `${title} | BusiKM`;
const htmlLang = locale === 'en' ? 'en' : 'pl';
const ogLocale = locale === 'en' ? 'en_US' : 'pl_PL';
const ogLocaleAlternate = locale === 'en' ? 'pl_PL' : 'en_US';
const inLanguage = locale === 'en' ? 'en-US' : 'pl-PL';
const hreflangs = getHreflangAlternates(Astro.url.pathname, siteUrl);

const ldDescription = locale === 'en'
  ? 'Poland\'s first e-TMS (Transport Management System) designed specifically for international transport with vans 2.5–3.5 t. Real-time fleet tracking, AETR working time compliance, G2V2 tachograph monitoring, foreign per-diem calculations, KSeF e-invoicing integration, multi-tenant data isolation for accounting firms. R&D programme funded by EU grants (2027–2028).'
  : 'Pierwszy w Polsce e-TMS (Transport Management System) zaprojektowany pod transport międzynarodowy busami 2,5–3,5 t. Mapa floty w czasie rzeczywistym, zgodność czasu pracy AETR, monitoring tachografu G2V2, diety zagraniczne kierowców, integracja KSeF, multi-tenant dla biur rachunkowych. Prace badawczo-rozwojowe finansowane ze środków UE (2027–2028).';

const featureList = locale === 'en' ? [
  'Background GPS for driver mobile app',
  'AETR working time alerts (4.5h / 9h / 11h / day / week / two weeks)',
  'EU Mobility Package — 45h breaks, weekly returns',
  'G2V2 tachograph — calibration monitoring and working-time records',
  'Receipt OCR in 6 languages (PL/EN/DE/IT/FR/ES) — 7 document types',
  'NBP exchange rates — automatic conversion of foreign costs',
  'Cost invoice export to Insert GT, Comarch ERP Optima, Symfonia FK',
  'Real-time fleet map',
  'Offline mode in driver app',
  'Driver documents (license, code 95, ADR) and company documents (transport license, OCP)',
  'Multi-tenant panel for accounting firms serving transport companies',
  'Document expiry alerts 90/30/14/7 days',
] : [
  'GPS w tle dla aplikacji mobilnej kierowcy',
  'Alerty czasu pracy AETR (4,5h / 9h / 11h / dzień / tydzień / dwa tygodnie)',
  'Pakiet mobilności UE — przerwy 45h, powroty cotygodniowe',
  'Tachograf G2V2 — monitoring legalizacji i ewidencja czasu pracy',
  'OCR paragonów w 6 językach (PL/EN/DE/IT/FR/ES) — 7 typów dokumentów',
  'Kursy NBP — automatyczne przewalutowanie kosztów zagranicznych',
  'Eksport faktur kosztowych do Insert GT, Comarch ERP Optima, Symfonia FK',
  'Mapa floty w czasie rzeczywistym',
  'Tryb offline w aplikacji kierowcy',
  'Dokumenty kierowcy (prawo jazdy, kod 95, ADR) i firmy (licencja transportowa, OCP)',
  'Panel multi-tenant dla biur rachunkowych obsługujących firmy transportowe',
  'Alerty terminów dokumentów 90/30/14/7 dni',
];

const offerName = locale === 'en'
  ? 'Pilot program — lifetime free'
  : 'Program pilotażowy — dożywotnio gratis';
const offerDescription = locale === 'en'
  ? 'BusiKM is in pilot program phase. First transport companies and accounting firms join lifetime-free in exchange for feedback. Commercial pricing will be announced after pilot ends.'
  : 'BusiKM jest w fazie programu pilotażowego. Pierwsze firmy i biura rachunkowe biorą udział dożywotnio gratis w zamian za feedback. Cennik komercyjny zostanie ogłoszony po zakończeniu pilotażu.';

const websiteDescription = locale === 'en'
  ? 'e-TMS (Transport Management System) for vans 2.5–3.5 t and accounting integration'
  : 'e-TMS (Transport Management System) dla busów 2,5–3,5 t i integracji z księgowością';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Core -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Hreflang alternates — BKM-552 -->
    {hreflangs.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="BusiKM" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Additional SEO -->
    <meta name="author" content="BusiKM" />
    <meta name="theme-color" content="#005CE8" />
    <meta name="application-name" content="BusiKM" />
    <meta name="apple-mobile-web-app-title" content="BusiKM" />
    <meta name="format-detection" content="telephone=no" />

    <!-- AI / LLM / Search Bot hints -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />

    <!-- Structured Data: SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "BusiKM",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "description": ldDescription,
      "url": siteUrl,
      "image": ogImageUrl,
      "inLanguage": inLanguage,
      "author": {
        "@type": "Organization",
        "name": "BusiKM",
        "url": siteUrl
      },
      "offers": {
        "@type": "Offer",
        "name": offerName,
        "price": "0",
        "priceCurrency": "PLN",
        "description": offerDescription,
        "availability": "https://schema.org/LimitedAvailability"
      },
      "featureList": featureList,
    })} />

    <!-- Structured Data: WebSite (for sitelinks search) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "BusiKM",
      "url": siteUrl,
      "description": websiteDescription,
      "inLanguage": inLanguage,
    })} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VJNNR0NFPX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VJNNR0NFPX');
    </script>

    <!-- Google Tag Manager placeholder -->
    <!-- Odkomentuj i wstaw swój Container ID (GTM-XXXXXXX) -->
    <!--
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-XXXXXXX');</script>
    -->

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Anti-flicker theme init (BKM-547): apply `.dark` class na html PRZED first paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || 'system';
          var isDark = theme === 'dark' || (theme === 'system' && prefersDark);
          if (isDark) document.documentElement.classList.add('dark');
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface text-text">
    <slot />
  </body>
</html>
