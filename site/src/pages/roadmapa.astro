---
import MarketingLayout from '../layouts/MarketingLayout.astro';

// === Roadmapa BusiKM — 7-fazowy timeline europejskiego deep-tech ===
// Faza 1-2: DONE (architektura, web app). Faza 3: in-progress (mobile). Faza 4: upcoming (MVP launch).
// Faza 5: post-MVP H2 2026. Faza 6: 2027 R&D FENG SMART. Faza 7: 2028 EIC + Horizon.
// Synchronizowane z Jirą komendą UPDATE ROADMAP. Last sync: 8 maja 2026.

const phases = [
  // ============================ FAZA 1 — ARCHITEKTURA (DONE) ============================
  {
    num: 1,
    id: 'architektura',
    label: 'Architektura',
    period: '14 kwietnia — 5 maja 2026',
    color: '#34C759',
    status: 'done',
    summary: 'Fundament backendu: CI/CD, autoryzacja, multi-tenant z izolacją RODO, ewidencja zleceń i tras, eksport do trzech systemów księgowych, model rozliczeń per pojazd, real-time mapa floty.',
    sprints: [
      { id: 'S0',  range: '14–18 kwietnia', title: 'Środowisko produkcyjne i CI/CD', desc: 'Środowisko produkcyjne, automatyzacja wdrożeń, monitoring infrastruktury i błędów aplikacji, dokumentacja architektury wewnętrznej.', tickets: 13 },
      { id: 'S1',  range: '19–20 kwietnia', title: 'Autoryzacja i system ról', desc: 'Bezpieczne logowanie z automatycznym odświeżaniem sesji, weryfikacja e-mail, cztery role: kierowca, właściciel, księgowy, biuro rachunkowe.', tickets: 10 },
      { id: 'S2',  range: '21 kwietnia',    title: 'Firmy, subskrypcje, izolacja danych', desc: 'Profil firmy, subskrypcja, multi-tenant z izolacją RODO między firmami oraz przełączanie kontekstu dla biur rachunkowych obsługujących wielu klientów.', tickets: 16 },
      { id: 'S3',  range: '22–23 kwietnia', title: 'Pojazdy, kierowcy, dokumenty', desc: 'Pełne zarządzanie flotą i kierowcami, upload dokumentów (OC, przegląd, tachograf, prawo jazdy), monitoring terminów ważności.', tickets: 14 },
      { id: 'S4',  range: '23–30 kwietnia', title: 'Ewidencja zleceń, eksport FK, dokumenty', desc: 'Pełna ewidencja zleceń i tras pojazdów, dziennik audytowy, eksport faktur kosztowych i raportów do Insert GT, Comarch ERP Optima oraz Symfonia FK. Kursy walut NBP automatycznie.', tickets: 35 },
      { id: 'S5a', range: '2 maja',         title: 'Model rozliczeń per aktywny pojazd', desc: 'Hurtowe rozliczanie aktywnych pojazdów floty w jednym cyklu, automatyczne miesięczne podsumowanie dla firm z wieloma oddziałami i biur rachunkowych.', tickets: 14 },
      { id: 'S5b', range: '2 maja',         title: 'Plan indywidualny dla większych flot', desc: 'Indywidualne warunki cenowe per pojazd, panel administracyjny do zarządzania umowami i walidacje rozdzielające plan indywidualny od standardowego pilotażu.', tickets: 7 },
      { id: 'S6a', range: '3–4 maja',       title: 'System rejestracji pilotów', desc: 'Panel administracyjny generowania jednorazowych linków, automatyczne maile powitalne, zabezpieczenia przeciw nadużyciom, testy cyklu rejestracji nowego pilota.', tickets: 8 },
      { id: 'S6b', range: '4 maja',         title: 'Dashboard zgodności dokumentów', desc: 'Zagregowany status dokumentów floty — OC, przegląd, tachograf G2V2, licencja transportowa, prawo jazdy — na poziomie firmy lub portfela biura rachunkowego.', tickets: 3 },
      { id: 'S7a', range: '4 maja',         title: 'Powiadomienia w aplikacji (backend)', desc: 'Trzy kanały komunikacji w aplikacji: alerty wygasających dokumentów, potwierdzenia tras dla właściciela, komunikaty produktowe. Preferencje per kanał per użytkownik.', tickets: 10 },
      { id: 'S7b', range: '5 maja',         title: 'Automatyzacja cyklu próbnego', desc: 'Sekwencja przypomnień przed wygaśnięciem trialu, automatyczne przedłużenie dla kont, które jeszcze nie zarejestrowały żadnej trasy.', tickets: 6 },
      { id: 'S8',  range: '5 maja',         title: 'Mapa floty w czasie rzeczywistym', desc: 'Pozycje pojazdów aktualizowane na żywo bez konieczności odświeżania strony. Mapa Europy z busami w trasie, ETA dla zlecenia, fundament pod geofencing.', tickets: 12 },
      { id: 'S9',  range: '5 maja',         title: 'Domknięcie zakresu backendowego', desc: 'Walidacje danych firmowych przy tworzeniu klienta, bezpieczne odzyskiwanie usuniętych obiektów, rozszerzony monitoring stanu systemu.', tickets: 9 },
    ],
  },

  // ============================ FAZA 2 — WEB APP (DONE) ============================
  {
    num: 2,
    id: 'web-app',
    label: 'Web App',
    period: '6–7 maja 2026',
    color: '#34C759',
    status: 'done',
    summary: 'Panel webowy dla właściciela firmy i biura rachunkowego — multi-tenant context switching, dashboard floty, raporty, eksport FK jednym kliknięciem, mapa floty w czasie rzeczywistym, onboarding pilota.',
    sprints: [
      { id: 'S10a', range: '6 maja', title: 'Fundament panelu webowego', desc: 'Bezpieczna autoryzacja, spójny system designu, pełna responsywność — działa na komputerze, laptopie i tablecie.', tickets: 6 },
      { id: 'S10b', range: '6 maja', title: 'Główne widoki dla właściciela firmy', desc: 'Dashboard floty ze statystykami, listy pojazdów, kierowców, tras i faktur kosztowych, szczegóły każdego obiektu z dokumentami i historią.', tickets: 7 },
      { id: 'S11a', range: '6 maja', title: 'Panel biura rachunkowego', desc: 'Multi-tenantowe przełączanie kontekstu między klientami, zbiorczy dashboard wszystkich obsługiwanych firm, zarządzanie zaproszeniami. Każde przełączenie w dzienniku audytowym.', tickets: 5 },
      { id: 'S11b', range: '6 maja', title: 'Raporty i eksport do systemów księgowych', desc: 'Interfejs generowania raportów kosztów floty oraz eksport faktur, paragonów i delegacji do Insert GT, Comarch ERP Optima i Symfonia FK jednym kliknięciem.', tickets: 6 },
      { id: 'S12a', range: '7 maja', title: 'Mapa floty w panelu webowym', desc: 'Wizualizacja pozycji pojazdów na żywo na mapie Europy w panelu webowym, komunikaty informacyjne o stanie programu pilotażowego.', tickets: 5 },
      { id: 'S12b', range: '7 maja', title: 'Onboarding pilota', desc: 'Bezpieczna ścieżka rejestracji nowego pilota z linku zaproszenia, ekrany powitalne dopasowane do roli (właściciel firmy / biuro rachunkowe).', tickets: 1 },
      { id: 'S12c', range: '7 maja', title: 'Konfiguracja konta i zespołu', desc: 'Ustawienia firmy, profil użytkownika, zaproszenia członków zespołu z odpowiednimi uprawnieniami.', tickets: 4 },
      { id: 'S13a', range: '7 maja', title: 'Publiczna strona busikm.pl', desc: 'Pełna treść marketingowa, integracja z systemem zgłoszeń do pilotażu, optymalizacja pod wyszukiwarki, sekcja FENG / Ścieżka SMART z opisem komponentów R&D.', tickets: 6 },
      { id: 'S13b', range: '7 maja', title: 'Testy automatyczne panelu', desc: 'Pokrycie testami kluczowych ścieżek użytkownika z regresją uruchamianą przy każdej zmianie.', tickets: 2 },
    ],
  },

  // ============================ FAZA 3 — MOBILE APP (in-progress) ============================
  {
    num: 3,
    id: 'mobile-app',
    label: 'Mobile App',
    period: '7—12 maja 2026',
    color: '#FF9500',
    status: 'in-progress',
    summary: 'Aplikacja iOS/Android dla kierowcy i właściciela: śledzenie GPS w tle, start/stop trasy jednym przyciskiem, OCR paragonów w sześciu językach, alerty AETR, push notifications, pełny tryb offline.',
    sprints: [
      { id: 'S14a', range: '7 maja',   title: 'Fundament aplikacji mobilnej', desc: 'Architektura aplikacji iOS/Android, struktura nawigacji dostosowana do roli użytkownika (kierowca / właściciel).', tickets: 4, done: true },
      { id: 'S14b', range: '7 maja',   title: 'Logowanie i pierwsze kroki', desc: 'Bezpieczna autoryzacja kierowcy na urządzeniu, przewodnik dla nowego kierowcy, zarządzanie sesją z automatycznym odnawianiem tokenu.', tickets: 3, done: true },
      { id: 'S15',  range: '8 maja',   title: 'Pełen flow pracy kierowcy', desc: 'Śledzenie GPS w tle, start/stop trasy jednym przyciskiem, zdjęcia drogomierza, OCR paragonów w sześciu językach, alerty AETR, zatwierdzanie tras.', tickets: 8, done: true },
      { id: 'S16a', range: '8 maja',   title: 'Widok właściciela na telefonie', desc: 'Dashboard floty na telefonie, alerty dokumentów na żywo, przegląd tras zespołu, szybkie akcje zarządcze (zatwierdzanie zlecenia, kontakt z kierowcą).', tickets: 4, done: true },
      { id: 'S16b', range: '9 maja',   title: 'Powiadomienia push w aplikacji', desc: 'Trzy kanały (alerty dokumentów, potwierdzenia tras, komunikaty produktowe), ustawienia preferencji per kanał.', tickets: 5 },
      { id: 'S16c', range: '10 maja',  title: 'Pełny tryb offline', desc: 'Aplikacja działa bez internetu — trasy nagrywane lokalnie, automatyczna synchronizacja po odzyskaniu połączenia, bez ryzyka utraty danych.', tickets: 4 },
      { id: 'S17a', range: '11 maja',  title: 'Wydanie do App Store i Google Play', desc: 'Aplikacja gotowa do publicznej dystrybucji w sklepach Apple i Google, automatyczne aktualizacje dla użytkowników.', tickets: 4 },
      { id: 'S17b', range: '12 maja',  title: 'Testy aplikacji mobilnej', desc: 'Pokrycie testami jednostkowymi i scenariuszowymi przed pierwszym wydaniem.', tickets: 2 },
    ],
  },

  // ============================ FAZA 4 — LAUNCH I ROZSZERZENIA ============================
  {
    num: 4,
    id: 'launch',
    label: 'Launch i rozszerzenia',
    period: '13—21 maja 2026',
    color: '#8B5CF6',
    status: 'upcoming',
    summary: 'MVP LIVE 30 maja 2026: audyt bezpieczeństwa, automatyczne fakturowanie samoobsługowe, diety zagraniczne + KSeF, zaawansowana analityka rentowności, finalizacja dokumentacji.',
    sprints: [
      { id: 'S18', range: '13—14 maja', title: 'MVP LIVE — wdrożenie produkcyjne', desc: 'Pełen audyt bezpieczeństwa, testy wydajnościowe, wdrożenie środowiska produkcyjnego, monitoring 24/7, dokumentacja operacyjna, UAT z pierwszymi pilotami.', tickets: 12, milestone: true },
      { id: 'S19', range: '15—16 maja', title: 'Automatyczne fakturowanie', desc: 'Samodzielna rejestracja firm bez biura rachunkowego, automatyczne faktury VAT, samoobsługowe zarządzanie subskrypcją.', tickets: 7 },
      { id: 'S20', range: '17—18 maja', title: 'Diety pracownicze i KSeF', desc: 'Eksport diet zagranicznych kierowców per kraj per dzień do Insert GT, Comarch ERP Optima i Symfonia FK. Integracja z Krajowym Systemem e-Faktur.', tickets: 5 },
      { id: 'S21', range: '19—20 maja', title: 'Zaawansowana analityka rentowności', desc: 'Raporty kosztów per zlecenie, per pojazd i per kierowca, porównania międzymiesięczne, wykrywanie trendów wykorzystania floty.', tickets: 4 },
      { id: 'S22', range: '21 maja',    title: 'Finalizacja dokumentacji produktu', desc: 'Spójność dokumentacji z wdrożonymi funkcjami, materiały dla nowych pilotów i biur rachunkowych.', tickets: 16 },
    ],
  },

  // ============================ FAZA 5 — H2 2026 POST-MVP ============================
  {
    num: 5,
    id: 'post-mvp-h2',
    label: 'Compliance + analityka + KSeF',
    period: 'Q3–Q4 2026 (post-MVP)',
    color: '#FF9500',
    status: 'future',
    summary: 'Druga połowa 2026: DriverActivity Engine (filar AETR compliance), G2V2 + ITD dashboard (deadline 1 lipca), marża per zlecenie, rozliczenia kierowcy, VAT-REF UE, mapa live + strefy alertów, alerty anomalii spalania, first R&D milestone (point-in-polygon TRL 5→6).',
    sprints: [
      { id: 'Q3.0', range: 'Q3 2026', title: 'DriverActivity Engine — Filar AETR compliance', desc: '8 typów aktywności (DRIVING, LOADING, BREAK, REST, ...) mapowanych na 4 symbole tachografu, auto-detection z GPS (Celery 1 min), AETRComplianceEngine zgodny z rozp. (WE) 561/2006 + Pakiet Mobilności, alerty 3-poziomowe (INFO/WARNING/VIOLATION) z FCM push, raporty PDF dla kontroli ITD/BAG. Bulk import z tachografu G2V2 (DDD). Pełna strona: /aetr.', tickets: '~15' },
      { id: 'Q3.1', range: 'Q3 2026', title: 'Tachograf G2V2 i kontrola ITD pod jednym dashboardem', desc: 'Monitoring legalizacji tachografów, ewidencja czasu pracy AETR, terminy uprawnień kierowców i licencji firmy. Uniknięcie kar do 10 000 zł per pojazd.', tickets: '~20' },
      { id: 'Q3.2', range: 'Q3 2026', title: 'Marża per zlecenie — realna rentowność', desc: 'Zlecenie powiązane z pojazdem, kierowcą, trasą GPS i wszystkimi kosztami: paliwo, Maut, opłaty drogowe, hotele PL i UE.', tickets: '~15' },
      { id: 'Q3.3', range: 'Q3 2026', title: 'Rozliczenie kierowcy — diety, mandaty, wypłata', desc: 'Diety zagraniczne według stawek z rozporządzenia, mandaty z winy kierowcy lub firmy, wydatki prywatne, przewalutowanie.', tickets: '~12' },
      { id: 'Q4.1', range: 'Q4 2026', title: 'VAT-REF z UE — odzyskaj VAT z paliwa, Mautu i promów', desc: 'Rejestracja faktur z DE, FR, IT, AT, automatyczne przeliczenie na PLN po kursie z dnia wystawienia, gotowy raport do wniosku o zwrot VAT.', tickets: '~14' },
      { id: 'Q4.2', range: 'Q4 2026', title: 'Mapa live + strefy alertów (geofencing)', desc: 'Pojazdy widoczne w czasie rzeczywistym z ETA, alert kiedy bus opuszcza strefę bez aktywnego zlecenia. Klient sam widzi kiedy dotrze towar.', tickets: '~10' },
      { id: 'Q4.3', range: 'Q4 2026', title: 'Alerty anomalii spalania (prototyp XAI)', desc: 'Automatyczne raporty rentowności per pojazd i kierowca z alertami o nadmiernym spalaniu, deficytowych trasach, podejrzanych tankowaniach. Detekcja granic UE TRL 5→6.', tickets: '~16' },
    ],
  },

  // ============================ FAZA 6 — 2027 FENG SMART ============================
  {
    num: 6,
    id: 'feng-smart-2027',
    label: 'R&D Phase 1 — FENG Ścieżka SMART',
    period: '2027 (4 kwartały)',
    color: '#005CE8',
    status: 'future',
    grant: { name: 'FENG · Ścieżka SMART', funder: 'NCBR Polska', trl: 'TRL 5→8', deadline: 'Q4 2026 / Q1 2027' },
    summary: 'Cztery kwartały deep-tech finansowane z FENG Ścieżka SMART (NCBR). Rozwój 3 z 5 komponentów R&D z koncepcji (TRL 1-2) do walidacji systemowej (TRL 6-7). Walidacja na rozszerzonym pilotażu — 50+ firm transportowych w UE.',
    sprints: [
      { id: 'Q1.27', range: 'Q1 2027 · TRL 1→5', title: 'Parser DDD — prototype validation',                desc: 'Autorska biblioteka Python odczytu pliku DDD z tachografu G2V2, zgodna z Rozp. (UE) 2016/799 Annex I. Walidacja na próbach z certyfikowanych tachografów + 56-dniowy raport dla ITD.', tickets: 'R&D' },
      { id: 'Q2.27', range: 'Q2 2027 · TRL 2→6', title: 'Silnik diet AETR — production validation',         desc: 'Deterministyczny rules engine mapujący Rozp. MPiPS Dz.U. 2013/167 na auto-rozliczenie kierowcy. Walidacja na realnych przypadkach + integracja Insert GT/Comarch/Symfonia.', tickets: 'R&D' },
      { id: 'Q3.27', range: 'Q3 2027 · TRL 6→7', title: 'Public API v1 + i18n DE/CZ/SK',                     desc: 'Publiczne API z webhookami, sandbox env i certyfikatami integratora. Pełna lokalizacja DE/CZ/SK — przygotowanie pod scale-out poza Polskę.', tickets: 'R&D' },
      { id: 'Q4.27', range: 'Q4 2027 · TRL 1→4', title: 'Multi-currency EUR + XAI training start',           desc: 'Multi-currency (EUR primary, PLN/CZK/DKK secondary) z auto-konwersją NBP/ECB. Start treningu modelu XAI anomalii spalania na danych z pilotażu.', tickets: 'R&D' },
    ],
  },

  // ============================ FAZA 7 — 2028 EIC + HORIZON ============================
  {
    num: 7,
    id: 'eic-horizon-2028',
    label: 'R&D Phase 2 — EIC Accelerator + Horizon Europe',
    period: '2028 (cały rok)',
    color: '#8B5CF6',
    status: 'future',
    grant: { name: 'EIC · Accelerator + Horizon · Cluster 5', funder: 'European Innovation Council + European Commission', trl: 'TRL 6→9', deadline: 'Q1 2028 (EIC Step 1) · Q2 2028 (Horizon call)' },
    summary: 'Dwie aplikacje grantowe: EIC Accelerator (blended finance — grant €2,5M + equity €15M) oraz Horizon Europe Cluster 5 (Climate, Energy & Mobility — work programme partnerstwo). Cel: market-ready (TRL 9), scale-out pan-EU (PL→CZ/SK→DE).',
    sprints: [
      { id: 'Q1.28', range: 'Q1–Q2 2028 · TRL 1→5',  title: 'Bluetooth ITS — hardware prototype',           desc: 'React Native library do zdalnej komunikacji z tachografem G2V2 przez Bluetooth ITS (Rozp. 2016/799). Pobranie DDD bez kabla do warsztatu. Walidacja na referencyjnym sprzęcie.', tickets: 'R&D' },
      { id: 'Q3.28', range: 'Q3 2028 · TRL 1→6',     title: 'XAI anomalia spalania — production',           desc: 'Model regresji wielowymiarowej + SHAP-based explainability (zgodne z EU AI Act). Detekcja kradzieży paliwa z naturalnojęzykowym wyjaśnieniem. Target: precision ≥80%, recall ≥70%.', tickets: 'R&D' },
      { id: 'Q3.28b', range: 'Q3 2028',              title: 'Scale-out PL→CZ/SK→DE',                        desc: 'Pełne wdrożenie pan-EU — Czechy i Słowacja (Q1), Niemcy (Q2). Lokalne FK integration (Pohoda, DATEV), lokalne VAT regime, e-invoicing per kraj (KSeF/Peppol/SDI/FacturaE).', tickets: 'R&D' },
      { id: 'Q4.28', range: 'Q4 2028 · Market Ready',title: 'Commercialization · TRL 9',                    desc: 'Pełna komercjalizacja w 4 krajach UE (PL, CZ, SK, DE). Konsorcjum: 1 uczelnia techniczna, 1 system FK europejski, 1 dostawca tachografów (VDO/Stoneridge). Target: 500+ klientów płacących.', tickets: 'R&D' },
    ],
  },
];

// === Statystyki agregowane ===
const closedSprintsCount = 26;
const closedTicketsCount = 218;
const upcomingSprintsCount = phases
  .flatMap((p) => p.sprints)
  .filter((s) => !s.done && typeof s.tickets === 'number').length;
const upcomingTicketsCount = phases
  .flatMap((p) => p.sprints)
  .filter((s) => !s.done && typeof s.tickets === 'number')
  .reduce((a, s) => a + (typeof s.tickets === 'number' ? s.tickets : 0), 0);

const numberWord = (n: number): string => {
  if (n === 1) return 'sprint';
  if (n < 5) return 'sprinty';
  return 'sprintów';
};
---

