---
import MarketingLayout from '../layouts/MarketingLayout.astro';

// === Roadmapa BusiKM — narracja kamieni milowych ===
// Pięć faz wdrożeniowych (architektura, panel webowy, mobile, launch, post-MVP) + dwa lata badań i rozwoju (2027, 2028).
// Wewnętrzny język techniczny zastąpiony narracją produktową — żadnych "sprintów" ani "ticketów" w UI.
// Synchronizowane z planem produktu komendą UPDATE ROADMAP.

const phases = [
  // ============================ FAZA 1 — ARCHITEKTURA (DONE) ============================
  {
    num: 1,
    id: 'architektura',
    label: 'Architektura platformy',
    period: '14 kwietnia — 5 maja 2026',
    color: '#34C759',
    status: 'done',
    summary: 'Fundament backendu: środowisko produkcyjne, autoryzacja, multi-tenant z izolacją RODO, ewidencja zleceń i tras, eksport do trzech systemów księgowych, model rozliczeń per pojazd, mapa floty w czasie rzeczywistym.',
    milestones: [
      { range: '14–18 kwietnia', title: 'Środowisko produkcyjne i CI/CD',                 desc: 'Środowisko produkcyjne, automatyzacja wdrożeń, monitoring infrastruktury i błędów aplikacji, dokumentacja architektury wewnętrznej.' },
      { range: '19–20 kwietnia', title: 'Autoryzacja i system ról',                       desc: 'Bezpieczne logowanie z automatycznym odświeżaniem sesji, weryfikacja e-mail, cztery role: kierowca, właściciel, księgowy, biuro rachunkowe.' },
      { range: '21 kwietnia',    title: 'Firmy, subskrypcje, izolacja danych',            desc: 'Profil firmy, subskrypcja, multi-tenant z izolacją RODO między firmami oraz przełączanie kontekstu dla biur rachunkowych obsługujących wielu klientów.' },
      { range: '22–23 kwietnia', title: 'Pojazdy, kierowcy, dokumenty',                   desc: 'Pełne zarządzanie flotą i kierowcami, upload dokumentów (OC, przegląd, tachograf, prawo jazdy), monitoring terminów ważności.' },
      { range: '23–30 kwietnia', title: 'Ewidencja zleceń, eksport FK, dokumenty',        desc: 'Pełna ewidencja zleceń i tras pojazdów, dziennik audytowy, eksport faktur kosztowych i raportów do Insert GT, Comarch ERP Optima oraz Symfonia FK. Kursy walut NBP automatycznie.' },
      { range: '2 maja',         title: 'Model rozliczeń per aktywny pojazd',             desc: 'Hurtowe rozliczanie aktywnych pojazdów floty w jednym cyklu, automatyczne miesięczne podsumowanie dla firm z wieloma oddziałami i biur rachunkowych.' },
      { range: '2 maja',         title: 'Plan indywidualny dla większych flot',           desc: 'Indywidualne warunki cenowe per pojazd, panel administracyjny do zarządzania umowami i walidacje rozdzielające plan indywidualny od standardowego pilotażu.' },
      { range: '3–4 maja',       title: 'System rejestracji pilotów',                     desc: 'Panel administracyjny generowania jednorazowych linków, automatyczne maile powitalne, zabezpieczenia przeciw nadużyciom, testy cyklu rejestracji nowego pilota.' },
      { range: '4 maja',         title: 'Dashboard zgodności dokumentów',                 desc: 'Zagregowany status dokumentów floty — OC, przegląd, tachograf G2V2, licencja transportowa, prawo jazdy — na poziomie firmy lub portfela biura rachunkowego.' },
      { range: '4 maja',         title: 'Powiadomienia w aplikacji (backend)',            desc: 'Trzy kanały komunikacji w aplikacji: alerty wygasających dokumentów, potwierdzenia tras dla właściciela, komunikaty produktowe. Preferencje per kanał per użytkownik.' },
      { range: '5 maja',         title: 'Automatyzacja cyklu próbnego',                   desc: 'Sekwencja przypomnień przed wygaśnięciem trialu, automatyczne przedłużenie dla kont, które jeszcze nie zarejestrowały żadnej trasy.' },
      { range: '5 maja',         title: 'Mapa floty w czasie rzeczywistym',               desc: 'Pozycje pojazdów aktualizowane na żywo bez konieczności odświeżania strony. Mapa Europy z busami w trasie, ETA dla zlecenia, fundament pod geofencing.' },
      { range: '5 maja',         title: 'Domknięcie zakresu backendowego',                desc: 'Walidacje danych firmowych przy tworzeniu klienta, bezpieczne odzyskiwanie usuniętych obiektów, rozszerzony monitoring stanu systemu.' },
    ],
  },

  // ============================ FAZA 2 — WEB APP (DONE) ============================
  {
    num: 2,
    id: 'web-app',
    label: 'Panel webowy',
    period: '6–7 maja 2026',
    color: '#34C759',
    status: 'done',
    summary: 'Panel webowy dla właściciela firmy i biura rachunkowego — przełączanie kontekstu między klientami, dashboard floty, raporty, eksport FK jednym kliknięciem, mapa floty w czasie rzeczywistym, onboarding pilota.',
    milestones: [
      { range: '6 maja', title: 'Fundament panelu webowego',               desc: 'Bezpieczna autoryzacja, spójny system designu, pełna responsywność — działa na komputerze, laptopie i tablecie.' },
      { range: '6 maja', title: 'Główne widoki dla właściciela firmy',     desc: 'Dashboard floty ze statystykami, listy pojazdów, kierowców, tras i faktur kosztowych, szczegóły każdego obiektu z dokumentami i historią.' },
      { range: '6 maja', title: 'Panel biura rachunkowego',                desc: 'Przełączanie kontekstu między klientami, zbiorczy dashboard wszystkich obsługiwanych firm, zarządzanie zaproszeniami. Każde przełączenie w dzienniku audytowym.' },
      { range: '6 maja', title: 'Raporty i eksport do systemów księgowych', desc: 'Interfejs generowania raportów kosztów floty oraz eksport faktur, paragonów i delegacji do Insert GT, Comarch ERP Optima i Symfonia FK jednym kliknięciem.' },
      { range: '7 maja', title: 'Mapa floty w panelu webowym',             desc: 'Wizualizacja pozycji pojazdów na żywo na mapie Europy w panelu webowym, komunikaty informacyjne o stanie programu pilotażowego.' },
      { range: '7 maja', title: 'Onboarding pilota',                       desc: 'Bezpieczna ścieżka rejestracji nowego pilota z linku zaproszenia, ekrany powitalne dopasowane do roli (właściciel firmy / biuro rachunkowe).' },
      { range: '7 maja', title: 'Konfiguracja konta i zespołu',            desc: 'Ustawienia firmy, profil użytkownika, zaproszenia członków zespołu z odpowiednimi uprawnieniami.' },
      { range: '7 maja', title: 'Publiczna strona busikm.pl',              desc: 'Pełna treść marketingowa, integracja z systemem zgłoszeń do pilotażu, optymalizacja pod wyszukiwarki.' },
      { range: '7 maja', title: 'Testy automatyczne panelu',               desc: 'Pokrycie testami kluczowych ścieżek użytkownika z regresją uruchamianą przy każdej zmianie.' },
    ],
  },

  // ============================ FAZA 3 — APLIKACJA MOBILNA (in-progress) ============================
  {
    num: 3,
    id: 'mobile-app',
    label: 'Aplikacja mobilna',
    period: '7—29 maja 2026',
    color: '#FF9500',
    status: 'in-progress',
    summary: 'Aplikacja iOS/Android dla wszystkich czterech ról — kierowcy, właściciela, księgowego i biura rachunkowego. Główny fokus na kierowcę: nawigacja, zlecenia, statusy, AETR, podpisywanie zleceń, OCR paragonów i dokumentów, odczyt licznika ODO.',
    milestones: [
      { range: '7 maja',  title: 'Fundament aplikacji mobilnej',         desc: 'Architektura aplikacji iOS/Android, struktura nawigacji dostosowana do roli użytkownika (kierowca / właściciel / księgowy / biuro rachunkowe).', done: true },
      { range: '7 maja',  title: 'Logowanie i pierwsze kroki',           desc: 'Bezpieczna autoryzacja na urządzeniu, przewodnik dla nowego użytkownika, zarządzanie sesją z automatycznym odnawianiem tokenu.', done: true },
      { range: '8 maja',  title: 'Pełen flow pracy kierowcy',            desc: 'Nawigacja, GPS w tle, start/stop trasy jednym przyciskiem, statusy zlecenia (załadunek, w drodze, rozładunek), alerty czasu pracy AETR, podpisywanie zleceń, OCR paragonów w sześciu językach, OCR dokumentów kosztowych, odczyt licznika ODO ze zdjęcia.', done: true },
      { range: '8 maja',  title: 'Widok właściciela na telefonie',       desc: 'Dashboard floty, mapa w czasie rzeczywistym, alerty dokumentów, przegląd tras zespołu, szybkie akcje zarządcze (zatwierdzanie zlecenia, kontakt z kierowcą).', done: true },
      { range: '9 maja',  title: 'Powiadomienia push w aplikacji',       desc: 'Trzy kanały (alerty dokumentów, potwierdzenia tras, komunikaty produktowe), ustawienia preferencji per kanał per użytkownik.', done: true },
      { range: '27—28 maja', title: 'Widok księgowego na telefonie',     desc: 'Mobilny dostęp do raportów PDF, eksportów FK, listy faktur kosztowych z OCR, kursów NBP — w trybie tylko do odczytu. Spójny z panelem webowym.' },
      { range: '27—28 maja', title: 'Widok biura rachunkowego na telefonie', desc: 'Przełączanie kontekstu między klientami, zbiorczy dashboard obsługiwanych firm, eksport per klient, zarządzanie zaproszeniami — wszystko z telefonu.' },
      { range: '28 maja', title: 'Pełny tryb offline',                   desc: 'Aplikacja działa bez internetu — trasy, paragony, dokumenty zapisywane lokalnie, automatyczna synchronizacja po odzyskaniu połączenia, bez ryzyka utraty danych.' },
      { range: '29 maja', title: 'Wydanie do App Store i Google Play',   desc: 'Aplikacja gotowa do publicznej dystrybucji w sklepach Apple i Google, automatyczne aktualizacje dla użytkowników.' },
      { range: '29 maja', title: 'Testy aplikacji mobilnej',             desc: 'Pokrycie testami jednostkowymi i scenariuszowymi czterech ról, regresja na każdą zmianę.' },
    ],
  },

  // ============================ FAZA 4 — WYDANIE MVP (WERSJA BETA) ============================
  {
    num: 4,
    id: 'mvp-beta',
    label: 'Wydanie MVP — wersja beta dla pilotów',
    period: '30 maja 2026',
    color: '#8B5CF6',
    status: 'upcoming',
    summary: 'MVP LIVE 30 maja 2026 jako wersja beta dla pierwszych firm pilotażowych. Pełen pakiet funkcji od pierwszego dnia: audyt bezpieczeństwa, fakturowanie, diety + KSeF, analityka rentowności, tachograf G2V2 i kontrola ITD, marża per zlecenie, VAT-REF, mapa live z geofencingiem, Dispatcher Hub, e-CMR, AETR DriverActivity Engine.',
    milestones: [
      { range: '30 maja',  title: 'MVP LIVE — wersja beta dla pilotów',         desc: 'Pełen audyt bezpieczeństwa, testy wydajnościowe, wdrożenie środowiska produkcyjnego, monitoring 24/7, dokumentacja operacyjna. Pierwsze firmy pilotażowe dostają środowisko beta z dożywotnim dostępem gratis.', milestone: true },
      { range: '30 maja',  title: 'Automatyczne fakturowanie',                  desc: 'Samodzielna rejestracja firm bez biura rachunkowego, automatyczne faktury VAT, samoobsługowe zarządzanie subskrypcją.' },
      { range: '30 maja',  title: 'Diety pracownicze i KSeF',                   desc: 'Eksport diet zagranicznych kierowców per kraj per dzień do Insert GT, Comarch ERP Optima i Symfonia FK. Integracja z Krajowym Systemem e-Faktur.' },
      { range: '30 maja',  title: 'Zaawansowana analityka rentowności',         desc: 'Raporty kosztów per zlecenie, per pojazd i per kierowca, porównania międzymiesięczne, wykrywanie trendów wykorzystania floty.' },
      { range: '30 maja',  title: 'Tachograf G2V2 i kontrola ITD',              desc: 'Monitoring legalizacji tachografów, ewidencja czasu pracy AETR, terminy uprawnień kierowców i licencji firmy. Uniknięcie kar do 10 000 zł na pojazd.' },
      { range: '30 maja',  title: 'AETR DriverActivity Engine',                 desc: 'Osiem typów aktywności kierowcy mapowanych na cztery symbole tachografu, auto-detekcja z GPS, alerty trzystopniowe (informacja / ostrzeżenie / naruszenie), raporty PDF dla kontroli ITD/BAG. Pełna strona: /aetr.' },
      { range: '30 maja',  title: 'Marża per zlecenie — realna rentowność',     desc: 'Zlecenie powiązane z pojazdem, kierowcą, trasą GPS i wszystkimi kosztami: paliwo, opłaty drogowe, hotele w Polsce i UE.' },
      { range: '30 maja',  title: 'Rozliczenie kierowcy — diety, mandaty, wypłata', desc: 'Diety zagraniczne według stawek z rozporządzenia, mandaty z winy kierowcy lub firmy, wydatki prywatne, przewalutowanie kursami NBP.' },
      { range: '30 maja',  title: 'VAT-REF z UE — odzyskaj VAT z paliwa i opłat drogowych', desc: 'Rejestracja faktur z DE, FR, IT, AT, automatyczne przeliczenie na PLN po kursie z dnia wystawienia, gotowy raport do wniosku o zwrot VAT.' },
      { range: '30 maja',  title: 'Mapa live + strefy alertów (geofencing)',    desc: 'Pojazdy widoczne w czasie rzeczywistym z czasem dojazdu, alert kiedy bus opuszcza strefę bez aktywnego zlecenia. Klient sam widzi, kiedy dotrze towar.' },
      { range: '30 maja',  title: 'Dispatcher Hub — komunikator dyspozytor ↔ kierowca', desc: 'Wbudowany w aplikację mobilną i panel webowy chat między dyspozytorem a kierowcą, powiązany z konkretnym zleceniem. Historia rozmów w dzienniku audytowym, możliwość zatwierdzania zleceń przez chat.' },
      { range: '30 maja',  title: 'e-CMR — cyfrowy list przewozowy',            desc: 'Pełna obsługa cyfrowego listu przewozowego (Konwencja CMR + e-CMR Additional Protocol 2008). Generowanie, podpis elektroniczny kierowcy i odbiorcy, archiwizacja, eksport do FK.' },
    ],
  },

  // ============================ FAZA 5 — PILOTAŻ + WERSJA 1.0.0 ALFA ============================
  {
    num: 5,
    id: 'pilot-1-0',
    label: 'Pilotaż i wersja 1.0.0 alfa',
    period: '1 czerwca — 31 lipca 2026',
    color: '#FF9500',
    status: 'future',
    summary: 'Dwumiesięczny pilotaż wersji beta u pierwszych firm transportowych. Na podstawie danych z realnego użycia dopasowujemy plany subskrypcji do wielkości flot i klientów, wdrażamy poprawki, fixy i dodatki zgłaszane przez pilotów. Koniec lipca — formalne wyjście z bety: wersja 1.0.0 alfa dostępna dla wszystkich.',
    milestones: [
      { range: '1—14 czerwca',  title: 'Onboarding pierwszych firm pilotażowych',          desc: 'Indywidualne spotkania 30 min z każdą firmą pilotażową, konfiguracja konta, import danych floty, szkolenie kierowców i właścicieli.' },
      { range: '15—30 czerwca', title: 'Dane z pilotażu i dopasowanie planów subskrypcji', desc: 'Analiza realnego użycia produktu — liczba aktywnych pojazdów, częstotliwość eksportów FK, użycie OCR, alerty AETR. Dopasowanie planów subskrypcji do wielkości flot i typów klientów (firma transportowa, biuro rachunkowe).' },
      { range: '1—31 lipca',    title: 'Poprawki, fixy i dodatki z feedbacku pilotażu',    desc: 'Iteracyjne wdrażanie poprawek i drobnych dodatków zgłaszanych przez pierwsze firmy. Każda zmiana walidowana z konkretnym pilotem przed publicznym wdrożeniem.' },
      { range: '31 lipca',      title: 'Wersja 1.0.0 alfa — wydanie publiczne',            desc: 'Formalne wyjście z fazy beta. Wersja 1.0.0 alfa dostępna dla wszystkich firm transportowych i biur rachunkowych — z planami subskrypcji dopasowanymi do realnych danych z pilotażu. Piloci kontynuują w programie pilotażowym dożywotnio.', milestone: true },
    ],
  },

  // ============================ FAZA 6 — WERSJA 2.0.0 ============================
  {
    num: 6,
    id: 'version-2-0',
    label: 'Wersja 2.0.0',
    period: 'sierpień — grudzień 2026',
    color: '#005CE8',
    status: 'future',
    summary: 'Druga generacja produktu — rozszerzenia analityczne i optymalizacyjne wykraczające poza ewidencję. Ewidencja zużycia paliwa, scoring kierowców, planowanie tras z uwzględnieniem przerw AETR, integrator opłat drogowych multi-kraj.',
    milestones: [
      { range: 'sierpień 2026', title: 'Ewidencja zużycia paliwa per pojazd',  desc: 'Pełna historia tankowań i zużycia paliwa per pojazd, per kierowca, per trasa. Porównanie z normą fabryczną i z historią pojazdu, wykrywanie odchyleń.' },
      { range: 'wrzesień 2026', title: 'Scoring kierowców 0–100',              desc: 'Indywidualna ocena każdego kierowcy w skali 0–100 na podstawie danych GPS — hamowania, przyspieszenia, prędkość, jazda nocna. Ranking kierowców w firmie, raport kosztowy per kierowca.' },
      { range: 'październik 2026', title: 'Planowanie tras z przerwami AETR',  desc: 'Inteligentne planowanie tras uwzględniające limity czasu pracy kierowcy (4,5h jazdy, 9h dziennie, przerwy 45 min), optymalizacja wielozleceń, integracja z mapami drogowymi i punktami odpoczynku.' },
      { range: 'listopad 2026', title: 'Integrator opłat drogowych multi-kraj', desc: 'Automatyczne pobieranie i rozliczanie opłat drogowych z wielu krajów UE (Toll Collect, Telepass, Mýto CZ, eMyto SK, ASFINAG, Eurovignette). Integracja z dostawcami typu DKV i UTA.' },
      { range: 'grudzień 2026', title: 'Wersja 2.0.0 LIVE',                    desc: 'Pełne wydanie wersji 2.0.0 dla wszystkich użytkowników, integracja wszystkich nowych funkcji z istniejącym produktem.', milestone: true },
    ],
  },

  // ============================ FAZA 7 — WERSJA 3.0.0 (R&D 2027–2028, POUFNE) ============================
  {
    num: 7,
    id: 'version-3-0',
    label: 'Wersja 3.0.0 — badania i rozwój',
    period: '2027 — 2028',
    color: '#8B5CF6',
    status: 'future',
    confidential: true,
    summary: 'Trzecia generacja produktu finansowana ze środków UE. Pięć projektów badawczo-rozwojowych w obszarze technologii transportu drogowego oraz scale-out platformy na rynki Czech, Słowacji i Niemiec. Szczegóły techniczne objęte tajemnicą przedsiębiorstwa.',
    milestones: [
      { range: '2027', title: 'Pierwszy etap prac badawczo-rozwojowych',          desc: 'Realizacja pierwszego etapu projektów badawczo-rozwojowych prowadzonych w konsorcjum z polską uczelnią techniczną. Walidacja na rozszerzonej grupie firm pilotażowych — 50+ firm transportowych w UE. Szczegółowy zakres prac, harmonogram i wskaźniki rezultatu dostępne po podpisaniu umowy o zachowaniu poufności (NDA).' },
      { range: '2028', title: 'Drugi etap i pełna komercjalizacja w UE',         desc: 'Drugi etap projektów badawczo-rozwojowych zakończony walidacją produkcyjną u 500+ klientów płacących. Równolegle wdrożenie produktu na rynkach czeskim, słowackim i niemieckim — pełna lokalizacja językowa, integracja z lokalnymi systemami księgowymi, zgodność z lokalnym prawem podatkowym i transportowym.' },
    ],
  },
];

// === Statystyki agregowane ===
const totalMilestones = phases.flatMap((p) => p.milestones).length;
const completedMilestones = phases
  .flatMap((p) => p.milestones.map((m) => ({ phaseStatus: p.status, done: m.done })))
  .filter((m) => m.phaseStatus === 'done' || m.done).length;
const phasesDone = phases.filter((p) => p.status === 'done').length;
const phasesTotal = phases.length;

const numberWord = (n: number, one: string, few: string, many: string): string => {
  if (n === 1) return one;
  const lastTwo = n % 100;
  const last = n % 10;
  if (lastTwo >= 12 && lastTwo <= 14) return many;
  if (last >= 2 && last <= 4) return few;
  return many;
};
---

<MarketingLayout title="Roadmapa — BusiKM" description="Plan rozwoju BusiKM — 3-letnia perspektywa. Pięć faz wdrożeniowych, MVP LIVE 30 maja 2026, dwa lata badań i rozwoju w 2027–2028 finansowanych ze środków UE.">

  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-surface">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at top, var(--brand-subtle) 0%, transparent 70%)"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-24 pb-20 sm:pt-32 sm:pb-28 text-center">

      <div class="hero-seq-1 inline-flex items-center gap-2 bg-brand/[0.08] border border-brand/15 rounded-full px-4 py-1.5 mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
        </span>
        <span class="text-sm font-medium text-text">e-TMS dla busów 2,5–3,5 t · MVP 30 maja 2026</span>
      </div>

      <h1 class="hero-seq-2 text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-text leading-[1.18] tracking-tight mb-6">
        Plan rozwoju produktu.<br>
        <span class="inline-block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-2">Wersja beta, 1.0.0, 2.0.0, 3.0.0.</span>
      </h1>

      <p class="hero-seq-3 text-lg sm:text-xl text-text-secondary leading-relaxed max-w-2xl mx-auto mb-10">
        <strong class="text-text">30 maja 2026 — MVP wersja beta</strong> dla pierwszych firm pilotażowych operujących busami 2,5–3,5&nbsp;t.
        <strong class="text-text">31 lipca 2026 — wersja 1.0.0 alfa</strong> wydana publicznie, po dwumiesięcznym pilotażu i dopasowaniu planów subskrypcji.
        <strong class="text-text">Grudzień 2026 — wersja 2.0.0</strong> ze scoringiem kierowców, planowaniem tras z przerwami AETR i integratorem opłat drogowych.
        <strong class="text-text">2027–2028 — wersja 3.0.0</strong> z funkcjami z programu badawczo-rozwojowego finansowanego ze środków UE (szczegóły poufne).
      </p>

      <div class="hero-seq-4 flex flex-wrap justify-center gap-4 mb-16">
        <a href="/cennik" class="inline-flex items-center gap-2 bg-brand hover:bg-brand-dark text-white font-semibold px-7 py-3.5 rounded-full transition-all hover:shadow-lg hover:-translate-y-0.5">
          Dołącz do pilotażu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="#timeline" class="inline-flex items-center gap-2 bg-surface-2 hover:bg-surface text-text border border-border font-semibold px-7 py-3.5 rounded-full transition-all hover:-translate-y-0.5">
          Zobacz timeline →
        </a>
      </div>

      <div class="hero-seq-5 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto text-center">
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#34C759] font-display leading-none">{completedMilestones}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">kamieni milowych zrealizowanych</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-brand font-display leading-none">{phasesDone}/{phasesTotal}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">faz w pełni gotowych</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-text font-display leading-none">{totalMilestones - completedMilestones}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">kamieni milowych w planie</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-brand-light font-display leading-none">30 maj</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">MVP LIVE 2026</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LEGENDA + NAWIGACJA FAZ ===================== -->
  <section id="timeline" class="bg-surface-2 py-16 sm:py-20 border-t border-border-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-10 reveal">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand mb-4">Wszystkie fazy projektu</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-text tracking-tight mb-4">Siedem faz. Trzy lata. Jedna timeline.</h2>
        <p class="text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
          Od architektury backendu (kwiecień 2026) do pełnej komercjalizacji w czterech krajach UE (koniec 2028). Każda faza ma jasny cel biznesowy i przekłada się na konkretną wartość dla firm transportowych.
        </p>
      </div>

      <!-- Legenda statusów -->
      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-3 mb-10 reveal">
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full bg-[#34C759]"></span>
          <span><strong class="text-text">Zrobione</strong> — solidna linia, pełne karty</span>
        </div>
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full bg-[#FF9500]"></span>
          <span><strong class="text-text">W toku</strong> — kamienie milowe mieszane gotowe + w planie</span>
        </div>
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full border-2 border-dashed border-[#8B5CF6]"></span>
          <span><strong class="text-text">Planowane</strong> — linia przerywana, karty z mniejszą wagą</span>
        </div>
      </div>

      <!-- Nawigacja: skok do fazy -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 max-w-5xl mx-auto reveal-stagger">
        {phases.map((phase) => (
          <a href={`#faza-${phase.id}`} class="block p-3 rounded-2xl bg-surface border border-border-subtle hover:border-border hover:shadow-sm transition-all text-left">
            <div class="flex items-center gap-2 mb-1.5">
              <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full text-[10.5px] font-bold text-white shrink-0 ${phase.status === 'done' ? '' : phase.status === 'future' ? 'opacity-90' : ''}`} style={`background: ${phase.color}`}>
                {phase.num}
              </span>
              {phase.status === 'done' && (
                <svg class="w-3.5 h-3.5 text-[#34C759] ml-auto shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {phase.status === 'in-progress' && (
                <span class="ml-auto text-[9px] font-bold uppercase tracking-wider text-[#FF9500] bg-[#FF9500]/[0.12] px-1.5 py-0.5 rounded">W toku</span>
              )}
            </div>
            <p class="font-semibold text-[12.5px] text-text leading-tight mb-1">{phase.label}</p>
            <p class="text-[10.5px] text-text-tertiary leading-tight">{phase.period}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TIMELINE 7 FAZ ===================== -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <div class="relative">

        {phases.map((phase, phaseIdx) => {
          const isLast = phaseIdx === phases.length - 1;
          return (
            <div id={`faza-${phase.id}`} class={`relative ${isLast ? '' : 'mb-14 sm:mb-20'}`}>

              <!-- Vertical line — między nagłówkiem fazy a ostatnim kamieniem milowym, kolorowana per status -->
              <div
                class="absolute left-[19px] sm:left-[27px] w-[2px]"
                style={`
                  top: 56px;
                  bottom: -56px;
                  background: ${phase.status === 'future'
                    ? `repeating-linear-gradient(to bottom, ${phase.color} 0 6px, transparent 6px 12px)`
                    : phase.color
                  };
                  ${isLast ? 'bottom: 0;' : ''}
                `}
              ></div>

              <!-- ====== Phase header ====== -->
              <div class="relative pl-16 sm:pl-20 mb-6">
                <!-- Phase number badge — kolor + obwódka theme-aware -->
                <div
                  class="absolute left-0 sm:left-2 top-0 w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center text-white font-extrabold text-[15px] sm:text-[17px] font-display shadow-[0_4px_14px_rgba(0,0,0,0.18)]"
                  style={`background: ${phase.color}; box-shadow: 0 0 0 4px var(--surface), 0 4px 14px rgba(0,0,0,0.2);`}
                >
                  {phase.num}
                </div>

                <div class="pt-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <p class="text-[11px] font-bold uppercase tracking-[0.1em]" style={`color: ${phase.color}`}>
                      Faza {phase.num} · {phase.period}
                    </p>
                    {phase.status === 'done' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#34C759] bg-[#34C759]/[0.10] px-2 py-0.5 rounded-full">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Zrobione
                      </span>
                    )}
                    {phase.status === 'in-progress' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#FF9500] bg-[#FF9500]/[0.12] px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500] animate-pulse"></span>
                        W toku
                      </span>
                    )}
                    {phase.status === 'upcoming' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#8B5CF6] bg-[#8B5CF6]/[0.12] px-2 py-0.5 rounded-full">
                        Planowane
                      </span>
                    )}
                    {phase.status === 'future' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-text-tertiary bg-surface-2 border border-border-subtle px-2 py-0.5 rounded-full">
                        Przyszłość
                      </span>
                    )}
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight mb-3">{phase.label}</h3>
                  <p class="text-[15px] text-text-secondary leading-relaxed max-w-3xl mb-3">{phase.summary}</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-1.5 text-[11.5px] font-medium text-text-secondary bg-surface-2 border border-border-subtle px-2.5 py-1 rounded-full">
                      {phase.milestones.length} {numberWord(phase.milestones.length, 'kamień milowy', 'kamienie milowe', 'kamieni milowych')}
                    </span>
                    {phase.confidential && (
                      <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-white px-2.5 py-1 rounded-full" style={`background: ${phase.color}`}>
                        Finansowane ze środków UE
                      </span>
                    )}
                  </div>
                </div>
              </div>

              <!-- ====== Confidential note (dla faz R&D) ====== -->
              {phase.confidential && (
                <div class="relative pl-16 sm:pl-20 mb-6">
                  <div class="rounded-[18px] p-5 sm:p-6" style={`background: ${phase.color}; color: white;`}>
                    <div class="flex items-start gap-3">
                      <svg class="w-5 h-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                      <div>
                        <p class="text-[12.5px] font-bold uppercase tracking-[0.1em] text-white/80 mb-2">Informacja poufna</p>
                        <p class="text-[14px] leading-relaxed text-white/90">
                          Szczegółowy zakres prac w fazie badawczo-rozwojowej objęty jest tajemnicą przedsiębiorstwa do momentu zakończenia projektu i akceptacji raportu końcowego przez instytucję finansującą. Dokumentacja techniczna dostępna po podpisaniu umowy o zachowaniu poufności (NDA).
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              <!-- ====== Milestones — timeline items ====== -->
              <div class="space-y-3">
                {phase.milestones.map((m) => {
                  const isDone = phase.status === 'done' || m.done;
                  const isMilestone = m.milestone;
                  return (
                    <div class="relative pl-16 sm:pl-20">
                      <!-- Milestone dot — done = solid, upcoming = outline -->
                      {isDone ? (
                        <div class="absolute left-[14px] sm:left-[22px] top-5 w-3.5 h-3.5 rounded-full shadow" style={`background: ${phase.color}; box-shadow: 0 0 0 3px var(--surface);`}></div>
                      ) : (
                        <div class="absolute left-[14px] sm:left-[22px] top-5 w-3.5 h-3.5 rounded-full" style={`background: var(--surface); border: 2px solid ${phase.color}; box-shadow: 0 0 0 3px var(--surface);`}></div>
                      )}

                      <div
                        class:list={[
                          'rounded-[14px] p-4 sm:p-5 transition-all',
                          isMilestone
                            ? 'bg-surface border-2 shadow-[0_4px_20px_rgba(0,0,0,0.08)]'
                            : isDone
                              ? 'bg-surface border border-border-subtle'
                              : 'bg-surface-2 border border-border-subtle hover:border-border hover:shadow-sm'
                        ]}
                        style={isMilestone ? `border-color: ${phase.color}` : ''}
                      >
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                          <p class="text-[11.5px] text-text-secondary font-semibold">{m.range}</p>
                          {isDone && !isMilestone && (
                            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#34C759] bg-[#34C759]/[0.10] px-1.5 py-0.5 rounded">
                              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              Zrobione
                            </span>
                          )}
                        </div>
                        <h4 class="font-semibold text-[15px] text-text mb-1 leading-tight">
                          {m.title}
                          {isMilestone && <span class="ml-2 text-[10px] font-bold uppercase tracking-wider align-middle px-2 py-0.5 rounded text-white" style={`background: ${phase.color}`}>MVP LIVE</span>}
                        </h4>
                        <p class="text-[13.5px] text-text-secondary leading-relaxed">{m.desc}</p>
                      </div>
                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ===================== INTEGRACJE FK ===================== -->
  <section class="bg-surface-2 py-16 sm:py-20 border-t border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-surface rounded-[20px] p-7 sm:p-10 shadow-[0_1px_4px_rgba(0,0,0,0.06)] border border-border-subtle">
        <div class="flex items-center gap-3 mb-5">
          <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><polyline points="8 6 2 12 8 18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          <h3 class="font-bold text-text text-lg">Trzy integracje FK — gotowe w MVP</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
          {[
            { name: 'Insert GT', desc: 'eksport jednym kliknięciem' },
            { name: 'Comarch ERP Optima', desc: 'eksport jednym kliknięciem' },
            { name: 'Symfonia FK', desc: 'eksport jednym kliknięciem' },
          ].map(s => (
            <div class="flex items-center gap-3 bg-surface-2 rounded-xl px-4 py-3">
              <svg class="w-4 h-4 text-[#34C759] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-sm font-semibold text-text leading-tight">{s.name}</p>
                <p class="text-xs text-text-tertiary">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="text-xs text-text-tertiary">Eksport diet zagranicznych kierowców do tych samych systemów oraz integracja z Krajowym Systemem e-Faktur (KSeF) — na przełomie maja i czerwca 2026, w fazie post-MVP.</p>
      </div>
    </div>
  </section>

  <!-- ===================== ROLA PILOTÓW ===================== -->
  <section class="bg-surface py-20 sm:py-28 border-t border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-12 reveal">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand mb-4">Rola pilotów</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-text tracking-tight mb-4">
          Każda nowa funkcja przechodzi przez firmy transportowe.
        </h2>
        <p class="text-lg text-text-secondary leading-relaxed">
          Zanim funkcja trafi do publicznej wersji produktu, jest walidowana z firmami transportowymi pilotażowymi — właścicielami flot, dyspozytorami, kierowcami, księgowymi. To oni mówią, czy działa zgodnie z praktyką transportową, czy wymaga doprecyzowania — albo czy nie ma sensu w obecnej formie.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 reveal-stagger">
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-brand/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Wczesny dostęp</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Piloci otrzymują nowe funkcje 4–8 tygodni przed publicznym wdrożeniem. Mają czas przetestować je w realnej pracy.</p>
        </div>
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-[#34C759]/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#34C759]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Realny wpływ</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Krótka rozmowa raz w miesiącu: co działa, co nie, co warto poprawić. Decyzje produktowe podejmujemy na podstawie tych odpowiedzi.</p>
        </div>
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-[#FF9500]/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#FF9500]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Dożywotni dostęp</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Piloci pozostają w programie pilotażowym bezterminowo — bez konwersji na płatny plan. To podziękowanie za czas, który nam dali.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================== DARK CTA ===================== -->
  <section class="bg-[#0F1115] py-20 sm:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center reveal">

      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6">
        Współtwórz BusiKM od początku.
      </h2>
      <p class="text-lg text-white/65 mb-10 max-w-xl mx-auto">
        Zapraszamy ograniczoną liczbę firm transportowych do programu pilotażowego — dożywotni dostęp gratis, w zamian za udział w walidacji nowych funkcji.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/cennik" class="inline-flex items-center gap-2 bg-brand hover:bg-brand-light text-white font-semibold px-8 py-4 rounded-full transition-all hover:shadow-lg hover:-translate-y-0.5">
          Dołącz do pilotażu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/funkcje" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-full transition-all border border-white/20">
          Zobacz wszystkie funkcje
        </a>
      </div>
    </div>
  </section>

</MarketingLayout>
