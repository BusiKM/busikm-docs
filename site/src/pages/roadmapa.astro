      <div class="hero-seq-5 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto text-center">
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#34C759] font-display leading-none">{closedTicketsCount}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">ukończonych ticketów</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-brand font-display leading-none">{closedSprintsCount}/{closedSprintsCount + upcomingSprintsCount}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">sprintów gotowych</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-text font-display leading-none">{upcomingTicketsCount}</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">ticketów w backlogu</div>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-3xl sm:text-4xl font-extrabold text-brand-light font-display leading-none">30 maj</div>
          <div class="text-sm text-text-tertiary mt-2 min-h-[2.5rem] flex items-start justify-center">MVP LIVE 2026</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LEGENDA + NAWIGACJA FAZ ===================== -->
  <section id="timeline" class="bg-surface-2 py-16 sm:py-20 border-t border-border-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-10 reveal">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand mb-4">Wszystkie fazy projektu</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-text tracking-tight mb-4">Siedem faz. Trzy lata. Jedna timeline.</h2>
        <p class="text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
          Od architektury backendu (kwiecień 2026) do market-ready scale-out pan-EU (Q4 2028). Każda faza ma jasny cel biznesowy i przekłada się na konkretną wartość dla firm transportowych.
        </p>
      </div>

      <!-- Legenda statusów -->
      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-3 mb-10 reveal">
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full bg-[#34C759]"></span>
          <span><strong class="text-text">Zrobione</strong> — solidna linia, pełne karty</span>
        </div>
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full bg-[#FF9500]"></span>
          <span><strong class="text-text">W toku</strong> — sprinty mieszane done + upcoming</span>
        </div>
        <div class="inline-flex items-center gap-2 text-[12.5px] text-text-secondary">
          <span class="w-3 h-3 rounded-full border-2 border-dashed border-[#8B5CF6]"></span>
          <span><strong class="text-text">Planowane</strong> — linia przerywana, karty z mniejszą wagą</span>
        </div>
      </div>

      <!-- Nawigacja: skok do fazy -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5 max-w-5xl mx-auto reveal-stagger">
        {phases.map((phase) => (
          <a href={`#faza-${phase.id}`} class="block p-3 rounded-2xl bg-surface border border-border-subtle hover:border-border hover:shadow-sm transition-all text-left">
            <div class="flex items-center gap-2 mb-1.5">
              <span class={`inline-flex items-center justify-center w-6 h-6 rounded-full text-[10.5px] font-bold text-white shrink-0 ${phase.status === 'done' ? '' : phase.status === 'future' ? 'opacity-90' : ''}`} style={`background: ${phase.color}`}>
                {phase.num}
              </span>
              {phase.status === 'done' && (
                <svg class="w-3.5 h-3.5 text-[#34C759] ml-auto shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {phase.status === 'in-progress' && (
                <span class="ml-auto text-[9px] font-bold uppercase tracking-wider text-[#FF9500] bg-[#FF9500]/[0.12] px-1.5 py-0.5 rounded">W toku</span>
              )}
            </div>
            <p class="font-semibold text-[12.5px] text-text leading-tight mb-1">{phase.label}</p>
            <p class="text-[10.5px] text-text-tertiary leading-tight">{phase.period}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TIMELINE 7 FAZ ===================== -->
  <section class="bg-surface py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <div class="relative">

        {phases.map((phase, phaseIdx) => {
          const isLast = phaseIdx === phases.length - 1;
          const doneTickets = phase.sprints.filter((s) => typeof s.tickets === 'number' && (phase.status === 'done' || s.done)).reduce((a, s) => a + (typeof s.tickets === 'number' ? s.tickets : 0), 0);
          const totalTickets = phase.sprints.filter((s) => typeof s.tickets === 'number').reduce((a, s) => a + (typeof s.tickets === 'number' ? s.tickets : 0), 0);
          return (
            <div id={`faza-${phase.id}`} class={`relative ${isLast ? '' : 'mb-14 sm:mb-20'}`}>

              <!-- Vertical line — between phase header dot i ostatni sprint, kolorowana per status -->
              <div
                class="absolute left-[19px] sm:left-[27px] w-[2px]"
                style={`
                  top: 56px;
                  bottom: -56px;
                  background: ${phase.status === 'future'
                    ? `repeating-linear-gradient(to bottom, ${phase.color} 0 6px, transparent 6px 12px)`
                    : phase.color
                  };
                  ${isLast ? 'bottom: 0;' : ''}
                `}
              ></div>

              <!-- ====== Phase header ====== -->
              <div class="relative pl-16 sm:pl-20 mb-6">
                <!-- Phase number badge — kolor + obwódka theme-aware -->
                <div
                  class="absolute left-0 sm:left-2 top-0 w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center text-white font-extrabold text-[15px] sm:text-[17px] font-display shadow-[0_4px_14px_rgba(0,0,0,0.18)]"
                  style={`background: ${phase.color}; box-shadow: 0 0 0 4px var(--surface), 0 4px 14px rgba(0,0,0,0.2);`}
                >
                  {phase.num}
                </div>

                <div class="pt-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <p class="text-[11px] font-bold uppercase tracking-[0.1em]" style={`color: ${phase.color}`}>
                      Faza {phase.num} · {phase.period}
                    </p>
                    {phase.status === 'done' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#34C759] bg-[#34C759]/[0.10] px-2 py-0.5 rounded-full">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Done
                      </span>
                    )}
                    {phase.status === 'in-progress' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#FF9500] bg-[#FF9500]/[0.12] px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#FF9500] animate-pulse"></span>
                        W toku
                      </span>
                    )}
                    {phase.status === 'upcoming' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#8B5CF6] bg-[#8B5CF6]/[0.12] px-2 py-0.5 rounded-full">
                        Planowane
                      </span>
                    )}
                    {phase.status === 'future' && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-text-tertiary bg-surface-2 border border-border-subtle px-2 py-0.5 rounded-full">
                        Roadmap R&amp;D
                      </span>
                    )}
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight mb-3">{phase.label}</h3>
                  <p class="text-[15px] text-text-secondary leading-relaxed max-w-3xl mb-3">{phase.summary}</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-1.5 text-[11.5px] font-medium text-text-secondary bg-surface-2 border border-border-subtle px-2.5 py-1 rounded-full">
                      {phase.sprints.length} {numberWord(phase.sprints.length)}
                    </span>
                    {totalTickets > 0 && (
                      <span class="inline-flex items-center gap-1.5 text-[11.5px] font-medium text-text-secondary bg-surface-2 border border-border-subtle px-2.5 py-1 rounded-full">
                        {totalTickets} ticketów{phase.status === 'in-progress' ? ` (${doneTickets} Done · ${totalTickets - doneTickets} w toku)` : ''}
                      </span>
                    )}
                    {phase.grant && (
                      <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-white px-2.5 py-1 rounded-full" style={`background: ${phase.color}`}>
                        {phase.grant.name}
                      </span>
                    )}
                  </div>
                </div>
              </div>

              <!-- ====== Grant program box (jeżeli grant) ====== -->
              {phase.grant && (
                <div class="relative pl-16 sm:pl-20 mb-6">
                  <div class="rounded-[18px] p-5 sm:p-6" style={`background: ${phase.color}; color: white;`}>
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                      <p class="text-[10.5px] font-bold uppercase tracking-[0.1em] text-white/70">Program grantowy</p>
                      <span class="text-[10.5px] font-mono font-bold bg-white/15 text-white px-2.5 py-1 rounded">{phase.grant.name}</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-[12.5px] mt-2">
                      <div><p class="text-white/65 mb-0.5">Fundator</p><p class="font-semibold">{phase.grant.funder}</p></div>
                      <div><p class="text-white/65 mb-0.5">Faza projektu</p><p class="font-semibold">{phase.grant.trl}</p></div>
                      <div><p class="text-white/65 mb-0.5">Termin wniosku</p><p class="font-semibold">{phase.grant.deadline}</p></div>
                    </div>
                  </div>
                </div>
              )}

              <!-- ====== Sprints — timeline items ====== -->
              <div class="space-y-3">
                {phase.sprints.map((sprint) => {
                  const isDone = phase.status === 'done' || sprint.done;
                  const isMilestone = sprint.milestone;
                  return (
                    <div class="relative pl-16 sm:pl-20">
                      <!-- Sprint timeline dot — done = solid pełna, upcoming = outline -->
                      {isDone ? (
                        <div class="absolute left-[14px] sm:left-[22px] top-5 w-3.5 h-3.5 rounded-full shadow" style={`background: ${phase.color}; box-shadow: 0 0 0 3px var(--surface);`}></div>
                      ) : (
                        <div class="absolute left-[14px] sm:left-[22px] top-5 w-3.5 h-3.5 rounded-full" style={`background: var(--surface); border: 2px solid ${phase.color}; box-shadow: 0 0 0 3px var(--surface);`}></div>
                      )}

                      <div
                        class:list={[
                          'rounded-[14px] p-4 sm:p-5 transition-all',
                          isMilestone
                            ? 'bg-surface border-2 shadow-[0_4px_20px_rgba(0,0,0,0.08)]'
                            : isDone
                              ? 'bg-surface border border-border-subtle'
                              : 'bg-surface-2 border border-border-subtle hover:border-border hover:shadow-sm'
                        ]}
                        style={isMilestone ? `border-color: ${phase.color}` : ''}
                      >
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                          <span class="inline-flex items-center justify-center h-6 px-2 text-[10.5px] font-mono font-bold rounded-md" style={`background: ${phase.color}1A; color: ${phase.color}`}>
                            {sprint.id}
                          </span>
                          <p class="text-[11.5px] text-text-secondary font-medium">{sprint.range}</p>
                          {isDone && !isMilestone && (
                            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-[#34C759] bg-[#34C759]/[0.10] px-1.5 py-0.5 rounded">
                              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              Done
                            </span>
                          )}
                          <span class="ml-auto text-[11px] font-mono text-text-tertiary">
                            {typeof sprint.tickets === 'number' ? `${sprint.tickets} ${sprint.tickets === 1 ? 'ticket' : 'ticketów'}` : sprint.tickets}
                          </span>
                        </div>
                        <h4 class="font-semibold text-[15px] text-text mb-1 leading-tight">
                          {sprint.title}
                          {isMilestone && <span class="ml-2 text-[10px] font-bold uppercase tracking-wider align-middle px-2 py-0.5 rounded text-white" style={`background: ${phase.color}`}>MVP LIVE</span>}
                        </h4>
                        <p class="text-[13.5px] text-text-secondary leading-relaxed">{sprint.desc}</p>
                      </div>
                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ===================== INTEGRACJE FK ===================== -->
  <section class="bg-surface-2 py-16 sm:py-20 border-t border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-surface rounded-[20px] p-7 sm:p-10 shadow-[0_1px_4px_rgba(0,0,0,0.06)] border border-border-subtle">
        <div class="flex items-center gap-3 mb-5">
          <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><polyline points="8 6 2 12 8 18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
          <h3 class="font-bold text-text text-lg">Trzy integracje FK — gotowe w MVP</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
          {[
            { name: 'Insert GT', desc: 'eksport jednym kliknięciem' },
            { name: 'Comarch ERP Optima', desc: 'eksport jednym kliknięciem' },
            { name: 'Symfonia FK', desc: 'eksport jednym kliknięciem' },
          ].map(s => (
            <div class="flex items-center gap-3 bg-surface-2 rounded-xl px-4 py-3">
              <svg class="w-4 h-4 text-[#34C759] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-sm font-semibold text-text leading-tight">{s.name}</p>
                <p class="text-xs text-text-tertiary">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="text-xs text-text-tertiary">Eksport diet zagranicznych kierowców do tych samych systemów oraz integracja z Krajowym Systemem e-Faktur (KSeF) — na przełomie maja i czerwca 2026, w fazie post-MVP.</p>
      </div>
    </div>
  </section>

  <!-- ===================== ROLA PILOTÓW ===================== -->
  <section class="bg-surface py-20 sm:py-28 border-t border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-12 reveal">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand mb-4">Rola pilotów</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-text tracking-tight mb-4">
          Każda nowa funkcja przechodzi przez firmy transportowe.
        </h2>
        <p class="text-lg text-text-secondary leading-relaxed">
          Zanim funkcja trafi do publicznej wersji produktu, jest walidowana z firmami transportowymi pilotażowymi — właścicielami flot, dyspozytorami, kierowcami, księgowymi. To oni mówią, czy działa zgodnie z praktyką transportową, czy wymaga doprecyzowania — albo czy nie ma sensu w obecnej formie.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 reveal-stagger">
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-brand/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Wczesny dostęp</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Piloci otrzymują nowe funkcje 4–8 tygodni przed publicznym wdrożeniem. Mają czas przetestować je w realnej pracy.</p>
        </div>
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-[#34C759]/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#34C759]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Realny wpływ</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Krótka rozmowa raz w miesiącu: co działa, co nie, co warto poprawić. Decyzje produktowe podejmujemy na podstawie tych odpowiedzi.</p>
        </div>
        <div class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-11 h-11 rounded-[14px] bg-[#FF9500]/[0.08] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[#FF9500]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[1rem] text-text mb-2">Dożywotni dostęp</h3>
          <p class="text-[14px] text-text-secondary leading-relaxed">Piloci pozostają w programie pilotażowym bezterminowo — bez konwersji na płatny plan. To podziękowanie za czas, który nam dali.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================== DARK CTA ===================== -->
  <section class="bg-[#0F1115] py-20 sm:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center reveal">

      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6">
        Współtwórz BusiKM od początku.
      </h2>
      <p class="text-lg text-white/65 mb-10 max-w-xl mx-auto">
        Zapraszamy ograniczoną liczbę firm transportowych do programu pilotażowego — dożywotni dostęp gratis, w zamian za udział w walidacji nowych funkcji.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/cennik" class="inline-flex items-center gap-2 bg-brand hover:bg-brand-light text-white font-semibold px-8 py-4 rounded-full transition-all hover:shadow-lg hover:-translate-y-0.5">
          Dołącz do pilotażu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/technologia" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-full transition-all border border-white/20">
          Czytaj dokumentację R&amp;D
        </a>
      </div>
    </div>
  </section>

</MarketingLayout>
