---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../lib/app-url';

/**
 * /aetr — pillar page Filar Compliance AETR (DriverActivity Engine).
 * Podstawa prawna: rozporządzenie (WE) nr 561/2006 + Pakiet Mobilności UE + AETR.
 * 8 sekcji: hero, co monitorujemy, regulacje, jak to działa, mobile, web, FAQ, CTA.
 */

// === 6 obszarów regulacyjnych (sekcja "Co monitorujemy") ===
const monitoredAreas = [
  {
    label: 'Czas jazdy',
    title: 'Dzienny, tygodniowy, dwutygodniowy',
    limits: ['9h dziennie (10h max 2× w tyg.)', '56h w tygodniu', '90h przez 2 kolejne tygodnie'],
    engine: 'Cztery niezależne liczniki w czasie rzeczywistym: ciągły (od ostatniej przerwy), dzienny, tygodniowy i dwutygodniowy.',
    color: '#005CE8',
    icon: `<circle cx="12" cy="12" r="9" stroke-width="1.6"/><path d="M12 7v5l3 3" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    label: 'Przerwy w jeździe',
    title: 'Po 4,5h — 45 min',
    limits: ['Przerwa 45 min ciągła', 'Alternatywnie 15 + 30 min', 'Inna praca nie liczy się jako przerwa'],
    engine: 'Śledzi 4,5h (270 min) ciągłej jazdy; poprawnie rozpoznaje rozbicie przerwy na 15 + 30 min w wymaganej kolejności.',
    color: '#FF9500',
    icon: `<path d="M6 2v4M10 2v4M14 2v4M18 2v4M4 7h16v13a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" stroke-width="1.6"/>`,
  },
  {
    label: 'Odpoczynek dzienny',
    title: '11h regularnie · 9h skrócony',
    limits: ['11h ciągłego (regularny)', '9h skrócony max 3× między tygodn.', '3h + 9h dzielony — w tej kolejności'],
    engine: 'Rozpoznaje wszystkie warianty odpoczynku: regularny 11h, skrócony 9h, dzielony 3h+9h oraz załogę 2-osobową w oknie 30h.',
    color: '#34C759',
    icon: `<path d="M3 18a9 9 0 1118 0" stroke-width="1.6" stroke-linecap="round"/><path d="M12 3v3M5.6 5.6l2.1 2.1M18.4 5.6l-2.1 2.1" stroke-width="1.6" stroke-linecap="round"/>`,
  },
  {
    label: 'Odpoczynek tygodniowy',
    title: '45h regularny · 24h skrócony',
    limits: ['45h regularnie co 2 tygodnie', '24h skrócony max 1× na 2 tyg.', 'Rekompensata en bloc przed końcem 3. tyg.'],
    engine: 'Pilnuje 6-dniowego okna od ostatniego odpoczynku tygodniowego; wylicza dług en bloc do rekompensaty do końca 3. tygodnia.',
    color: '#A78BFA',
    icon: `<rect x="3" y="6" width="18" height="14" rx="2" stroke-width="1.6"/><path d="M3 11h18M8 6V4M16 6V4" stroke-width="1.6"/>`,
  },
  {
    label: 'Pakiet Mobilności',
    title: 'Powrót do bazy · zakaz odpoczynku w kabinie',
    limits: ['Regularny 45h poza pojazdem (hotel/dom)', 'Powrót do bazy max co 4 tyg.', 'Skrócony 24h dopuszczalny w kabinie'],
    engine: 'Liczy 4-tygodniowe okno powrotu do bazy; flaguje regularny odpoczynek 45h spędzony w pojeździe wbrew zakazowi.',
    color: '#FF6B5C',
    icon: `<path d="M3 12l9-9 9 9M5 10v10a2 2 0 002 2h10a2 2 0 002-2V10" stroke-width="1.6"/><path d="M10 22v-6h4v6" stroke-width="1.6"/>`,
  },
  {
    label: 'Wyjątki — przedłużenie jazdy',
    title: '+1h lub +2h dla dotarcia do bazy',
    limits: ['+1h: skrócenie odpoczynku 11→10h', '+2h: wymaga 30 min przerwy wcześniej', 'Powrót na odpoczynek 45h obowiązkowy'],
    engine: 'Śledzi liczbę użyć wyjątku przedłużenia jazdy w tygodniu (max 2× po 10h) oraz pilnuje obowiązkowej rekompensaty.',
    color: '#3380FF',
    icon: `<path d="M12 2L3 7v6c0 5 3.5 9.5 9 11 5.5-1.5 9-6 9-11V7l-9-5z" stroke-width="1.6"/><path d="M9 12l2 2 4-4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];

// === Tabele regulacyjne 561/2006 (sekcja Regulacje) ===
const drivingTimeRows = [
  { cat: 'Dzienny czas jazdy', limit: 'max 9 godzin', note: 'Można wydłużyć do 10h — max 2× w tygodniu' },
  { cat: 'Tygodniowy czas jazdy', limit: 'max 56 godzin', note: '7 kolejnych dni kalendarzowych' },
  { cat: 'Dwutygodniowy czas jazdy', limit: 'max 90 godzin', note: 'Dwa kolejne tygodnie łącznie' },
];

const breaksRows = [
  { situation: 'Po 4,5h jazdy', rule: 'min 45 minut przerwy ciągłej' },
  { situation: 'Alternatywnie', rule: '15 min, potem 30 min (w tej kolejności)' },
  { situation: 'Wydłużenie jazdy o 2h (wyjątek)', rule: 'Dodatkowa 30 min przerwa przed tymi 2h' },
  { situation: 'Załoga wieloosobowa', rule: 'Kierowca-pasażer może odpoczywać w jadącym pojeździe' },
];

const dailyRestRows = [
  { variant: 'Regularny', time: 'min 11 godzin', conditions: 'Ciągły, w ciągu 24h od rozpoczęcia pracy' },
  { variant: 'Skrócony', time: 'min 9 godzin', conditions: 'Max 3 razy między dwoma odpoczynkami tygodniowymi — bez rekompensaty' },
  { variant: 'Dzielony', time: '3h + 9h', conditions: 'Można podzielić: 3h ciągłe, potem 9h ciągłych' },
  { variant: 'Załoga 2-osobowa', time: 'min 9 godzin', conditions: 'Każdy kierowca, w ciągu 30h od zakończenia poprzedniego odpoczynku' },
];

const weeklyRestRows = [
  { variant: 'Regularny', time: 'min 45 godzin', conditions: 'Obowiązkowy co drugi tydzień minimum' },
  { variant: 'Skrócony', time: 'min 24 godziny', conditions: 'Max 1× na 2 tygodnie — brakujące godziny do 45h en bloc przed końcem 3. tyg. następującego' },
  { variant: 'Kiedy najpóźniej', time: 'po 6 kolejnych okresach 24h', conditions: 'Od zakończenia ostatniego odpoczynku tygodniowego' },
];

const tachographActivities = [
  { code: 'JAZDA', activityTypes: 'DRIVING, BASE_RETURN', desc: 'Aktywne prowadzenie pojazdu wykrywane z GPS (prędkość > 5 km/h)' },
  { code: 'INNA PRACA', activityTypes: 'LOADING, UNLOADING, OTHER_WORK', desc: 'Załadunek, rozładunek, dokumenty, naprawy, odprawa celna' },
  { code: 'GOTOWOŚĆ', activityTypes: 'AVAILABILITY', desc: 'Oczekiwanie, jazda jako pasażer w załodze 2-osobowej' },
  { code: 'PRZERWA / ODPOCZYNEK', activityTypes: 'BREAK, REST', desc: 'Wymagana przerwa 45 min lub odpoczynek dzienny/tygodniowy' },
];

// === FAQ ===
const faq = [
  {
    q: 'Czy BusiKM zastępuje tachograf G2V2?',
    a: 'Nie. Tachograf G2V2 jest obowiązkiem prawnym dla pojazdów >2,5 t w transporcie międzynarodowym od 2 lipca 2026 i pozostaje urządzeniem certyfikowanym do kontroli ITD/BAG/Gendarmerie. BusiKM działa równolegle — monitoruje te same reguły 561/2006 z GPS i aktywności kierowcy, alarmuje zanim wystąpi naruszenie. Tachograf to wymóg formalny, BusiKM to system zapobiegania karom.',
  },
  {
    q: 'Co pokazać przy kontroli ITD/BAG/Gendarmerie/Polizia Stradale?',
    a: 'Inspektor sczyta dane bezpośrednio z tachografu (jak zawsze). BusiKM dodatkowo generuje PDF z czasem pracy w danym dniu, tygodniu i 4 tygodniach — zgodny ze standardem 561/2006 i Pakietu Mobilności. Eksport jednym kliknięciem z panelu właściciela lub z aplikacji kierowcy. Pomocny przy wyjaśnianiu sytuacji granicznych (rekompensata skróconego odpoczynku, wyjątki przedłużenia jazdy).',
  },
  {
    q: 'Co jeśli kierowca wyjeżdża poza UE (Ukraina, Białoruś, Mołdawia, Turcja)?',
    a: 'BusiKM rozpoznaje przekroczenie granicy UE (algorytm point-in-polygon — jeden z naszych komponentów R&D) i przełącza tryb walidacji na konwencję AETR. Reguły AETR są zbliżone do 561/2006, ale różnią się w szczegółach (przerwy, dokumentacja). Jeśli trasa przebiega częściowo przez kraje AETR (np. PL → DE → UA), cała operacja podlega AETR — BusiKM stosuje wtedy AETR przez cały okres.',
  },
  {
    q: 'Jak dokładne jest auto-detection aktywności z GPS?',
    a: 'Auto-detection działa co 1 minutę na podstawie prędkości GPS i lokalizacji. Prędkość powyżej 5 km/h → automatycznie JAZDA. Postój ponad 5 min przy adresie załadunku ze zlecenia → sugestia ZAŁADUNEK. Postój przy adresie rozładunku → sugestia ROZŁADUNEK. Postój w innym miejscu → sugestia PRZERWA lub GOTOWOŚĆ (kierowca potwierdza w aplikacji). Dla aktywności wymagających deklaracji (PRZERWA vs GOTOWOŚĆ) decyzja zawsze należy do kierowcy — auto-detection sugeruje, kierowca potwierdza tapnięciem.',
  },
  {
    q: 'Czy aplikacja działa bez zasięgu (góry, tunele, granice)?',
    a: 'Tak. Aplikacja mobilna BusiKM rejestruje GPS i aktywności lokalnie w trybie offline — synchronizuje się automatycznie po odzyskaniu zasięgu. Liczniki AETR (4,5h jazdy, 9h dziennego itp.) działają lokalnie na urządzeniu kierowcy — alerty INFO/WARNING/VIOLATION pojawiają się nawet bez połączenia z serwerem. Żadnej utraty danych w trasie.',
  },
  {
    q: 'Czy mogę zaimportować historyczne aktywności z tachografu?',
    a: 'Tak. BusiKM przyjmuje wsadowy import aktywności z odczytu tachografu G2V2 (plik DDD). Pozwala załadować pełne 56 dni historii każdego kierowcy — silnik wylicza wstecznie compliance, generuje raporty i wykrywa naruszenia z przeszłości. Przydatne przed audytem ITD lub przy onboardingu nowej floty do BusiKM.',
  },
  {
    q: 'Jakie są poziomy alertów i kiedy się pojawiają?',
    a: 'Trzy poziomy: INFO (przerwa wymagana za 30 min — informacyjny push), WARNING (przerwa wymagana za 15 min — wyraźny push z dźwiękiem) i VIOLATION (limit przekroczony — alarm push + powiadomienie właściciela floty). Alerty per kategoria — osobno dla dziennego czasu jazdy, ciągłej jazdy 4,5h, dziennego odpoczynku, tygodniowego. Wszystko widoczne w czasie rzeczywistym na panelu właściciela.',
  },
  {
    q: 'Co z załogą 2-osobową?',
    a: 'BusiKM obsługuje załogę 2-osobową: kierowca-pasażer może być rejestrowany jako AVAILABILITY (gotowość) — wtedy może odpoczywać w jadącym pojeździe. Odpoczynek dzienny dla załogi: min 9h każdy kierowca w ciągu 30h od zakończenia poprzedniego odpoczynku. Walidacja per kierowca, ale uwzględnia kontekst załogi z tego samego pojazdu (Trip).',
  },
];

const monthLabels = ['sty', 'lut', 'mar', 'kwi', 'maj', 'cze', 'lip', 'sie', 'wrz', 'paź', 'lis', 'gru'];
const launchDate = new Date('2026-09-30');
const launchShort = `${launchDate.getDate()} ${monthLabels[launchDate.getMonth()]} ${launchDate.getFullYear()}`;
---

<MarketingLayout
  title="Kontrola AETR i czasu pracy kierowcy — BusiKM"
  description="Ewidencja i alerty czasu pracy kierowcy w transporcie międzynarodowym UE. Rozporządzenie (WE) 561/2006 + Pakiet Mobilności. 8 typów aktywności, auto-detection z GPS, alerty INFO/WARNING/VIOLATION zanim wystąpi naruszenie. Zgodnie z 561/2006 i AETR."
>

<!-- ====================== HERO ====================== -->
<section class="relative bg-surface overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-15%] left-1/2 -translate-x-1/2 w-[900px] h-[700px] rounded-full bg-brand/[0.06] blur-[160px]"></div>
  </div>

  <div class="relative max-w-[1080px] mx-auto px-4 sm:px-6 pt-24 pb-16 sm:pt-32 sm:pb-24">
    <div class="text-center max-w-[860px] mx-auto reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand/25 bg-brand/[0.06] mb-6 hero-seq-1">
        <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
        <span class="text-[12.5px] font-semibold text-brand tracking-[0.04em] uppercase">Filar compliance · wdrażane Q3 2026</span>
      </div>

      <h1 class="hero-seq-2 font-display text-[clamp(2.2rem,5.5vw,3.8rem)] font-bold leading-[1.08] tracking-[-0.035em] text-text mb-6">
        Czas pracy kierowcy pod kontrolą.<br/>
        <span class="inline-block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-1">Zanim zatrzyma Cię ITD.</span>
      </h1>

      <p class="hero-seq-3 text-[clamp(1rem,1.9vw,1.2rem)] leading-[1.55] text-text-secondary max-w-[720px] mx-auto mb-10">
        BusiKM wdraża <strong class="text-text">DriverActivity Engine</strong> — silnik compliance zgodny z rozporządzeniem (WE) nr 561/2006 i Pakietem Mobilności UE. Auto-detection 8 typów aktywności z GPS, mapowanie na 4 symbole tachografu, alerty INFO/WARNING/VIOLATION zanim wystąpi naruszenie. Działa offline w aplikacji kierowcy, dashboard real-time u właściciela.
      </p>

      <!-- 3 metryki -->
      <div class="hero-seq-4 grid grid-cols-3 gap-3 sm:gap-6 max-w-[640px] mx-auto mb-10">
        {[
          { num: '8', label: 'typów aktywności' },
          { num: '4', label: 'symbole tachografu' },
          { num: '3', label: 'poziomy alertów' },
        ].map(s => (
          <div class="bg-surface-2 rounded-2xl py-4 sm:py-5 px-2 sm:px-3 text-center border border-border-subtle">
            <div class="font-display font-bold text-[clamp(1.6rem,4vw,2.4rem)] text-text tabular-nums leading-none tracking-tight">{s.num}</div>
            <div class="text-[10.5px] sm:text-[11.5px] text-text-tertiary mt-2 uppercase tracking-[0.06em]">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="hero-seq-5 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors shadow-[0_1px_3px_rgba(0,92,232,0.3)]">
          Wypróbuj demo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#regulacje" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-border text-text text-[15px] font-semibold hover:bg-surface-2 transition-colors">
          Zobacz pełne reguły 561/2006
        </a>
      </div>

      <p class="hero-seq-5 text-[12px] text-text-tertiary mt-6">
        Podstawa prawna: <a href="https://eur-lex.europa.eu/eli/reg/2006/561/oj" target="_blank" rel="noopener" class="text-brand hover:underline">Rozp. (WE) nr 561/2006</a> · Pakiet Mobilności (UE 1054/2020, 1055/2020) · Konwencja AETR poza UE
      </p>
    </div>
  </div>
</section>

<!-- ====================== CO MONITORUJEMY ====================== -->
<section id="co-monitorujemy" class="bg-surface-2 py-24 px-5 border-y border-border-subtle">
  <div class="max-w-[1180px] mx-auto">
    <div class="text-center mb-14 reveal max-w-[720px] mx-auto">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Sześć obszarów compliance</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15] mb-4">
        Co dokładnie pilnuje DriverActivity Engine.
      </h2>
      <p class="text-[15px] leading-relaxed text-text-secondary">
        Każdy obszar z rozporządzenia 561/2006 ma odpowiednią metodę w silniku compliance — wszystkie liczniki działają w czasie rzeczywistym, na podstawie aktywności rejestrowanych z GPS i potwierdzanych przez kierowcę w aplikacji.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
      {monitoredAreas.map(a => (
        <article class="bg-surface rounded-2xl p-6 border border-border-subtle hover:border-brand/30 transition-colors duration-300 flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background:${a.color}1a`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style={`color:${a.color}`} set:html={a.icon}></svg>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[10.5px] font-bold tracking-[0.06em] uppercase" style={`background:${a.color}1a;color:${a.color}`}>{a.label}</span>
          </div>
          <h3 class="font-display text-[18px] font-bold text-text mb-3 leading-tight">{a.title}</h3>
          <ul class="space-y-1.5 mb-4 flex-1">
            {a.limits.map(l => (
              <li class="flex items-start gap-2 text-[13px] text-text-secondary leading-[1.5]">
                <span class="text-brand mt-1 shrink-0">●</span><span>{l}</span>
              </li>
            ))}
          </ul>
          <div class="pt-3 border-t border-border-subtle">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Co robi silnik</p>
            <p class="text-[12px] text-text-secondary leading-[1.55]">{a.engine}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ====================== REGULACJE — PEŁNA TABELA ====================== -->
<section id="regulacje" class="bg-surface py-24 px-5">
  <div class="max-w-[1080px] mx-auto">
    <div class="text-center mb-14 reveal max-w-[760px] mx-auto">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Rozporządzenie (WE) nr 561/2006</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15] mb-4">
        Pełna mapa reguł, które egzekwujemy.
      </h2>
      <p class="text-[15px] leading-relaxed text-text-secondary">
        Rozporządzenie 561/2006 obowiązuje w całej UE dla pojazdów &gt;3,5 t (a od 2 lipca 2026 — także busy 2,5–3,5 t w transporcie międzynarodowym). Poza UE stosuje się Umowę AETR (zbliżone reguły, różnice w szczegółach). Poniżej pełen zakres — wszystko, co BusiKM pilnuje w czasie rzeczywistym.
      </p>
    </div>

    <!-- Tabela 1: Czas jazdy -->
    <div class="mb-10 reveal">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-display text-[14px] font-bold text-text-tertiary tabular-nums">01</span>
        <h3 class="font-display text-[20px] font-bold text-text">Czas jazdy</h3>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-border-subtle">
        <table class="w-full text-left">
          <thead class="bg-surface-2">
            <tr>
              <th class="px-5 py-3 text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary">Kategoria</th>
              <th class="px-5 py-3 text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary">Limit</th>
              <th class="px-5 py-3 text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary">Uwagi</th>
            </tr>
          </thead>
          <tbody>
            {drivingTimeRows.map((r, i) => (
              <tr class={i % 2 === 0 ? 'bg-surface' : 'bg-surface-2/50'}>
                <td class="px-5 py-3.5 text-[13.5px] font-semibold text-text">{r.cat}</td>
                <td class="px-5 py-3.5 text-[13.5px] text-brand font-mono">{r.limit}</td>
                <td class="px-5 py-3.5 text-[13.5px] text-text-secondary">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tabela 2: Przerwy -->
    <div class="mb-10 reveal">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-display text-[14px] font-bold text-text-tertiary tabular-nums">02</span>
        <h3 class="font-display text-[20px] font-bold text-text">Przerwy w jeździe</h3>
      </div>
      <p class="text-[14px] text-text-secondary mb-4 max-w-[760px]">
        Przerwa jest obowiązkowa gdy kierowca prowadzi pojazd przez 4,5 godziny bez przerwy. Musi trwać co najmniej 45 minut i może być podzielona na dwie części, z których pierwsza musi trwać co najmniej 15 minut.
      </p>
      <div class="overflow-x-auto rounded-2xl border border-border-subtle">
        <table class="w-full text-left">
          <thead class="bg-surface-2">
            <tr>
              <th class="px-5 py-3 text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary">Sytuacja</th>
              <th class="px-5 py-3 text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary">Zasada</th>
            </tr>
          </thead>
          <tbody>
            {breaksRows.map((r, i) => (
              <tr class={i % 2 === 0 ? 'bg-surface' : 'bg-surface-2/50'}>
