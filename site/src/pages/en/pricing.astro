---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../../lib/app-url';

/**
 * /en/pricing — condensed EN pricing. BKM-552.
 * Full plan tabela lives w /cennik (PL).
 */
---

<MarketingLayout
  title="Pricing — BusiKM"
  description="The pilot program is free for life for first pilot companies and accounting firms. Commercial pricing announced after pilot ends. Lifetime-free in exchange for feedback."
>
  <section class="px-5 sm:px-8 max-w-[1120px] mx-auto pt-24 pb-12">
    <div class="text-center mb-12">
      <p class="text-[11.5px] font-semibold tracking-[0.08em] uppercase text-brand mb-3">Pricing</p>
      <h1 class="font-display font-bold text-[44px] sm:text-[60px] tracking-[-0.02em] leading-[1.05] text-text mb-5">
        Free lifetime in pilot mode
      </h1>
      <p class="text-[18px] text-text-secondary max-w-[680px] mx-auto">
        First pilot transport companies and accounting firms join <strong class="text-text">lifetime-free</strong> in exchange for product feedback.
        Commercial pricing will be announced after the pilot ends (August 22, 2026+).
      </p>
    </div>
  </section>

  <section class="px-5 sm:px-8 max-w-[1120px] mx-auto pb-12 reveal-stagger">
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Transport company -->
      <article class="p-8 rounded-3xl bg-surface-2 border border-border-subtle">
        <div class="flex items-baseline gap-3 mb-2">
          <h2 class="font-display font-bold text-[22px] tracking-[-0.01em] text-text">Transport company</h2>
          <span class="text-[11px] font-semibold tracking-[0.06em] uppercase text-success bg-success/10 px-2 py-0.5 rounded-full">Pilot</span>
        </div>
        <p class="text-[14px] text-text-secondary mb-6">For owners operating vans 2.5–3.5 t in international transport.</p>

        <div class="mb-6 pb-6 border-b border-border-subtle">
          <span class="font-display font-bold text-[44px] text-text">€0</span>
          <span class="text-text-tertiary text-[15px] ml-1">/ lifetime</span>
        </div>

        <ul class="space-y-3 text-[14px] text-text-secondary mb-8">
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Unlimited drivers and vehicles</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Full mobile + web app</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>FK export (Insert GT, Comarch, Symfonia)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>ITD compliance dashboard &amp; G2V2 alerts</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Direct line to product team for feedback</span>
          </li>
        </ul>

        <a
          href={APP_LOGIN_URL}
          class="block text-center w-full py-3 rounded-2xl bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors"
        >
          Join pilot
        </a>
      </article>

      <!-- Accounting firm -->
      <article class="p-8 rounded-3xl bg-surface-2 border border-border-subtle">
        <div class="flex items-baseline gap-3 mb-2">
          <h2 class="font-display font-bold text-[22px] tracking-[-0.01em] text-text">Accounting firm</h2>
          <span class="text-[11px] font-semibold tracking-[0.06em] uppercase text-warning bg-warning/10 px-2 py-0.5 rounded-full">3 mo. free</span>
        </div>
        <p class="text-[14px] text-text-secondary mb-6">For firms serving multiple transport-company clients.</p>

        <div class="mb-6 pb-6 border-b border-border-subtle">
          <span class="font-display font-bold text-[44px] text-text">€0</span>
          <span class="text-text-tertiary text-[15px] ml-1">/ first 3 months</span>
        </div>

        <ul class="space-y-3 text-[14px] text-text-secondary mb-8">
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Unlimited client transport companies</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Multi-tenant panel with strict data isolation (GDPR art. 28)</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Audit log per export</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>All Transport Company features included</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
              <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Commercial pricing post-pilot (announced later)</span>
          </li>
        </ul>

        <a
          href={APP_LOGIN_URL}
          class="block text-center w-full py-3 rounded-2xl bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors"
        >
          Join pilot
        </a>
      </article>
    </div>
  </section>

  <!-- Polish details link -->
  <section class="px-5 sm:px-8 max-w-[820px] mx-auto py-12 text-center reveal">
    <p class="text-text-secondary mb-5">
      A detailed pricing tier breakdown (per role, post-pilot commercial plans) is currently maintained in Polish.
    </p>
    <a href="/cennik" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-surface text-text border border-border text-[14px] font-semibold hover:bg-surface-2 transition-colors">
      View detailed pricing (PL) →
    </a>
  </section>
</MarketingLayout>
