---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../../lib/app-url';
---

<MarketingLayout
  title="For in-house accountants — BusiKM"
  description="EU cost capture from drivers with OCR in 6 languages, auto NBP forex, structured per-diem (PL MoLPS regulation), one-click export to Insert GT, Comarch ERP Optima, Symfonia FK. Built for in-house accountants at transport companies."
>

<!-- ============ HERO ============ -->
<section class="relative overflow-hidden bg-surface px-5 py-24 sm:py-32">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-5%] left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full bg-[#34C759]/[0.06] blur-[120px]"></div>
  </div>
  <div class="relative max-w-[1120px] mx-auto">
    <div class="max-w-[760px]">
      <div class="hero-seq-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#34C759]/15 bg-[#34C759]/[0.04] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#34C759] animate-pulse"></span>
        <span class="text-[12.5px] font-semibold uppercase tracking-[0.06em] text-[#34C759]">For in-house accountants · transport 2.5–3.5 t</span>
      </div>

      <h1 class="hero-seq-2 font-display text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.12] tracking-[-0.035em] text-text mb-6">
        Costs from across the EU<br/>arrive ready to post —<br/>not in a shoebox.
      </h1>

      <p class="hero-seq-3 text-[clamp(1rem,2vw,1.2rem)] leading-relaxed text-text-secondary max-w-[660px] mb-9">
        Drivers OCR receipts from DE/IT/FR/ES/AT/NL on their phone. Every invoice has the original currency, NBP rate, PLN amount, vehicle, route, status (to approve / posted / VAT-REF) — categorised and JPK-V7-ready by the time it reaches your screen.
      </p>

      <div class="hero-seq-4 flex flex-wrap gap-3 mb-12">
        <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors shadow-[0_1px_3px_rgba(0,92,232,0.4)]">
          Try the demo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/en/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-border bg-surface-2 text-text text-[15px] font-semibold hover:bg-surface transition-colors">
          Pricing (free for pilots)
        </a>
      </div>

      <div class="hero-seq-5 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-7 text-center sm:text-left">
        {[
          { num: 'NBP', label: 'auto-conversion to PLN' },
          { num: 'JPK_V7', label: 'GTU + VIES validation' },
          { num: 'VAT-REF', label: 'per-country packages' },
          { num: '3 FK', label: 'Insert · Comarch · Symfonia' },
        ].map(s => (
          <div class="flex flex-col items-center sm:items-start">
            <div class="font-display text-[1.5rem] font-bold tracking-[-0.03em] text-text leading-none">{s.num}</div>
            <div class="text-[12.5px] text-text-tertiary mt-2 max-w-[160px] leading-snug min-h-[2.4rem] flex items-start">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ INVOICE LIST MOCKUP ============ -->
<section class="py-20 sm:py-28 bg-surface-2 px-5 border-t border-border-subtle">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal text-center mb-12 max-w-[680px] mx-auto">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#FF9500] mb-4">Foreign cost capture</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15]">
        Every invoice ready for the books — currency, rate, PLN, status.
      </h2>
      <p class="text-[15px] leading-relaxed text-text-secondary mt-4">
        Filter by category, country, vehicle, status. Export to FK with one click. No manual rekeying.
      </p>
    </div>

    <div class="reveal rounded-[20px] bg-[#F8F7F2] dark:bg-[#16161A] border border-border-subtle overflow-hidden shadow-[0_8px_48px_rgba(0,0,0,0.10)] dark:shadow-[0_8px_48px_rgba(0,0,0,0.30)]">
      <div class="flex items-center gap-2 px-5 py-3 bg-[#EBEBED] dark:bg-[#0F0F12] border-b border-border-subtle">
        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
        <div class="ml-4 flex-1 max-w-[340px] rounded-md bg-surface/70 px-3 py-1 text-[11px] text-text-tertiary font-mono">app.busikm.pl/accounting/eu-costs</div>
      </div>

      <div class="p-5 sm:p-7">
        <div class="flex flex-wrap gap-2 mb-5">
          {[
            { label: 'All', count: 47, active: true },
            { label: 'Fuel', count: 18 },
            { label: 'Tolls', count: 12 },
            { label: 'Hotels', count: 6 },
            { label: 'Service', count: 3 },
            { label: 'To VAT-REF', count: 24 },
            { label: 'May 2026', count: 47 },
          ].map(f => (
            <span class:list={['px-3 py-1.5 rounded-xl text-[11.5px] font-semibold transition-colors',
              f.active ? 'bg-text text-surface dark:bg-white dark:text-[#0A0A0B]' : 'bg-surface text-text-secondary hover:bg-[#FF9500]/10']}>{f.label} <span class="opacity-60">({f.count})</span></span>
          ))}
        </div>

        <div class="bg-surface rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="hidden sm:grid grid-cols-12 gap-3 px-4 py-3 bg-[#FAFAFA] dark:bg-[#1F1F22] border-b border-border-subtle text-[10px] uppercase tracking-[0.06em] text-text-tertiary font-semibold">
            <div class="col-span-3">Invoice · Vendor</div>
            <div class="col-span-2">Category · Vehicle</div>
            <div class="col-span-2">Original amount</div>
            <div class="col-span-1">NBP rate</div>
            <div class="col-span-2">PLN amount</div>
            <div class="col-span-2">Status</div>
          </div>

          <div class="divide-y divide-black/[0.04] dark:divide-white/[0.06]">
            {[
              { num: 'RE-2026-0473', vendor: 'Aral Tankstelle Hamburg', date: '12.05.2026', cat: 'Fuel · Sprinter DK 12345', orig: '€147.32', rate: '4.2731', pln: '629.57 zł', status: 'To VAT-REF', statusColor: '#34C759', flag: 'DE' },
              { num: 'FT-987654', vendor: 'Telepass S.p.A.', date: '14.05.2026', cat: 'Toll · Crafter KR 67890', orig: '€38.40', rate: '4.2698', pln: '163.96 zł', status: 'Posted', statusColor: '#005CE8', flag: 'IT' },
              { num: 'F-2026/0892', vendor: 'Ibis Lyon Part-Dieu', date: '15.05.2026', cat: 'Hotel · Daily WA 11223', orig: '€78.00', rate: '4.2710', pln: '333.14 zł', status: 'To approve', statusColor: '#FF9500', flag: 'FR' },
              { num: 'FA-892371', vendor: 'OMV Tankstelle Wien', date: '16.05.2026', cat: 'Fuel · Sprinter DK 12345', orig: '€128.90', rate: '4.2754', pln: '551.11 zł', status: 'To VAT-REF', statusColor: '#34C759', flag: 'AT' },
              { num: 'F-2026-1102', vendor: 'Garage Hendriks Apeldoorn', date: '17.05.2026', cat: 'Service · Transit GD 33445', orig: '€420.50', rate: '4.2720', pln: '1 796.17 zł', status: 'To approve', statusColor: '#FF9500', flag: 'NL' },
              { num: 'FT-2026/1471', vendor: 'Eni Carburanti', date: '17.05.2026', cat: 'Fuel · Crafter KR 67890', orig: '€163.80', rate: '4.2720', pln: '699.75 zł', status: 'To VAT-REF', statusColor: '#34C759', flag: 'IT' },
            ].map(r => (
              <div class="px-4 py-3 hover:bg-[#FAFAFA] dark:bg-[#1F1F22] transition-colors">
                <div class="sm:hidden space-y-1.5">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <span class="font-mono text-[10px] text-text-tertiary">{r.num}</span>
                        <span class="text-[9px] font-mono font-semibold text-text-tertiary bg-surface-2 px-1.5 py-0.5 rounded">{r.flag}</span>
                      </div>
                      <p class="text-[13px] font-semibold text-text leading-tight">{r.vendor}</p>
                    </div>
                    <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold whitespace-nowrap shrink-0" style={`background: ${r.statusColor}15; color: ${r.statusColor}`}>{r.status}</span>
                  </div>
                  <p class="text-[11px] text-text-tertiary leading-snug">{r.cat} · {r.date}</p>
                  <div class="flex items-baseline gap-1.5 text-[12px] font-mono pt-1.5 border-t border-border-subtle">
                    <span class="text-text-tertiary">{r.orig}</span>
                    <span class="text-text-tertiary text-[10px]">×</span>
                    <span class="text-text-tertiary">{r.rate}</span>
                    <span class="text-text-tertiary text-[10px]">=</span>
                    <span class="font-bold text-text ml-auto">{r.pln}</span>
                  </div>
                </div>

                <div class="hidden sm:grid grid-cols-12 gap-3 items-center text-[11.5px]">
                  <div class="col-span-3 min-w-0">
                    <p class="font-mono text-[10.5px] text-text-tertiary">{r.num}</p>
                    <p class="font-medium text-text truncate">{r.vendor}</p>
                    <p class="text-[10px] text-text-tertiary">{r.date}</p>
                  </div>
                  <div class="col-span-2 min-w-0">
                    <p class="text-text truncate">{r.cat}</p>
                  </div>
                  <div class="col-span-2 font-mono">
                    <span class="inline-block w-6 text-[9px] text-text-tertiary mr-1">{r.flag}</span>
                    <span class="font-semibold text-text">{r.orig}</span>
                  </div>
                  <div class="col-span-1 font-mono text-text-tertiary">{r.rate}</div>
                  <div class="col-span-2 font-mono font-semibold text-text">{r.pln}</div>
                  <div class="col-span-2">
                    <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold" style={`background: ${r.statusColor}15; color: ${r.statusColor}`}>{r.status}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="px-4 py-3 bg-[#FAFAFA] dark:bg-[#1F1F22] border-t border-border-subtle flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 text-[11px]">
            <span class="text-text-tertiary">Showing 6 of 47 documents · May 2026</span>
            <span class="text-text font-semibold">Total: 19 829.32 zł · VAT-REF eligible: 11 280.40 zł</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 6 PILLARS ============ -->
<section class="py-20 sm:py-28 bg-surface px-5 border-t border-border-subtle">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal max-w-[680px] mx-auto text-center mb-14">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#34C759] mb-4">What you get as in-house accountant</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15]">
        Six things that compress month-end from a week to a day.
      </h2>
    </div>

    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {[
        { title: 'OCR + auto-categorisation', desc: 'Fuel, tolls, hotels, service, parking — categorised by the driver at the point of capture. You only confirm.', color: '#FF9500' },
        { title: 'NBP auto-conversion', desc: 'Every invoice in EUR, CHF, GBP, RON, DKK, CZK is automatically converted at the NBP rate of the invoice date.', color: '#005CE8' },
        { title: 'JPK_V7 ready', desc: 'GTU markings, VIES-validated EU VAT IDs, plan-of-accounts categories — JPK file generates without corrections.', color: '#34C759' },
        { title: 'VAT-REF package per country', desc: 'BusiKM aggregates VAT-recoverable invoices from DE, FR, IT, NL, AT, BE, ES (Directive 2008/9/EC). Submit by 30 September of the following year.', color: '#8B5CF6' },
        { title: 'Per-diem auto-split', desc: 'Foreign per-diems (PL MoLPS regulation Dz.U. 2013 item 167) calculated automatically from GPS border crossings — per country, per day, per driver.', color: '#3380FF' },
        { title: 'One-click FK export', desc: 'EPP (Insert GT), XML (Comarch ERP Optima), TXT (Symfonia FK / AMS template). Native format of every system. Zero manual rekeying.', color: '#FF3B30' },
      ].map(f => (
        <article class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle">
          <div class="w-10 h-10 rounded-[12px] mb-4 flex items-center justify-center" style={`background: ${f.color}15`}>
            <span class="w-3 h-3 rounded-full" style={`background: ${f.color}`}></span>
          </div>
          <h3 class="font-display font-bold text-[1.05rem] text-text mb-2">{f.title}</h3>
          <p class="text-[13.5px] text-text-secondary leading-relaxed">{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="py-20 sm:py-28 bg-[#0A0A0B] px-5 overflow-hidden relative">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] rounded-full bg-[#34C759]/15 blur-[150px]"></div>
  </div>
  <div class="relative reveal text-center max-w-[680px] mx-auto">
    <h2 class="font-display text-[clamp(1.8rem,5vw,2.8rem)] font-bold tracking-[-0.03em] text-white leading-[1.18] mb-5">
      Month-end without a paper avalanche.
    </h2>
    <p class="text-[15px] text-white/60 mb-10 leading-relaxed">
      BusiKM is built specifically for the realities of international road transport in PL/EU. JPK_V7, VAT-REF, FK exports — all in one tool.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-[#0A0A0B] text-[15px] font-semibold hover:bg-[#F5F5F7] transition-colors">
        Try the demo
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/en/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-white/15 text-white text-[15px] font-semibold hover:border-white/30 hover:bg-white/10 transition-all">
        Pricing (free for pilots)
      </a>
    </div>
  </div>
</section>

</MarketingLayout>
