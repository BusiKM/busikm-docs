---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../../lib/app-url';

/**
 * /en/features — condensed EN feature listing. BKM-552.
 * Full feature matrix lives w /funkcje (PL). Tu jest "minimum viable EN".
 */

const featureGroups = [
  {
    title: 'Driver mobile app',
    desc: 'iOS 15+ / Android 10+ · works offline',
    features: [
      'Background GPS tracking (battery-optimized)',
      'OCR for receipts in 6 languages (PL/EN/DE/IT/FR/ES) — 7 document types',
      'AETR working-time alerts (4.5h / 9h / 11h / day / week / two weeks)',
      'EU Mobility Package — 45h rest breaks, weekly returns',
      'Driver documents (license, code 95, ADR)',
      'Tachograph card monitoring',
      'Offline-first sync with conflict resolution',
    ],
  },
  {
    title: 'Owner web panel',
    desc: 'Real-time fleet operations',
    features: [
      'Live fleet map (WebSocket + GPS broadcast)',
      'Fleet dashboard (trips, costs, compliance status)',
      'Per-trip margin and cost analytics',
      'Document expiry alerts (90/30/14/7 days)',
      'OC / AC / inspection / tachograph calibration tracking',
      'PDF mileage reports per vehicle / month (PL art. 86a compliant)',
    ],
  },
  {
    title: 'ITD &amp; tachograph compliance',
    desc: 'G2V2 ready · deadline 1 July 2026',
    features: [
      'G2V2 tachograph calibration alerts per vehicle',
      'Driver working-time records (AETR + EU 561/2006)',
      '56-day audit report for ITD inspection — one click',
      'AETR violation log with timestamps and locations',
      'Mobility Package compliance dashboard',
    ],
  },
  {
    title: 'Accounting integration',
    desc: 'FK export · zero manual entry',
    features: [
      'EPP export to Insert GT (Windows-1250)',
      'XML export to Comarch ERP Optima',
      'TXT export to Symfonia FK (AMS template)',
      'Automatic NBP currency conversion for foreign costs',
      'VAT validation (PL: 23%, 8%, 5%, 0%, exempt)',
      'Cost invoice handling per art. 86a (mileage deduction)',
    ],
  },
  {
    title: 'Multi-tenant for accounting firms',
    desc: 'Serve N transport-company clients',
    features: [
      'Strict data isolation per client company (GDPR art. 28)',
      'Context switching via X-Company-Context header',
      'Full audit log per export and configuration change',
      'Aggregate billing across clients (metered)',
      'Pilot: 3 months free for new accounting firms',
    ],
  },
];
---

<MarketingLayout
  title="Features — BusiKM"
  description="Six core feature pillars: driver mobile app, owner web panel, ITD compliance, accounting integration, multi-tenant for accounting firms. Launch delivers 32+ features in pilot mode."
>
  <section class="px-5 sm:px-8 max-w-[1120px] mx-auto pt-24 pb-12">
    <div class="text-center mb-12">
      <p class="text-[11.5px] font-semibold tracking-[0.08em] uppercase text-brand mb-3">Features</p>
      <h1 class="font-display font-bold text-[44px] sm:text-[60px] tracking-[-0.02em] leading-[1.05] text-text mb-5">
        What BusiKM does
      </h1>
      <p class="text-[18px] text-text-secondary max-w-[680px] mx-auto">
        Five feature pillars across mobile app, owner panel, compliance, accounting and multi-tenant.
        All features live since the MVP launch on <strong class="text-text">19 June 2026</strong> — pilot program runs until August 22, 2026.
      </p>
    </div>
  </section>

  <section class="px-5 sm:px-8 max-w-[1120px] mx-auto pb-20 reveal-stagger">
    <div class="grid lg:grid-cols-2 gap-6">
      {featureGroups.map(group => (
        <article class="p-7 rounded-2xl bg-surface-2 border border-border-subtle">
          <header class="mb-4">
            <h2 class="font-display font-bold text-[20px] tracking-[-0.01em] text-text mb-1" set:html={group.title}></h2>
            <p class="text-[12.5px] text-text-tertiary">{group.desc}</p>
          </header>
          <ul class="space-y-2.5">
            {group.features.map(feature => (
              <li class="flex items-start gap-2.5 text-[14px] text-text-secondary">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 mt-0.5 text-brand">
                  <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Polish details link -->
  <section class="px-5 sm:px-8 max-w-[820px] mx-auto py-12 text-center reveal">
    <p class="text-text-secondary mb-5">
      A fully detailed feature matrix (32+ features, launch scope vs later waves, role-by-role breakdown) is currently maintained in Polish.
    </p>
    <a href="/funkcje" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-surface text-text border border-border text-[14px] font-semibold hover:bg-surface-2 transition-colors">
      View full feature matrix (PL) →
    </a>
  </section>

  <!-- CTA -->
  <section class="px-5 sm:px-8 max-w-[820px] mx-auto py-20 text-center reveal">
    <h2 class="font-display font-bold text-[32px] sm:text-[40px] tracking-[-0.02em] text-text mb-4">
      Join the pilot program
    </h2>
    <p class="text-text-secondary mb-8">
      Free lifetime access for first pilot companies in exchange for feedback.
    </p>
    <a
      href={APP_LOGIN_URL}
      class="inline-flex items-center justify-center gap-1.5 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200"
    >
      Log in
    </a>
  </section>
</MarketingLayout>
