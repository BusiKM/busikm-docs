---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../../lib/app-url';

/**
 * EN home — short narrative for the international visitor.
 */
---

<MarketingLayout
  title="BusiKM — System for transport 2.5–3.5 t and accounting firms"
  description="System for international transport companies operating vans 2.5–3.5 t and their accounting firms. Real-time GPS, AETR working time, G2V2 tachograph, foreign per-diem, FK export. Product launch 19 June 2026."
>
  <!-- HERO (placeholder — full rebrand w T3 / BKM-549) -->
  <section class="relative pt-24 pb-20 px-5 sm:px-8 max-w-[1120px] mx-auto">
    <div class="text-center max-w-[820px] mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand/8 border border-brand-border text-[11.5px] font-semibold tracking-[0.06em] uppercase text-brand mb-6 hero-seq-1">
        <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
        Transport 2.5–3.5 t × accounting
      </div>

      <h1 class="font-display font-bold tracking-[-0.02em] leading-[1.15] text-[44px] sm:text-[60px] lg:text-[72px] text-text mb-6 hero-seq-2">
        <span class="block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-2">
          One platform unifying
        </span>
        <span class="block">transport and accounting</span>
      </h1>

      <p class="text-[18px] sm:text-[20px] leading-[1.5] text-text-secondary max-w-[680px] mx-auto mb-3 hero-seq-3">
        For international road transport companies operating vans 2.5–3.5 t across the EU and their accounting firms. Real-time GPS, AETR working time, G2V2 tachograph, foreign per-diem, one-click export to three accounting systems.
      </p>

      <p class="text-[13px] text-text-tertiary mb-10 hero-seq-3">
        Product launch 19 June 2026 · pilot lifetime-free · 100% GDPR
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center hero-seq-4">
        <a
          href={APP_LOGIN_URL}
          class="inline-flex items-center justify-center gap-1.5 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200 shadow-[0_1px_3px_rgba(0,92,232,0.3)] hover:shadow-[0_6px_28px_rgba(0,92,232,0.5)]"
        >
          Try demo
        </a>
        <a
          href="/en/technology"
          class="inline-flex items-center justify-center gap-1.5 px-7 py-3.5 rounded-full bg-surface text-text border border-border text-[15px] font-semibold tracking-[-0.01em] hover:bg-surface-2 transition-colors duration-200"
        >
          Explore technology →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ PROBLEM AT EUROPEAN LEVEL (BKM-551 EN counterpart) ============ -->
  <section id="problem-eu" class="bg-surface py-24 sm:py-32 px-5 border-t border-border-subtle">
    <div class="max-w-[1100px] mx-auto">
      <div class="text-center mb-14 reveal">
        <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/8 text-brand text-[11px] font-semibold tracking-[0.08em] uppercase mb-5">
          <span class="w-1 h-1 rounded-full bg-brand"></span>
          Problem at European level
        </p>
        <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-bold tracking-[-0.025em] leading-[1.1] text-text mb-5 max-w-[900px] mx-auto">
          6.1M vans 2.5–3.5&nbsp;t in Europe.<br/>
          <span class="text-text-secondary">Zero dedicated compliance tools.</span>
        </h2>
        <p class="text-[16px] sm:text-[17px] leading-[1.7] text-text-secondary max-w-[760px] mx-auto">
          Road transport with vans 2.5–3.5&nbsp;t represents ~90% of the EU TSL market — approx. 6.1M vehicles (Eurostat 2024).
          From 1 July 2026 all of these vehicles fall under the same regulations as 40-ton trucks: G2V2 tachograph, AETR, Mobility Package, eFTI.
          The market has no tools — existing compliance solutions are designed for large TSL fleets,
          and a small transport company (2–5 vehicles) won't pay €500/month per vehicle for enterprise SaaS.
        </p>
      </div>

      <div class="mb-12">
        <p class="text-center text-[12px] font-semibold uppercase tracking-[0.1em] text-text-tertiary mb-6">Four EU regulations, one tooling gap</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal-stagger">
          <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-brand mb-2">EU 2016/799</p>
            <h3 class="font-display font-semibold text-[15px] text-text mb-2">G2V2 tachograph</h3>
            <p class="text-[13px] leading-[1.55] text-text-secondary">Mandatory for vehicles &gt;2.5&nbsp;t from 1 July 2026. Introduces remote ITS communication, digital signatures, 2nd-gen driver card.</p>
          </article>
          <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-warning mb-2">AETR · UNECE</p>
            <h3 class="font-display font-semibold text-[15px] text-text mb-2">Driver working time</h3>
            <p class="text-[13px] leading-[1.55] text-text-secondary">International standard: 4.5h driving / 45min break, 9h daily, 56h weekly, 90h fortnightly.</p>
          </article>
          <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-success mb-2">EU 1054/1055/1057</p>
            <h3 class="font-display font-semibold text-[15px] text-text mb-2">Mobility Package</h3>
            <p class="text-[13px] leading-[1.55] text-text-secondary">Weekly driver returns, foreign per-diem, posting rules, no 45h rest in cab.</p>
          </article>
          <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
            <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-[#8B5CF6] mb-2">EU 2020/1056</p>
            <h3 class="font-display font-semibold text-[15px] text-text mb-2">eFTI</h3>
            <p class="text-[13px] leading-[1.55] text-text-secondary">Electronic Freight Transport Information — mandatory for member states from 2027.</p>
          </article>
        </div>
      </div>

      <div class="rounded-3xl bg-surface-2 border border-border-subtle p-8 sm:p-10 reveal">
        <p class="text-center text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-2">Why it's a problem</p>
        <h3 class="text-center font-display text-[22px] sm:text-[26px] font-bold tracking-[-0.015em] text-text mb-10 max-w-[680px] mx-auto">
          Tool fragmentation · language barriers · legal complexity
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="font-display text-[26px] font-bold text-brand leading-none">01</span>
              <h4 class="font-semibold text-[15px] text-text">Tool fragmentation</h4>
            </div>
            <p class="text-[13.5px] leading-[1.7] text-text-secondary">No SaaS dedicated to vans 2.5–3.5&nbsp;t in any EU market. Tachograph-tools exist for trucks; no integrated tool combining cost tracking + per-diem + accounting.</p>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="font-display text-[26px] font-bold text-brand leading-none">02</span>
              <h4 class="font-semibold text-[15px] text-text">Language barrier</h4>
            </div>
            <p class="text-[13.5px] leading-[1.7] text-text-secondary">Van drivers are often Poles, Ukrainians, Romanians operating in DE/FR/IT/ES. Receipts arrive in six languages — no OCR tools with multi-language fallback and EUR.</p>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="font-display text-[26px] font-bold text-brand leading-none">03</span>
              <h4 class="font-semibold text-[15px] text-text">Legal complexity</h4>
            </div>
            <p class="text-[13.5px] leading-[1.7] text-text-secondary">A single Warsaw → Madrid route crosses 6 EU borders. Each country has its own VAT regime, per-diem rules, e-invoicing standard (KSeF · Peppol · FacturaE · SDI…).</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick navigation links to PL detail pages where EN isn't ready -->
  <section class="px-5 sm:px-8 max-w-[1120px] mx-auto py-12 reveal">
    <div class="text-center mb-10">
      <p class="text-[11.5px] font-semibold tracking-[0.08em] uppercase text-brand mb-3">More information</p>
      <h2 class="font-display font-bold text-[28px] sm:text-[36px] tracking-[-0.02em] text-text mb-3">
        Explore the platform
      </h2>
      <p class="text-text-secondary max-w-[560px] mx-auto">
        Detailed feature lists, pricing for the pilot program, and roadmap are available in English on the dedicated pages below.
      </p>
    </div>
    <div class="grid sm:grid-cols-3 gap-4 reveal-stagger">
      <a href="/en/features" class="group block p-6 rounded-2xl bg-surface-2 border border-border-subtle hover:border-brand-border transition-colors">
        <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-brand mb-2">Features</p>
        <h3 class="text-[17px] font-semibold text-text mb-1.5">What is included from launch</h3>
        <p class="text-[13px] text-text-secondary">GPS, AETR alerts, OCR, FK export, multi-tenant.</p>
      </a>
      <a href="/en/pricing" class="group block p-6 rounded-2xl bg-surface-2 border border-border-subtle hover:border-brand-border transition-colors">
        <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-brand mb-2">Pricing</p>
        <h3 class="text-[17px] font-semibold text-text mb-1.5">Pilot program — free</h3>
        <p class="text-[13px] text-text-secondary">First pilot companies join lifetime-free in exchange for feedback.</p>
      </a>
      <a href="/en/technology" class="group block p-6 rounded-2xl bg-surface-2 border border-border-subtle hover:border-brand-border transition-colors">
        <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-brand mb-2">Technology</p>
        <h3 class="text-[17px] font-semibold text-text mb-1.5">Stack and compliance standards</h3>
        <p class="text-[13px] text-text-secondary">Technology stack and R&D programme funded by EU grants.</p>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-5 sm:px-8 max-w-[820px] mx-auto py-20 text-center reveal">
    <h2 class="font-display font-bold text-[32px] sm:text-[44px] tracking-[-0.02em] text-text mb-4">
      Ready to join the pilot?
    </h2>
    <p class="text-text-secondary mb-8">
      Transport companies and accounting firms working with international vans 2.5–3.5 t are welcome to apply.
    </p>
    <a
      href={APP_LOGIN_URL}
      class="inline-flex items-center justify-center gap-1.5 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200"
    >
      Try demo
    </a>
  </section>
</MarketingLayout>
