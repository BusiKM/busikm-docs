---
import MarketingLayout from '../../layouts/MarketingLayout.astro';

/**
 * /en/technology — public technology page for investors, partners, evaluators.
 * Shows stack, compliance standards and a general statement about R&D work.
 * Detailed R&D project descriptions are protected as trade secrets and not published here.
 */

const stackGroups = [
  {
    label: 'Backend',
    color: '#005CE8',
    items: [
      { name: 'Django 5 + DRF',  desc: 'Platform API, authorization, fleet data model, accounting integrations.' },
      { name: 'Celery + Redis',  desc: 'Background tasks: activity auto-detection, push notifications, FK exports.' },
      { name: 'Daphne (ASGI)',   desc: 'Real-time WebSocket — live fleet map and instant alerts.' },
      { name: 'OpenAPI 3.1',     desc: 'Schema-first API design — TypeScript client generated automatically.' },
    ],
  },
  {
    label: 'Frontend',
    color: '#34C759',
    items: [
      { name: 'Next.js 16 + Tailwind 4',     desc: 'Web panel for the owner and accounting firm.' },
      { name: 'React Native + Expo SDK 52',  desc: 'Mobile application for drivers and owners — iOS and Android.' },
      { name: 'SWR + Zustand',               desc: 'Cache and app state — instant refresh, offline mode.' },
      { name: 'Mapbox + Recharts',           desc: 'Fleet map, geofencing, profitability and cost charts.' },
    ],
  },
  {
    label: 'Databases',
    color: '#FF9500',
    items: [
      { name: 'PostgreSQL 16',  desc: 'Primary relational database — fleet, drivers, orders, settlements.' },
      { name: 'MongoDB 7',      desc: 'GPS telemetry, trip history, activity journal.' },
      { name: 'Redis 7',        desc: 'Cache, task queue, sessions, pub/sub for WebSocket.' },
    ],
  },
  {
    label: 'Infrastructure',
    color: '#8B5CF6',
    items: [
      { name: 'GitHub Actions', desc: 'CI/CD, automated tests, regression run on every change.' },
      { name: 'EAS Build',      desc: 'Mobile app builds, App Store and Google Play distribution.' },
      { name: 'Vercel',         desc: 'Marketing site and web panel hosting, edge cache.' },
      { name: 'Monitoring',     desc: 'Sentry, Prometheus, 24/7 system health dashboard.' },
    ],
  },
];

const compliance = [
  { code: 'GDPR',             name: 'Regulation (EU) 2016/679', desc: 'Full GDPR compliance — data minimization, right to be forgotten, portable export of personal data.' },
  { code: 'ISO/IEC 27001',    name: 'Security standard',         desc: 'Information security management framework — preparation for certification audit in 2027.' },
  { code: 'EU AI Act',        name: 'Regulation (EU) 2024/1689', desc: 'Compliance with transparency and human-in-the-loop requirements for machine learning components.' },
  { code: 'eIDAS',            name: 'Regulation (EU) 910/2014',  desc: 'Electronic identification and trust services — context for KSeF and Polish e-signature integration.' },
  { code: 'eFTI',             name: 'Regulation (EU) 2020/1056', desc: 'Schema compatibility for transport data — preparation for scale-out beyond Poland.' },
  { code: 'Reg. 561/2006',    name: 'Driver working time',       desc: 'Full compliance of working-time calculations with AETR + Mobility Package 2020. PDF reports for ITD and BAG inspections.' },
];
---

<MarketingLayout
  title="Technology — BusiKM stack and R&D"
  description="BusiKM technology stack (Django, React Native, PostgreSQL, MongoDB, Redis) and information about ongoing R&D work funded by EU grants."
>

<!-- HERO -->
<section class="relative bg-surface py-24 sm:py-32 px-5 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[600px] rounded-full bg-brand/[0.05] blur-[160px]"></div>
  </div>
  <div class="relative max-w-[960px] mx-auto text-center">
    <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/8 text-brand text-[11px] font-bold uppercase tracking-[0.1em] mb-6">
      <span class="w-1 h-1 rounded-full bg-brand"></span>
      Technology
    </p>
    <h1 class="font-display text-[clamp(2.2rem,6vw,4rem)] font-bold tracking-[-0.03em] leading-[1.15] text-text mb-6">
      Stack, standards and <span class="inline-block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-1">R&D programme</span>
    </h1>
    <p class="text-[18px] sm:text-[19px] leading-[1.65] text-text-secondary max-w-[760px] mx-auto">
      A page for technology partners, investors and companies considering a pilot. We share the stack, compliance standards and a high-level statement about our R&D work funded by EU grants.
    </p>
  </div>
</section>

<!-- STACK -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1100px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Technology stack</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Four layers. All production-proven.
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        We picked a stack with ten years of maturity behind it and a strong tooling ecosystem at every layer.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
      {stackGroups.map((group) => (
        <article class="p-6 sm:p-7 rounded-3xl bg-surface border border-border-subtle">
          <div class="flex items-center gap-3 mb-5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl text-white font-bold text-[13px]" style={`background: ${group.color}`}>
              {group.label.charAt(0)}
            </span>
            <h3 class="font-display text-[18px] font-bold text-text">{group.label}</h3>
          </div>
          <ul class="space-y-3">
            {group.items.map((item) => (
              <li>
                <p class="font-semibold text-[14px] text-text mb-0.5">{item.name}</p>
                <p class="text-[13px] text-text-secondary leading-[1.55]">{item.desc}</p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- COMPLIANCE -->
<section class="bg-surface py-20 px-5">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Compliance standards</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Six mandatory regulations — all implemented from day one
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        We don't treat regulation as a cost. We treat it as the foundation of customer and tax-office trust.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 reveal-stagger">
      {compliance.map((c) => (
        <article class="p-5 sm:p-6 rounded-2xl bg-surface-2 border border-border-subtle">
          <div class="flex items-start justify-between gap-3 mb-2">
            <h3 class="font-display text-[16px] font-bold text-text">{c.code}</h3>
            <span class="text-[11px] font-mono text-text-tertiary shrink-0">{c.name}</span>
          </div>
          <p class="text-[13.5px] text-text-secondary leading-[1.6]">{c.desc}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- R&D PROGRAMME -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">R&D programme</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Five R&D projects funded by EU grants
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto leading-[1.65]">
        In 2027–2028 we are running five R&D projects in the area of road transport technology, funded by European funds. Goal: extend the platform with proprietary technologies enabling full coverage of European van transport (2.5–3.5 t) and scale-out to the Czech, Slovak and German markets.
      </p>
    </div>

    <div class="rounded-3xl bg-surface border border-brand-border p-7 sm:p-10 reveal">
      <div class="flex items-start gap-4 mb-6">
        <svg class="w-6 h-6 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-1">Confidential</p>
          <p class="text-[15px] text-text-secondary leading-[1.65]">
            The detailed scope of R&D work is protected as a trade secret until project completion and acceptance of the final reports by the funding institutions. Technical documentation, timelines and outcome indicators are available only after signing a non-disclosure agreement.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-border-subtle">
        <div>
          <p class="font-display text-[26px] font-bold text-brand mb-1 leading-none">5</p>
          <p class="text-[12px] text-text-tertiary">R&D projects</p>
        </div>
        <div>
          <p class="font-display text-[26px] font-bold text-text mb-1 leading-none">2027–2028</p>
          <p class="text-[12px] text-text-tertiary">delivery window</p>
        </div>
        <div>
          <p class="font-display text-[26px] font-bold text-text mb-1 leading-none">PL + EU</p>
          <p class="text-[12px] text-text-tertiary">national and European funding</p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- CONSORTIUM -->
<section class="bg-surface py-20 px-5">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Consortium</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Three pillars of the academic-industrial consortium
      </h2>
      <p class="text-text-secondary max-w-[640px] mx-auto">
        Cooperation with a technical university, pilot transport companies, and an accounting-software provider.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal-stagger">
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Academic partner</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">Technical university</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          A Polish university with a faculty of transport or engineering — scientific validation, peer-reviewed publications, access to research laboratories.
        </p>
      </article>
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Industrial partner</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">Transport companies</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          50+ pilot companies operating vans 2.5–3.5 t in international EU transport — validation on real operational data.
        </p>
      </article>
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Technology partner</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">FK system</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          Insert GT, Comarch ERP Optima, Symfonia FK — integration at the export and KSeF level. Plus an FK partner for markets outside Poland.
        </p>
      </article>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="bg-surface-2 py-24 px-5 border-t border-border-subtle">
  <div class="max-w-[820px] mx-auto text-center reveal">
    <h2 class="font-display text-[32px] sm:text-[44px] font-bold tracking-[-0.02em] text-text mb-5 leading-[1.1]">
      Full documentation available under NDA
    </h2>
    <p class="text-text-secondary mb-8 max-w-[560px] mx-auto leading-[1.65]">
      For academic partners, consortium members, investors and grant evaluators — technical documentation, R&D project timelines, outcome indicators — provided after signing a non-disclosure agreement.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="mailto:kontakt@busikm.pl?subject=Technology%20—%20inquiry" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200">
        kontakt@busikm.pl
      </a>
      <a href="https://calendly.com/busikm/30min" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-surface text-text border border-border text-[15px] font-semibold hover:bg-surface-2 transition-colors duration-200">
        Book a 30-min call →
      </a>
    </div>
  </div>
</section>

</MarketingLayout>
