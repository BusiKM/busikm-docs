---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../../lib/app-url';
---

<MarketingLayout
  title="For accounting firms — BusiKM"
  description="Multi-tenant panel for accounting firms serving N transport-company clients. GDPR Art. 28 data isolation, X-Company-Context switching, FK export per client, per-country VAT-REF, JPK_V7 with auto-categorisation, audit trail."
>

<!-- ============ HERO ============ -->
<section class="relative overflow-hidden bg-surface px-5 py-24 sm:py-32">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-5%] left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full bg-[#8B5CF6]/[0.06] blur-[120px]"></div>
  </div>
  <div class="relative max-w-[1120px] mx-auto">
    <div class="max-w-[760px]">
      <div class="hero-seq-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#8B5CF6]/15 bg-[#8B5CF6]/[0.04] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#8B5CF6] animate-pulse"></span>
        <span class="text-[12.5px] font-semibold uppercase tracking-[0.06em] text-[#8B5CF6]">For accounting firms · multi-tenant</span>
      </div>

      <h1 class="hero-seq-2 font-display text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.12] tracking-[-0.035em] text-text mb-6">
        Transport clients — without the time sink.<br/>One panel, every fleet, full audit trail.
      </h1>

      <p class="hero-seq-3 text-[clamp(1rem,2vw,1.2rem)] leading-relaxed text-text-secondary max-w-[680px] mb-9">
        BusiKM is the only multi-tenant accounting platform purpose-built for the realities of transport firms (JPK_V7, VAT-REF, GTU, AETR, KSeF). Switch client context with one click, full GDPR Art. 28 data isolation, export-ready packages to Insert GT, Comarch ERP Optima, Symfonia FK and universal CSV.
      </p>

      <div class="hero-seq-4 flex flex-wrap gap-3 mb-12">
        <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold hover:bg-brand-dark transition-colors shadow-[0_1px_3px_rgba(0,92,232,0.4)]">
          Try the demo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/en/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-border bg-surface-2 text-text text-[15px] font-semibold hover:bg-surface transition-colors">
          Pricing (free for pilots)
        </a>
      </div>

      <div class="hero-seq-5 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-7 text-center sm:text-left">
        {[
          { num: 'Multi-tenant', label: 'switch clients with one click' },
          { num: 'GDPR 28', label: 'isolation per client company' },
          { num: 'VAT-REF', label: '8 EU countries, packaged' },
          { num: 'Audit log', label: '5-year retention, append-only' },
        ].map(s => (
          <div class="flex flex-col items-center sm:items-start">
            <div class="font-display text-[1.5rem] font-bold tracking-[-0.03em] text-text leading-none">{s.num}</div>
            <div class="text-[12.5px] text-text-tertiary mt-2 max-w-[160px] leading-snug min-h-[2.4rem] flex items-start">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ MULTI-TENANT DASHBOARD MOCKUP ============ -->
<section class="py-20 sm:py-28 bg-surface-2 px-5 border-t border-border-subtle">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal text-center mb-12 max-w-[680px] mx-auto">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#8B5CF6] mb-4">First screen after login</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15]">
        All clients.<br/>Every pending task. One screen.
      </h2>
    </div>

    <div class="reveal rounded-[20px] bg-[#F8F7F2] dark:bg-[#16161A] border border-border-subtle overflow-hidden shadow-[0_8px_48px_rgba(0,0,0,0.10)] dark:shadow-[0_8px_48px_rgba(0,0,0,0.30)]">
      <div class="flex items-center gap-2 px-5 py-3 bg-[#EBEBED] dark:bg-[#0F0F12] border-b border-border-subtle">
        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
        <div class="ml-4 flex-1 max-w-[340px] rounded-md bg-surface/70 px-3 py-1 text-[11px] text-text-tertiary font-mono">app.busikm.pl/firm/dashboard</div>
      </div>

      <div class="p-5 sm:p-7">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5 auto-rows-fr">
          {[
            { label: 'Active clients', value: '8', sub: '6 transport · 2 logistics', color: '#8B5CF6' },
            { label: 'JPK_V7 to submit', value: '5', sub: 'deadline: 25 May', color: '#FF3B30' },
            { label: 'VAT-REF pending', value: '€14 200', sub: 'DE 8 100 / FR 4 200 / IT 1 900', color: '#34C759' },
            { label: 'Exports ready', value: '23', sub: 'to import into FK', color: '#FF9500' },
          ].map(s => (
            <div class="bg-surface rounded-2xl p-4 shadow-[0_1px_3px_rgba(0,0,0,0.04)] flex flex-col">
              <p class="text-[10.5px] text-text-tertiary mb-1.5 uppercase tracking-[0.04em]">{s.label}</p>
              <p class="font-display text-[clamp(1.05rem,2vw,1.4rem)] font-bold tracking-[-0.02em] text-text leading-tight">{s.value}</p>
              <p class="text-[11px] mt-1 leading-tight mt-auto pt-1" style={`color: ${s.color};`}>{s.sub}</p>
            </div>
          ))}
        </div>

        <div class="bg-surface rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.04)] overflow-hidden">
          <div class="px-4 py-3 bg-[#FAFAFA] dark:bg-[#1F1F22] border-b border-border-subtle flex items-center justify-between">
            <span class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-tertiary">Clients · work status</span>
            <span class="text-[11px] text-text-tertiary">filter: May 2026</span>
          </div>
          <div class="divide-y divide-black/[0.04] dark:divide-white/[0.06]">
            {[
              { name: 'TransKowalski Sp. z o.o.', vehicles: 12, accountant: 'Joanna K. (accountant)', status: 'Ready for JPK_V7', statusColor: '#34C759', vat: 'VAT-REF: €4 280' },
              { name: 'FlotaNowak', vehicles: 8, accountant: 'Marta L. (accountant)', status: 'Waiting on 3 receipts', statusColor: '#FF9500', vat: 'VAT-REF: €2 100' },
              { name: 'EuroSpeed Logistics', vehicles: 15, accountant: 'Adam M. (accountant)', status: 'Ready for JPK_V7', statusColor: '#34C759', vat: 'VAT-REF: €5 820' },
              { name: 'TransAlpina', vehicles: 6, accountant: 'Anna W. (accountant)', status: 'Correction approval needed', statusColor: '#FF3B30', vat: 'VAT-REF: €1 100' },
              { name: 'BusiPol Express', vehicles: 9, accountant: 'Piotr S. (accountant)', status: 'Ready for JPK_V7', statusColor: '#34C759', vat: 'VAT-REF: €900' },
            ].map(c => (
              <div class="grid grid-cols-12 gap-3 items-center px-4 py-3.5 hover:bg-[#FAFAFA] dark:bg-[#1F1F22] transition-colors text-[12px]">
                <div class="col-span-12 sm:col-span-4">
                  <p class="font-semibold text-text leading-tight">{c.name}</p>
                  <p class="text-[11px] text-text-tertiary leading-tight">{c.vehicles} vehicles · {c.accountant}</p>
                </div>
                <div class="col-span-12 sm:col-span-5">
                  <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-semibold" style={`background: ${c.statusColor}15; color: ${c.statusColor}`}>{c.status}</span>
                </div>
                <div class="col-span-12 sm:col-span-3 text-left sm:text-right">
                  <span class="text-[11px] font-mono text-[#34C759] font-semibold">{c.vat}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="px-4 py-3 bg-[#FAFAFA] dark:bg-[#1F1F22] border-t border-border-subtle text-[11px] text-text-tertiary flex items-center justify-between">
            <span>+ 3 other clients (retail, non-transport)</span>
            <span class="text-text font-semibold">Total: 8 transport firms · 50 vehicles</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 6 PILLARS ============ -->
<section class="py-20 sm:py-28 bg-surface px-5 border-t border-border-subtle">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal max-w-[680px] mb-14">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#8B5CF6] mb-4">Multi-tenant features</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15]">
        Six tools that turn transport into the<br/>most profitable vertical your firm serves.
      </h2>
    </div>

    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {[
        { title: 'Client context switching', desc: 'Sidebar lists all your clients. Click a name — the whole panel shows that company\'s data: mileage records, cost invoices, VAT register, VAT-REF package, per-diem files. No re-login.', tech: 'X-Company-Context header · Redis 8h cache', color: '#8B5CF6' },
        { title: 'FK export per client — every system', desc: 'Each transport client exports to Insert GT, Comarch ERP Optima, Symfonia FK or universal CSV with one click. Native format of every system. Zero rekeying.', tech: '3 FK systems · one click · JPK ready', color: '#0A84FF' },
        { title: 'VAT-REFUND package per country', desc: 'BusiKM aggregates VAT-recoverable invoices from DE, FR, IT, NL, AT, BE, ES (Directive 2008/9/EC). Submit one package via Polish tax office to the country of refund. Deadline: 30 September following year.', tech: '8th Directive · XML+PDF package · per country', color: '#34C759' },
        { title: 'JPK_V7 with auto-categorisation', desc: 'Invoices from BusiKM arrive with chart-of-accounts categories (fuel PL/EU, tolls, hotels, service), GTU markings where required, VIES-verified Polish and EU VAT IDs. JPK_V7 generates without corrections.', tech: 'GTU · VIES · JPK_V7-ready', color: '#FF9500' },
        { title: 'Audit trail & integrity', desc: 'Every change has a timestamp, author and history. During a tax audit you see: who entered the invoice, when, with what supporting document. Full append-only log (5-year retention).', tech: 'Append-only log · 5-year retention', color: '#FF3B30' },
        { title: 'Three access levels per client', desc: 'Full admin (like the owner), read-only (overview + reports + export), reports-only (no operational fleet data). Configured per client — exactly as your contract specifies.', tech: 'RBAC per client · panel-configurable', color: '#005CE8' },
      ].map(f => (
        <article class="bg-surface-2 rounded-[20px] p-7 border border-border-subtle flex flex-col">
          <div class="w-10 h-10 rounded-[12px] mb-4 flex items-center justify-center" style={`background: ${f.color}15`}>
            <span class="w-3 h-3 rounded-full" style={`background: ${f.color}`}></span>
          </div>
          <h3 class="font-display font-bold text-[1.05rem] text-text mb-2">{f.title}</h3>
          <p class="text-[13.5px] text-text-secondary leading-relaxed mb-3 flex-1">{f.desc}</p>
          <p class="text-[10.5px] text-text-tertiary font-mono">{f.tech}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="py-20 sm:py-28 bg-[#0A0A0B] px-5 overflow-hidden relative">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] rounded-full bg-[#8B5CF6]/15 blur-[150px]"></div>
  </div>
  <div class="relative reveal text-center max-w-[680px] mx-auto">
    <h2 class="font-display text-[clamp(1.8rem,5vw,2.8rem)] font-bold tracking-[-0.03em] text-white leading-[1.18] mb-5">
      One client costs less time —<br/>which means you can take on more.
    </h2>
    <p class="text-[15px] text-white/60 mb-10 leading-relaxed">
      Free 3-month onboarding for the first accounting firms joining the pilot. In exchange — a short conversation about the product once a month.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-[#0A0A0B] text-[15px] font-semibold hover:bg-[#F5F5F7] transition-colors">
        Try the demo
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/en/pricing" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-white/15 text-white text-[15px] font-semibold hover:border-white/30 hover:bg-white/10 transition-all">
        Pricing (free for pilots)
      </a>
    </div>
  </div>
</section>

</MarketingLayout>
