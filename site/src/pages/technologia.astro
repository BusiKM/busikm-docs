---
import MarketingLayout from '../layouts/MarketingLayout.astro';

/**
 * /technologia — publiczna strona dla inwestorów, partnerów, ewaluatorów.
 * Pokazuje stack, standardy zgodności i ogólny przekaz o pracach badawczo-rozwojowych.
 * Szczegóły techniczne projektów R&D są objęte tajemnicą przedsiębiorstwa i nie publikujemy ich tutaj.
 */

const stackGroups = [
  {
    label: 'Backend',
    color: '#005CE8',
    items: [
      { name: 'Django 5 + DRF', desc: 'API platformy, autoryzacja, model danych floty, integracje FK.' },
      { name: 'Celery + Redis',  desc: 'Zadania w tle: auto-detekcja aktywności, push, eksporty FK.' },
      { name: 'Daphne (ASGI)',   desc: 'WebSocket w czasie rzeczywistym — mapa floty i alerty na żywo.' },
      { name: 'OpenAPI 3.1',     desc: 'Schema-first API — klient TypeScript generowany automatycznie.' },
    ],
  },
  {
    label: 'Frontend',
    color: '#34C759',
    items: [
      { name: 'Next.js 16 + Tailwind 4', desc: 'Panel webowy dla właściciela i biura rachunkowego.' },
      { name: 'React Native + Expo SDK 52', desc: 'Aplikacja mobilna kierowcy i właściciela — iOS i Android.' },
      { name: 'SWR + Zustand',   desc: 'Cache i stan aplikacji — szybkie odświeżanie, tryb offline.' },
      { name: 'Mapbox + Recharts', desc: 'Mapa floty, geofencing, wykresy rentowności i kosztów.' },
    ],
  },
  {
    label: 'Bazy danych',
    color: '#FF9500',
    items: [
      { name: 'PostgreSQL 16',   desc: 'Główna baza relacyjna — flota, kierowcy, zlecenia, rozliczenia.' },
      { name: 'MongoDB 7',       desc: 'Telemetria GPS, historia tras, dziennik aktywności.' },
      { name: 'Redis 7',         desc: 'Cache, kolejka zadań, sesje, pub/sub dla WebSocket.' },
    ],
  },
  {
    label: 'Infrastruktura',
    color: '#8B5CF6',
    items: [
      { name: 'GitHub Actions',  desc: 'CI/CD, testy automatyczne, regresja przy każdej zmianie.' },
      { name: 'EAS Build',       desc: 'Buildy aplikacji mobilnej, dystrybucja w App Store i Google Play.' },
      { name: 'Vercel',          desc: 'Hosting strony marketingowej i panelu webowego, edge cache.' },
      { name: 'Monitoring',      desc: 'Sentry, Prometheus, dashboard zdrowia systemu 24/7.' },
    ],
  },
];

const compliance = [
  { code: 'RODO',          name: 'Rozp. (UE) 2016/679',  desc: 'Pełne wymogi RODO — minimalizacja danych, prawo do bycia zapomnianym, eksport danych osobowych w formacie przenośnym.' },
  { code: 'ISO/IEC 27001', name: 'Norma bezpieczeństwa', desc: 'Framework zarządzania bezpieczeństwem informacji — przygotowanie pod audyt certyfikacyjny w 2027.' },
  { code: 'EU AI Act',     name: 'Rozp. (UE) 2024/1689', desc: 'Zgodność z wymogami transparency i human-in-the-loop dla komponentów uczenia maszynowego.' },
  { code: 'eIDAS',         name: 'Rozp. (UE) 910/2014',  desc: 'Identyfikacja elektroniczna i usługi zaufania — kontekst integracji z KSeF i polskimi e-podpisami.' },
  { code: 'eFTI',          name: 'Rozp. (UE) 2020/1056', desc: 'Schema kompatybilność danych transportowych — przygotowanie pod scale-out poza Polskę.' },
  { code: 'Rozp. 561/2006',name: 'Czas pracy kierowców', desc: 'Pełna zgodność wyliczeń czasu pracy AETR + Pakiet Mobilności 2020. Raporty PDF dla kontroli ITD i BAG.' },
];
---

<MarketingLayout
  title="Technologia — stack i prace badawczo-rozwojowe BusiKM"
  description="Stack technologiczny BusiKM (Django, React Native, PostgreSQL, MongoDB, Redis) oraz informacja o prowadzonych pracach badawczo-rozwojowych finansowanych ze środków UE."
>

<!-- ====================== HERO ====================== -->
<section class="relative bg-surface py-24 sm:py-32 px-5 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[600px] rounded-full bg-brand/[0.05] blur-[160px]"></div>
  </div>
  <div class="relative max-w-[960px] mx-auto text-center">
    <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/8 text-brand text-[11px] font-bold uppercase tracking-[0.1em] mb-6">
      <span class="w-1 h-1 rounded-full bg-brand"></span>
      Technologia · e-TMS dla busów 2,5–3,5 t
    </p>
    <h1 class="font-display text-[clamp(2.2rem,6vw,4rem)] font-bold tracking-[-0.03em] leading-[1.15] text-text mb-6">
      Stack, standardy i <span class="inline-block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-1">prace badawczo-rozwojowe</span>
    </h1>
    <p class="text-[18px] sm:text-[19px] leading-[1.65] text-text-secondary max-w-[760px] mx-auto">
      Strona dla partnerów technologicznych, inwestorów i firm rozważających pilotaż. Pokazujemy stack platformy zaprojektowanej pod transport międzynarodowy busami klasy 2,5–3,5&nbsp;t, standardy zgodności oraz informację o prowadzonych pracach badawczo-rozwojowych finansowanych ze środków UE.
    </p>
  </div>
</section>

<!-- ====================== STACK TECHNOLOGICZNY ====================== -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1100px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Stack technologiczny</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Cztery warstwy. Wszystko produkcyjnie sprawdzone.
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        Wybraliśmy stack, który ma za sobą dziesięć lat dojrzałości i ekosystem narzędzi pod każdą warstwę aplikacji.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
      {stackGroups.map((group) => (
        <article class="p-6 sm:p-7 rounded-3xl bg-surface border border-border-subtle">
          <div class="flex items-center gap-3 mb-5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl text-white font-bold text-[13px]" style={`background: ${group.color}`}>
              {group.label.charAt(0)}
            </span>
            <h3 class="font-display text-[18px] font-bold text-text">{group.label}</h3>
          </div>
          <ul class="space-y-3">
            {group.items.map((item) => (
              <li>
                <p class="font-semibold text-[14px] text-text mb-0.5">{item.name}</p>
                <p class="text-[13px] text-text-secondary leading-[1.55]">{item.desc}</p>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- ====================== STANDARDY ZGODNOŚCI ====================== -->
<section class="bg-surface py-20 px-5">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Standardy zgodności</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Sześć obowiązkowych regulacji — wszystkie wdrożone od początku
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        Nie traktujemy regulacji jako kosztu. Traktujemy je jako fundament zaufania klienta i urzędu skarbowego.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 reveal-stagger">
      {compliance.map((c) => (
        <article class="p-5 sm:p-6 rounded-2xl bg-surface-2 border border-border-subtle">
          <div class="flex items-start justify-between gap-3 mb-2">
            <h3 class="font-display text-[16px] font-bold text-text">{c.code}</h3>
            <span class="text-[11px] font-mono text-text-tertiary shrink-0">{c.name}</span>
          </div>
          <p class="text-[13.5px] text-text-secondary leading-[1.6]">{c.desc}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- ====================== PRACE BADAWCZO-ROZWOJOWE ====================== -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Prace badawczo-rozwojowe</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Pięć projektów badawczo-rozwojowych finansowanych ze środków UE
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto leading-[1.65]">
        W latach 2027–2028 prowadzimy pięć projektów badawczo-rozwojowych w obszarze technologii transportu drogowego, finansowanych z funduszy europejskich. Cel: rozszerzenie platformy o autorskie technologie umożliwiające pełne pokrycie europejskiego transportu klasy 2,5–3,5 t i scale-out na rynki Czech, Słowacji oraz Niemiec.
      </p>
    </div>

    <div class="rounded-3xl bg-surface border border-brand-border p-7 sm:p-10 reveal">
      <div class="flex items-start gap-4 mb-6">
        <svg class="w-6 h-6 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-1">Informacja poufna</p>
          <p class="text-[15px] text-text-secondary leading-[1.65]">
            Szczegółowy zakres prac badawczo-rozwojowych objęty jest tajemnicą przedsiębiorstwa do momentu zakończenia projektów i akceptacji raportów końcowych przez instytucje finansujące. Dokumentacja techniczna, harmonogramy i wskaźniki rezultatu udostępniane są wyłącznie po podpisaniu umowy o zachowaniu poufności.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-border-subtle">
        <div>
          <p class="font-display text-[26px] font-bold text-brand mb-1 leading-none">5</p>
          <p class="text-[12px] text-text-tertiary">projektów badawczo-rozwojowych</p>
        </div>
        <div>
          <p class="font-display text-[26px] font-bold text-text mb-1 leading-none">2027–2028</p>
          <p class="text-[12px] text-text-tertiary">okres realizacji</p>
        </div>
        <div>
          <p class="font-display text-[26px] font-bold text-text mb-1 leading-none">PL + UE</p>
          <p class="text-[12px] text-text-tertiary">finansowanie krajowe i europejskie</p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ====================== PIPELINE KONSORCJUM ====================== -->
<section class="bg-surface py-20 px-5">
  <div class="max-w-[1000px] mx-auto">

    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Konsorcjum</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Trzy filary konsorcjum naukowo-przemysłowego
      </h2>
      <p class="text-text-secondary max-w-[640px] mx-auto">
        Współpraca z uczelnią techniczną, firmami transportowymi pilotażowymi oraz dostawcą systemu finansowo-księgowego.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal-stagger">
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Partner akademicki</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">Uczelnia techniczna</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          Polska uczelnia z wydziałem transportu lub inżynierii — walidacja naukowa, publikacje peer-reviewed, dostęp do laboratoriów badawczych.
        </p>
      </article>
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Partner przemysłowy</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">Firmy transportowe</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          50+ firm pilotażowych z busami 2,5–3,5 t w transporcie międzynarodowym UE — walidacja na realnych danych operacyjnych.
        </p>
      </article>
      <article class="p-6 rounded-2xl bg-surface-2 border border-border-subtle">
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-2">Partner technologiczny</p>
        <h3 class="font-display text-[17px] font-bold text-text mb-2">System FK</h3>
        <p class="text-[13px] text-text-secondary leading-[1.6]">
          Insert GT, Comarch ERP Optima, Symfonia FK — integracja na poziomie eksportu i KSeF. Plus partner FK dla rynków poza Polską.
        </p>
      </article>
    </div>

  </div>
</section>

<!-- ====================== CTA ====================== -->
<section class="bg-surface-2 py-24 px-5 border-t border-border-subtle">
  <div class="max-w-[820px] mx-auto text-center reveal">
    <h2 class="font-display text-[32px] sm:text-[44px] font-bold tracking-[-0.02em] text-text mb-5 leading-[1.1]">
      Pełna dokumentacja dostępna po NDA
    </h2>
    <p class="text-text-secondary mb-8 max-w-[560px] mx-auto leading-[1.65]">
      Dla partnerów naukowych, firm konsorcyjnych, inwestorów i ewaluatorów grantów — dokumentacja techniczna, harmonogramy projektów badawczo-rozwojowych, wskaźniki rezultatu — udostępniamy po podpisaniu umowy o zachowaniu poufności.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="mailto:kontakt@busikm.pl?subject=Technologia%20—%20zapytanie" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-colors duration-200">
        kontakt@busikm.pl
      </a>
      <a href="https://calendly.com/busikm/30min" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-surface text-text border border-border text-[15px] font-semibold hover:bg-surface-2 transition-colors duration-200">
        Umów spotkanie 30 min →
      </a>
    </div>
  </div>
</section>

</MarketingLayout>
