---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../lib/app-url';

/**
 * /technologia — dedykowana strona R&D pod granty/inwestorów (BKM-554).
 * 7 sekcji: hero, TRL roadmap, 6 komponentów, metodologia, IP, partnerzy, CTA.
 */

const components = [
  {
    id: 'parser-ddd',
    name: 'Parser binarny pliku DDD',
    trl: 4,
    label: 'Innowacja krajowa',
    labelColor: '#3380FF',
    problem: 'Plik DDD pobierany z tachografu G2V2 to surowy binarny zrzut pamięci urządzenia. Brak istniejącej biblioteki Python umożliwiającej odczyt zgodny z Rozp. (UE) 2016/799 Annex I dla rynku PL/UE.',
    hypothesis: 'Da się zbudować bibliotekę Python parsującą blok danych DDD, walidującą sygnatury certyfikatów cyfrowych zgodnie z aneksami 2016/799, generującą czytelny raport 56-dniowy zgodny z wymogiem ITD.',
    method: 'Reverse-engineering specyfikacji binarnej (2016/799 Annex I), implementacja struct-based parsera, walidacja na próbach plików DDD z certyfikowanych tachografów (testowy stand walidacyjny).',
    foundation: 'Rozp. (UE) 2016/799 — Annex I (struktura DDD), Annex IC (certyfikaty)',
    eurLex: 'https://eur-lex.europa.eu/eli/reg/2016/799/oj',
    metrics: 'Generacja raportu 56 dni z DDD w czasie <2s, walidacja certyfikatu w <100ms, 100% akceptacja przez ITD w pilotażu',
    status: 'Prototyp R&D — TRL 4, planowane TRL 5 w Q4 2026 po pilotażu',
  },
  {
    id: 'bluetooth-its',
    name: 'Bluetooth ITS — komunikacja z tachografem',
    trl: 3,
    label: 'Innowacja europejska',
    labelColor: '#34C759',
    problem: 'Pobranie pliku DDD wymaga obecnie podłączenia tachografu kablem do warsztatu lub specjalistycznego sprzętu CITROEN. Niedostępne dla małych firm transportowych operujących busami 2,5–3,5 t.',
    hypothesis: 'Możliwe jest zbudowanie biblioteki React Native pobierającej DDD przez interfejs Bluetooth ITS (Intelligent Transport System) opisany w aneksach 2016/799 — bez specjalistycznego sprzętu, bezpośrednio z aplikacji mobilnej kierowcy.',
    method: 'Implementacja protokołu Bluetooth ITS handshake (pairing, certyfikat, sesja), wymiana danych certyfikacyjnych. Walidacja na sprzęcie referencyjnym (tachograf G2V2 + smartfon Android/iOS).',
    foundation: 'Rozp. (UE) 2016/799 — Annexes (Bluetooth ITS protocol)',
    eurLex: 'https://eur-lex.europa.eu/eli/reg/2016/799/oj',
    metrics: 'Pobranie DDD przez BT ITS w <30s, kompatybilność z 100% certyfikowanych tachografów G2V2, zero false-negative handshakes',
    status: 'Badania (proof of concept) — TRL 3, planowane TRL 4 (prototyp) Q1 2027',
  },
  {
    id: 'border-detection',
    name: 'Detekcja przekroczenia granic UE',
    trl: 5,
    label: 'Algorytm geoprzestrzenny',
    labelColor: '#FF9500',
    problem: 'Kalkulacja diet zagranicznych (Rozp. MPiPS) wymaga znania kraju kierowcy na każdy timestamp GPS. Komercyjne API geoprzestrzenne (Google, Mapbox) są drogie i wymagają internetu — bez ograniczeń dla floty offline-first.',
    hypothesis: 'Algorytm point-in-polygon na lokalnej warstwie GeoJSON granic 27 państw UE może klasyfikować GPS w czasie rzeczywistym z dokładnością wystarczającą do diet (poziom kraju, nie ulicy) — bez API i bez połączenia.',
    method: 'Shapely (Python) + uproszczona warstwa GeoJSON granic UE (Eurostat NUTS-0). Walidacja na trasach referencyjnych PL→DE/IT/FR/ES — porównanie wyników z Mapbox Geocoding API.',
    foundation: 'OGC Simple Features Access; Eurostat NUTS-0 administrative boundaries',
    eurLex: 'https://ec.europa.eu/eurostat/web/nuts/background',
    metrics: 'Dokładność klasyfikacji ≥99,5% vs Mapbox baseline; latency <10ms per point; rozmiar GeoJSON <2 MB',
    status: 'Walidacja w laboratorium (TRL 5) — trasy referencyjne PL→DE/IT/FR potwierdzone; planowane TRL 6 (system integration) Q3 2026',
  },
  {
    id: 'diet-engine',
    name: 'Silnik kalkulacji diet zagranicznych (AETR)',
    trl: 4,
    label: 'Innowacja procesowa',
    labelColor: '#A78BFA',
    problem: 'Reguły z Rozp. MPiPS z 29.01.2013 r. (Dz.U. 2013 poz. 167, Załącznik nr 2) zawierają stawki dietowe per kraj per dzień + warunki podziału doby. Manualne rozliczenie kierowcy międzynarodowego = pół dnia pracy księgowej.',
    hypothesis: 'Możliwe jest zbudowanie deterministycznego silnika produkcyjnego mapującego regulacje MPiPS na automatyczny kalkulator diet, łączącego wynik point-in-polygon z tabelą stawek i edge cases (podział doby, powrót do kraju, posting).',
    method: 'Implementacja jako Django app z table-driven rules engine. Walidacja na realnych przypadkach kierowców pilotażowych. Eksport do Insert GT, Comarch, Symfonia.',
    foundation: 'Rozp. MPiPS z 29.01.2013 r. (Dz.U. 2013 poz. 167, Załącznik nr 2); EU 1057/2020 (Mobility Package — posting, diety)',
    eurLex: 'https://eur-lex.europa.eu/eli/reg/2020/1057/oj',
    metrics: 'Rozliczenie kierowcy w <5 min (vs ~4h manualnie), 100% zgodność z audytem MPiPS, 0 błędów w podziale doby na pilotażu',
    status: 'Prototyp (TRL 4) — silnik gotowy, walidacja na realnych danych w pilotażu Q2-Q3 2026',
  },
  {
    id: 'xai-fuel-anomaly',
    name: 'Detekcja anomalii spalania (XAI)',
    trl: 3,
    label: 'Uczenie maszynowe · XAI',
    labelColor: '#FF6B5C',
    problem: 'Kradzieże paliwa kierowców i wycieki techniczne to ~3-5% kosztów flotowych. Wykrycie wymaga manualnej analizy raportów — niedostępne dla małej floty (2-5 pojazdów).',
    hypothesis: 'Model regresji wielowymiarowej trenowany na cechach trasy (dystans, ukształtowanie, ładunek, prędkość, kierowca, pora roku) może wykrywać anomalie spalania z dokładnością wystarczającą do alertowania. Element XAI generuje naturalnojęzykowe wyjaśnienie każdej detekcji — kluczowe dla zaufania użytkownika nieosiagającego z ML.',
    method: 'Baseline: gradient boosting regressor (XGBoost / LightGBM). XAI: SHAP values + template-driven natural language explanation. Próg detekcji: ≥15% odchylenie od prognozy.',
    foundation: 'Lundberg & Lee 2017 (SHAP); EU AI Act (transparency obligations)',
    eurLex: 'https://eur-lex.europa.eu/eli/reg/2024/1689/oj',
    metrics: 'Precision ≥80% (false positives <20%), recall ≥70% na zbiorach pilotażowych. Wyjaśnienie generowane w <1s per alert.',
    status: 'Badania (TRL 3) — proof of concept, treningowy dataset zbierany w pilotażu MVP. Planowane TRL 4 (prototyp) Q2 2027',
  },
  {
    id: 'multi-tenant',
    name: 'Multi-tenant z izolacją danych',
    trl: 8,
    label: 'Architektura SaaS',
    labelColor: '#34C759',
    problem: 'Biura rachunkowe obsługujące transport potrzebują panelu wielodzierżawnego z izolacją danych zgodną z art. 28 RODO. Istniejące rozwiązania SaaS są zaprojektowane dla pojedynczej firmy, nie dla agencji obsługujących N klientów.',
    hypothesis: 'Da się zbudować architekturę gdzie biuro rachunkowe loguje się raz i przełącza między klientami z gwarancją niewidoczności danych innych klientów — przy pełnym audit logu zgodnym z RODO.',
    method: 'Django CompanyScopedMixin + TenantContextMiddleware. Każde query SQL automatycznie filtruje po company_id z headera X-Company-Context. AES-encrypted PII (PESEL, NIP). AuditLog per operation.',
    foundation: 'Art. 28 RODO (powierzanie przetwarzania); ISO/IEC 27001 (information security)',
    eurLex: 'https://eur-lex.europa.eu/eli/reg/2016/679/oj',
    metrics: 'Zero cross-tenant data leaks w testach penetracyjnych; audit log 100% operacji; context switching <100ms',
    status: 'Produkcja w MVP (TRL 8) — działa od pierwszego dnia pilotażu (30 maja 2026). Planowane TRL 9 (commercial scale) Q4 2026 po komercjalizacji.',
  },
];
---

<MarketingLayout
  title="Technologia — prace badawczo-rozwojowe BusiKM"
  description="Sześć autorskich komponentów badawczo-rozwojowych BusiKM pod europejski transport 2,5–3,5 t. TRL roadmap, metodologia R&D, IP strategy, partnerzy. Podstawa aplikacji do FENG SMART, EIC Accelerator, Horizon Europe."
>

<!-- ====================== HERO ====================== -->
<section class="relative bg-surface py-24 sm:py-32 px-5 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[600px] rounded-full bg-brand/[0.05] blur-[160px]"></div>
  </div>
  <div class="relative max-w-[960px] mx-auto text-center">
    <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand/8 text-brand text-[11px] font-bold uppercase tracking-[0.1em] mb-6">
      <span class="w-1 h-1 rounded-full bg-brand"></span>
      Prace badawczo-rozwojowe
    </p>
    <h1 class="font-display text-[clamp(2.2rem,6vw,4rem)] font-bold tracking-[-0.03em] leading-[1.15] text-text mb-6">
      Sześć komponentów badawczo-rozwojowych pod europejski transport <span class="inline-block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-1">2,5–3,5&nbsp;t</span>
    </h1>
    <p class="text-[18px] sm:text-[19px] leading-[1.65] text-text-secondary max-w-[760px] mx-auto mb-10">
      Strona dla ewaluatorów grantów, inwestorów i partnerów technologicznych. Każdy komponent ma określony <strong class="text-text">Technology Readiness Level</strong> (TRL 1–9, skala Komisji Europejskiej), opisaną metodę badawczą, fundament regulacyjny i mierzalne KPI.
    </p>

    <!-- TRL mini-preview: 6 komponentów -->
    <div class="inline-flex flex-wrap items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-surface-2 border border-border-subtle">
      <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary mr-2">Status TRL:</span>
      {components.map(c => (
        <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-surface text-[11px] font-mono font-semibold text-text" title={c.name}>
          <span class:list={[
            'w-1.5 h-1.5 rounded-full',
            c.trl <= 3 ? 'bg-danger' : c.trl <= 5 ? 'bg-warning' : c.trl <= 7 ? 'bg-brand' : 'bg-success',
          ]}></span>
          T{c.trl}
        </span>
      ))}
    </div>
  </div>
</section>

<!-- ====================== TRL ROADMAP ====================== -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1000px] mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">TRL Roadmap</p>
      <h2 class="font-display text-[28px] sm:text-[36px] font-bold tracking-[-0.02em] text-text mb-3">
        Od badań (TRL 3) do market-ready (TRL 9) w trzy lata
      </h2>
      <p class="text-text-secondary max-w-[600px] mx-auto">
        Pilotaż MVP (30 maja 2026) walida 5 z 6 komponentów na realnych danych — transition TRL 5→6.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 reveal-stagger">
      <article class="p-6 rounded-2xl bg-surface border border-border-subtle">
        <p class="font-display text-[36px] font-bold text-warning mb-2 leading-none">2026</p>
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-3">Pilotaż MVP</p>
        <p class="text-[13.5px] text-text-secondary leading-[1.6] mb-4">
          5 komponentów na TRL 3–5 (R&D). Jeden komponent (multi-tenant) na TRL 8 — produkcja od pierwszego dnia.
        </p>
        <ul class="space-y-1.5 text-[12px] text-text-tertiary">
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-warning"></span>Parser DDD — prototyp R&D</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-danger"></span>Bluetooth ITS — proof of concept</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-warning"></span>Border detection — walidacja lab</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-warning"></span>Diet engine — prototyp</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-danger"></span>XAI anomaly — badania</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-success"></span>Multi-tenant — produkcja</li>
        </ul>
      </article>

      <article class="p-6 rounded-2xl bg-surface border border-brand-border">
        <p class="font-display text-[36px] font-bold text-brand mb-2 leading-none">2027</p>
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-brand mb-3">System Integration</p>
        <p class="text-[13.5px] text-text-secondary leading-[1.6] mb-4">
          Cel: wszystkie komponenty na TRL 6–7. Walidacja na rozszerzonym pilotażu (50+ firm transportowych w UE).
        </p>
        <ul class="space-y-1.5 text-[12px] text-text-tertiary">
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brand"></span>Wszystkie 6 komponentów TRL 6–7</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brand"></span>Walidacja pan-EU (CZ/SK/DE pilotaż)</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-brand"></span>Aplikacja FENG SMART / EIC złożona</li>
        </ul>
      </article>

      <article class="p-6 rounded-2xl bg-surface border border-success/20">
        <p class="font-display text-[36px] font-bold text-success mb-2 leading-none">2028</p>
        <p class="text-[11px] font-bold uppercase tracking-[0.08em] text-success mb-3">Market Ready (TRL 9)</p>
        <p class="text-[13.5px] text-text-secondary leading-[1.6] mb-4">
          Wszystkie komponenty w produkcji. Komercjalizacja, scale-out poza Polskę, partnerstwa konsorcyjne.
        </p>
        <ul class="space-y-1.5 text-[12px] text-text-tertiary">
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-success"></span>Wszystkie 6 komponentów TRL 8–9</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-success"></span>Komercjalizacja w 3+ krajach UE</li>
          <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-success"></span>Partnerstwo z 1 uczelnią + 1 system FK</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<!-- ====================== SZEŚĆ KOMPONENTÓW (detailed) ====================== -->
<section class="bg-surface py-24 px-5">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-14 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Sześć komponentów R&D</p>
      <h2 class="font-display text-[28px] sm:text-[40px] font-bold tracking-[-0.025em] text-text mb-4">
        Szczegółowy opis prac badawczo-rozwojowych
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        Per komponent: problem badawczy, hipoteza, metoda, fundament regulacyjny, KPI, status TRL.
      </p>
    </div>

    <div class="space-y-6 reveal-stagger">
      {components.map((c, i) => (
        <article id={c.id} class="rounded-3xl bg-surface-2 border border-border-subtle p-7 sm:p-9">
          <header class="flex flex-wrap items-start gap-4 mb-5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-display text-[14px] font-bold text-text-tertiary tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="px-2.5 py-1 rounded-full text-[10.5px] font-bold tracking-[0.06em] uppercase" style={`background:${c.labelColor}26;color:${c.labelColor}`}>{c.label}</span>
              <span class:list={[
                'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10.5px] font-bold tracking-[0.06em] uppercase',
                c.trl <= 3 ? 'bg-danger/15 text-danger' : c.trl <= 5 ? 'bg-warning/15 text-warning' : c.trl <= 7 ? 'bg-brand/15 text-brand' : 'bg-success/15 text-success',
              ]}>
                <span class:list={[
                  'w-1.5 h-1.5 rounded-full',
                  c.trl <= 3 ? 'bg-danger' : c.trl <= 5 ? 'bg-warning' : c.trl <= 7 ? 'bg-brand' : 'bg-success',
                ]}></span>
                TRL {c.trl}
              </span>
            </div>
          </header>
          <h3 class="font-display text-[22px] sm:text-[26px] font-bold tracking-[-0.015em] text-text mb-5">{c.name}</h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-5 mb-5">
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Problem badawczy</p>
              <p class="text-[14px] leading-[1.65] text-text-secondary">{c.problem}</p>
            </div>
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Hipoteza / cel</p>
              <p class="text-[14px] leading-[1.65] text-text-secondary">{c.hypothesis}</p>
            </div>
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Metoda</p>
              <p class="text-[14px] leading-[1.65] text-text-secondary">{c.method}</p>
            </div>
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Metryki sukcesu (KPI)</p>
              <p class="text-[14px] leading-[1.65] text-text-secondary">{c.metrics}</p>
            </div>
          </div>

          <div class="pt-5 border-t border-border-subtle grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3">
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Fundament regulacyjny / naukowy</p>
              <p class="text-[13px] text-text-secondary">{c.foundation}</p>
              <a href={c.eurLex} target="_blank" rel="noopener" class="text-[12px] text-brand hover:underline mt-1 inline-block">EUR-Lex / źródło →</a>
            </div>
            <div>
              <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-text-tertiary mb-1.5">Status</p>
              <p class="text-[13px] text-text-secondary">{c.status}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ====================== METODOLOGIA R&D ====================== -->
<section class="bg-surface-2 py-20 px-5 border-y border-border-subtle">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-brand mb-3">Metodologia R&D</p>
      <h2 class="font-display text-[28px] sm:text-[36px] font-bold tracking-[-0.02em] text-text mb-3">
        Sprint-based research z walidacją na realnych danych
      </h2>
      <p class="text-text-secondary max-w-[680px] mx-auto">
        Każdy komponent rozwijamy w 2-tygodniowych sprintach (Jira BKM-*). Walidacja w pilotażu MVP od 30 maja 2026 — realny ruch transportowy w UE.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal-stagger">
      <article class="p-6 rounded-2xl bg-surface border border-border-subtle">
        <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-brand mb-3">Proces</p>
        <ol class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand/10 text-brand text-[11px] font-bold flex items-center justify-center">1</span>
            <div>
              <p class="text-[14px] font-semibold text-text">Hipoteza badawcza</p>
              <p class="text-[12.5px] text-text-secondary">Definiowanie problemu, celu i mierzalnych KPI. Dokumentacja w Jira jako epic.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-warning/10 text-warning text-[11px] font-bold flex items-center justify-center">2</span>
            <div>
              <p class="text-[14px] font-semibold text-text">Prototyp (TRL 3→4)</p>
              <p class="text-[12.5px] text-text-secondary">Minimal viable implementation walidująca koncept. Code review + unit tests gate.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-warning/10 text-warning text-[11px] font-bold flex items-center justify-center">3</span>
            <div>
              <p class="text-[14px] font-semibold text-text">Walidacja (TRL 4→5)</p>
              <p class="text-[12.5px] text-text-secondary">Testy na realnych danych pilotażowych, porównanie z baseline (gdy istnieje).</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand/10 text-brand text-[11px] font-bold flex items-center justify-center">4</span>
            <div>
              <p class="text-[14px] font-semibold text-text">Integracja (TRL 5→7)</p>
              <p class="text-[12.5px] text-text-secondary">Embed w produkt; integration tests + observability (Sentry, Prometheus).</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-success/10 text-success text-[11px] font-bold flex items-center justify-center">5</span>
            <div>
              <p class="text-[14px] font-semibold text-text">Produkcja (TRL 8→9)</p>
              <p class="text-[12.5px] text-text-secondary">Release jako część MVP. Monitoring KPI 24/7, A/B test gate-keep.</p>
            </div>
          </li>
        </ol>
