---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../lib/app-url';
import PhoneFrame from '../components/mockups/PhoneFrame.astro';
import BottomNavOwner from '../components/mockups/BottomNavOwner.astro';
import OwnerHomeScreen from '../components/mockups/screens/OwnerHomeScreen.astro';
import OwnerStatsScreen from '../components/mockups/screens/OwnerStatsScreen.astro';
import OwnerFleetScreen from '../components/mockups/screens/OwnerFleetScreen.astro';

// Real screenshots panelu webowego — DRY array dla 5 stacked sekcji.
const webScreens = [
  {
    img: '/screens/owner-dashboard-web.png',
    alt: 'Dashboard webowy właściciela — zysk, przychód, koszty, aktywne zlecenia w czasie rzeczywistym',
    url: 'app.busikm.pl/dashboard',
    pre: 'Pierwszy ekran po zalogowaniu',
    title: 'Cała firma na jednym ekranie',
    desc: 'Zysk, przychód, koszty i aktywne zlecenia w jednym widoku. Wykres trójwarstwowy aktualizowany na żywo — przychód minus koszty to realna marża, bez czekania do końca miesiąca.',
    features: [
      'Cztery KPI z porównaniem do poprzedniego okresu',
      'Alert bar dokumentów wygasłych i zbliżających się do terminu',
      'Trend dzienny przychodu, kosztów i zysku dla wybranego miesiąca',
    ],
    reverse: false,
  },
  {
    img: '/screens/owner-fleet-map-web.png',
    alt: 'Mapa floty BusiKM — pozycje busów na żywo na mapie Europy',
    url: 'app.busikm.pl/mapa',
    pre: 'Mapa floty',
    title: 'Każdy bus widoczny na mapie Europy',
    desc: 'Pozycje aktualizowane na żywo, popup z numerem rejestracyjnym, kierowcą, statusem czasu pracy i czasem dojazdu. Bez dzwonienia do kierowcy — wszystko na ekranie.',
    features: [
      'Mapa 27 państw UE + EOG (Norwegia, Szwajcaria, Islandia, Liechtenstein)',
      'Status AETR kierowcy widoczny przy każdym pojeździe',
      'Trasy historyczne i aktywne zlecenia w jednym podglądzie',
    ],
    reverse: true,
  },
  {
    img: '/screens/owner-margin-per-order.png',
    alt: 'Marża per zlecenie — tabela rentowności w panelu webowym BusiKM',
    url: 'app.busikm.pl/zlecenia',
    pre: 'Rentowność zleceń',
    title: 'Marża na każdym zleceniu — bez Excela',
    desc: 'Pełna tabela zleceń z przychodem, kosztami i marżą procentową. Sortowanie po marży, filtry per kierowca, klient lub okres. Wiesz, które zlecenia naprawdę zarabiają.',
    features: [
      'Koszt rzeczywisty: paliwo, opłaty drogowe, hotele, diety kierowcy',
      'Przewalutowanie kosztów zagranicznych kursami NBP automatycznie',
      'Eksport listy do CSV i PDF dla księgowej lub biura rachunkowego',
    ],
    reverse: false,
  },
  {
    img: '/screens/owner-aetr-status-web.png',
    alt: 'AETR DriverActivity Engine — status czasu pracy kierowców',
    url: 'app.busikm.pl/aetr',
    pre: 'AETR · czas pracy kierowcy',
    title: 'Status każdego kierowcy — na bieżąco',
    desc: 'Jazda, przerwa, odpoczynek, dyspozycyjność — auto-detekcja z GPS. Alerty trzystopniowe (informacja, ostrzeżenie, naruszenie) zanim ITD wystawi mandat.',
    features: [
      'Walidacja zgodności z rozp. (WE) 561/2006 i Pakietem Mobilności UE',
      'Raporty PDF gotowe pod kontrolę ITD, BAG, Gendarmerie, Polizia Stradale',
      'Automatyczne przełączenie na konwencję AETR po przekroczeniu granicy UE',
    ],
    reverse: true,
  },
  {
    img: '/screens/owner-documents-web.png',
    alt: 'Centrum alertów dokumentów — terminy ważności OC, tachografu, licencji',
    url: 'app.busikm.pl/dokumenty',
    pre: 'Centrum alertów dokumentów',
    title: 'Co wygasa w przyszłym miesiącu — wiesz dzisiaj',
    desc: 'Wszystkie dokumenty floty i kierowców w jednym miejscu, posortowane po dniach do wygaśnięcia. Alerty 90 / 30 / 14 dni przed terminem — w mailu, push i w panelu.',
    features: [
      'Tachograf G2V2, OC, AC, przegląd techniczny, licencja transportowa',
      'Świadectwa kierowcy: ADR, kod 95, prawo jazdy, badania psychotechniczne',
      'Eksport listy dokumentów do PDF dla biura rachunkowego',
    ],
    reverse: false,
  },
];
---

<MarketingLayout
  title="Dla właścicieli firm transportowych — BusiKM e-TMS"
  description="e-TMS dla firm operujących busami 2,5–3,5 t w transporcie międzynarodowym. Pełna kontrola nad flotą — mapa floty na żywo, rentowność per zlecenie, koszty z całej UE w jednym miejscu, alerty G2V2 i Pakiet Mobilności."
>

<!-- ============ HERO ============ -->
<section class="relative overflow-hidden bg-surface">
  <div class="absolute top-[-120px] left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full bg-[#005CE8]/[0.04] blur-[120px] pointer-events-none"></div>

  <div class="relative max-w-[1120px] mx-auto px-4 sm:px-6 pt-24 pb-16 sm:pt-32 sm:pb-20">
    <div class="max-w-[760px] reveal">
      <!-- pill badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#005CE8]/15 bg-[#005CE8]/[0.04] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#005CE8] animate-pulse"></span>
        <span class="text-[12.5px] font-medium text-[#005CE8] tracking-[0.01em]">e-TMS dla właścicieli · transport międzynarodowy busami 2,5–3,5 t</span>
      </div>

      <!-- headline -->
      <h1 class="font-display text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.08] tracking-[-0.035em] text-text mb-6">
        Wiesz, gdzie jest każdy bus.<br/>
        I ile naprawdę zarobiłeś na zleceniu.
      </h1>

      <!-- subtitle -->
      <p class="text-[clamp(1rem,2vw,1.15rem)] leading-relaxed text-text-secondary max-w-[620px] mb-10">
        BusiKM łączy mapę floty na żywo, ewidencję czasu pracy AETR, rentowność każdego zlecenia w EUR i alerty dokumentów w jednym panelu. Faktury z paliwa z DE, opłaty Maut, hotele we Włoszech — wszystko w jednym widoku, bo KSeF tych dokumentów nie obsłuży.
      </p>

      <!-- CTA -->
      <div class="flex flex-wrap gap-3 mb-12">
        <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#005CE8] text-white text-[15px] font-semibold hover:bg-[#003FAD] transition-colors shadow-[0_1px_3px_rgba(0,92,232,0.4)]">
          Wypróbuj demo
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/funkcje" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-border text-text text-[15px] font-semibold hover:bg-surface-2 transition-colors">
          Zobacz funkcje
        </a>
      </div>

      <!-- stats -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { num: '2 lip 2026', label: 'obowiązek tachografu G2V2' },
          { num: '30 000 €', label: 'kara za naruszenie pakietu mobilności' },
          { num: '6\u20138%', label: 'typowa marża netto\u00A0\u2014\u00A0każde zł błędu boli' },
        ].map(s => (
          <div>
            <div class="font-display text-[clamp(1.4rem,2.6vw,1.75rem)] font-bold tracking-[-0.03em] text-text">{s.num}</div>
            <div class="text-[12.5px] text-text-tertiary mt-1 leading-snug">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ============ PANEL WEBOWY — 5 REAL SCREENS ============ -->
<section class="py-16 sm:py-20 bg-surface-2 px-5 border-t border-border-subtle">
  <div class="max-w-[820px] mx-auto text-center reveal">
    <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#005CE8] mb-4">Panel webowy</p>
    <h2 class="font-display text-[clamp(1.85rem,4vw,2.6rem)] font-bold tracking-[-0.025em] leading-[1.1] text-text mb-4">
      Tak wygląda BusiKM u właściciela busiarskiej firmy.
    </h2>
    <p class="text-[15px] leading-relaxed text-text-secondary">
      Pięć ekranów, które oglądasz codziennie — od dashboardu po centrum alertów dokumentów. Wszystko w jednym panelu, dostępne z każdego komputera i tabletu.
    </p>
  </div>
</section>

{webScreens.map((s, idx) => (
  <section class:list={['py-16 sm:py-20 px-5', idx % 2 === 0 ? 'bg-surface' : 'bg-surface-2']}>
    <div class="max-w-[1180px] mx-auto">
      <div class:list={['grid lg:grid-cols-[1fr_1.4fr] gap-8 sm:gap-12 items-center reveal', s.reverse ? 'lg:grid-flow-col-dense' : '']}>

        <!-- Text -->
        <div class:list={['lg:pr-4', s.reverse ? 'lg:col-start-2' : '']}>
          <p class="text-[11.5px] font-bold uppercase tracking-[0.1em] text-[#005CE8] mb-3">{s.pre}</p>
          <h3 class="font-display text-[clamp(1.45rem,2.8vw,2.05rem)] font-bold tracking-[-0.02em] text-text leading-[1.15] mb-4">
            {s.title}
          </h3>
          <p class="text-[15px] leading-relaxed text-text-secondary mb-5">{s.desc}</p>
          <ul class="space-y-2.5">
            {s.features.map((f) => (
              <li class="flex items-start gap-2.5 text-[13.5px] text-text leading-snug">
                <svg class="w-4 h-4 text-[#34C759] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Screenshot with browser chrome -->
        <div class:list={[s.reverse ? 'lg:col-start-1 lg:row-start-1' : '']}>
          <div class="rounded-[14px] overflow-hidden shadow-[0_8px_40px_rgba(0,0,0,0.10)] border border-border-subtle">
            <div class="flex items-center gap-2 px-4 py-2.5 bg-[#F5F5F7] dark:bg-[#16161A] border-b border-border-subtle">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
              <span class="ml-3 text-[10.5px] text-text-tertiary font-mono">{s.url}</span>
            </div>
            <img src={s.img} alt={s.alt} class="w-full h-auto block" loading="lazy" />
          </div>
        </div>

      </div>
    </div>
  </section>
))}

<!-- ============ APP PREVIEW — 3 EKRANY MOBILE ============ -->
<section class="py-20 sm:py-28 bg-surface px-5 border-t border-border-subtle">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal text-center max-w-[680px] mx-auto mb-12 sm:mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border-subtle text-[11px] font-semibold uppercase tracking-[0.08em] text-text-tertiary mb-5">Aplikacja właściciela</span>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.6rem)] font-bold tracking-[-0.025em] leading-[1.1] text-text mb-4">
        Cała flota w kieszeni. Bez logowania do laptopa.
      </h2>
      <p class="text-[15px] leading-relaxed text-text-secondary">
        Przegląd kierowców w trasie, statystyki tygodniowe i mapa floty na żywo. Dokładnie te same dane co panel webowy — tylko że pod ręką w dowolnym momencie.
      </p>
    </div>

    <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-12 justify-items-center items-end">
      <div class="flex flex-col items-center gap-5 max-w-[300px]">
        <PhoneFrame label="Przegląd floty — aplikacja właściciela" width={280}>
          <OwnerHomeScreen />
          <BottomNavOwner slot="nav" active="home" />
        </PhoneFrame>
        <div class="text-center">
          <h3 class="font-display text-[1.05rem] font-bold tracking-[-0.01em] text-text mb-1.5">Kto, gdzie, jak długo</h3>
          <p class="text-[13px] leading-snug text-text-secondary">Lista kierowców z aktualnym statusem AETR, lokalizacją i czasem jazdy. LIVE — odświeża się przy każdym update z aplikacji w kabinie.</p>
        </div>
      </div>

      <div class="flex flex-col items-center gap-5 max-w-[300px]">
        <PhoneFrame label="Statystyki tygodniowe floty" width={280}>
          <OwnerStatsScreen />
          <BottomNavOwner slot="nav" active="stats" />
        </PhoneFrame>
        <div class="text-center">
          <h3 class="font-display text-[1.05rem] font-bold tracking-[-0.01em] text-text mb-1.5">Statystyki tygodniowe</h3>
          <p class="text-[13px] leading-snug text-text-secondary">Przychód, koszty, dystans i trend kosztów per dzień. Dane z każdego zlecenia, paragonu i tankowania — bez ręcznego zbierania.</p>
        </div>
      </div>

      <div class="flex flex-col items-center gap-5 max-w-[300px]">
        <PhoneFrame label="Mapa floty z live tracking pojazdów" width={280}>
          <OwnerFleetScreen />
          <BottomNavOwner slot="nav" active="fleet" />
        </PhoneFrame>
        <div class="text-center">
          <h3 class="font-display text-[1.05rem] font-bold tracking-[-0.01em] text-text mb-1.5">Mapa floty na żywo</h3>
          <p class="text-[13px] leading-snug text-text-secondary">Każdy bus z prędkością i statusem na żywo. Klient pyta „gdzie jest paleta?" — odpowiadasz w 5 sekund, bez telefonu.</p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ============ 6 FILARÓW WARTOŚCI ============ -->
<section class="py-20 sm:py-28 bg-surface-2 px-5">
  <div class="max-w-[1120px] mx-auto">
    <div class="reveal text-center mb-14 max-w-[680px] mx-auto">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#005CE8] mb-4">Co dostaje właściciel</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15]">
        Sześć rzeczy które zmieniają sposób, w jaki zarządzasz flotą.
      </h2>
    </div>

    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {[
        {
          title: 'Mapa floty na żywo',
          desc: 'Mapa Europy z busami aktualizowanymi na żywo co kilkanaście sekund. Klikasz markera — widzisz: zlecenie, kierowca, ETA, czas pracy AETR, najbliższa stacja paliw.',
          tech: 'GPS w tle · pozycje na żywo · ETA per zlecenie',
          icon: `<path d="M9 4l-7 3v13l7-3 6 3 7-3V4l-7 3-6-3z" stroke-width="1.6"/><path d="M9 4v13M15 7v13" stroke-width="1.6"/>`,
          color: '#005CE8',
        },
        {
          title: 'Rentowność per zlecenie — na żywo',
          desc: 'Każde aktywne zlecenie ma w karcie: przychód (z umowy), koszty paliwa (PL+UE), opłaty drogowe (Maut, Telepass, Viatoll, ASFINAG), hotele, diety zagraniczne, amortyzację. Marża aktualizuje się od razu po dodaniu paragonu.',
          tech: 'Kalkulacja per zlecenie · NBP tabela A · 6 walut',
          icon: `<path d="M3 3v18h18" stroke-width="1.6"/><path d="M7 14l4-4 4 4 5-5" stroke-width="1.6"/>`,
          color: '#34C759',
        },
        {
          title: 'Faktury z UE → jedno miejsce',
          desc: 'KSeF nie obsługuje zagranicznych faktur kosztowych — ale Twoje 60% kosztów to właśnie one. BusiKM przyjmuje paragon ze zdjęcia, OCR czyta DE/IT/FR/ES/EN, przelicza walutę po kursie NBP z dnia poprzedzającego, przypisuje do zlecenia i pojazdu.',
          tech: 'OCR multi-język · NBP tabela A · auto-przypisanie',
          icon: `<rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.6"/><path d="M7 8h10M7 12h10M7 16h6" stroke-width="1.6"/>`,
          color: '#FF9500',
        },
        {
          title: 'Compliance pakietu mobilności',
          desc: 'Czas pracy AETR (4,5h jazdy + 45 min przerwy, 9h/11h dziennego odpoczynku, 45h tygodniowego), powrót do bazy co 4 tygodnie, rotacja co 8 tygodni, kabotaż 3 operacje w 7 dni. Alerty zanim kierowcę zatrzyma BAG, ITD, Gendarmerie czy Polizia Stradale.',
          tech: 'AETR · Pakiet Mobilności UE · ITD/BAG-ready',
          icon: `<circle cx="12" cy="12" r="9" stroke-width="1.6"/><path d="M12 7v5l3 3" stroke-width="1.6"/>`,
          color: '#8B5CF6',
          link: { href: '/aetr', label: 'Pełen silnik AETR — DriverActivity Engine' },
        },
        {
          title: 'Tachograf G2V2 i dokumenty',
          desc: 'Od 2 lipca 2026 obowiązek wymiany na G2V2 dla pojazdów >2,5 t w transporcie międzynarodowym. BusiKM pokazuje które pojazdy wymagają wymiany, kiedy, i alertuje 90/30/14/7 dni przed wszystkimi terminami: OC, AC, przegląd, legalizacja tachografu, licencja transportowa, ADR, świadectwa kierowców.',
          tech: 'Alerty 90/30/14/7 dni · push + e-mail',
          icon: `<path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-width="1.6"/><polyline points="22 4 12 14.01 9 11.01" stroke-width="1.6"/>`,
          color: '#FF3B30',
        },
        {
          title: 'Eksport dla księgowej i biura',
          desc: 'Twoja księgowa dostaje gotowe rejestry VAT, koszty per zlecenie, paczkę VAT-REF na zwrot z DE/FR/IT, raport tras GPS. Biuro rachunkowe importuje gotowe dane do Insert GT, Comarch ERP Optima lub Symfonia FK — natywny format każdego systemu, jednym kliknięciem.',
          tech: '3 systemy FK · jednym kliknięciem · CSV uniwersalny',
          icon: `<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke-width="1.6"/><polyline points="7 10 12 15 17 10" stroke-width="1.6"/><line x1="12" y1="15" x2="12" y2="3" stroke-width="1.6"/>`,
          color: '#0A84FF',
        },
      ].map(f => (
        <div class="bg-surface rounded-[20px] p-7 shadow-[0_1px_4px_rgba(0,0,0,0.06)] border border-transparent hover:border-border-subtle hover:shadow-[0_4px_20px_rgba(0,0,0,0.10)] transition-all duration-300 group">
          <div class="w-11 h-11 rounded-[14px] mb-5 flex items-center justify-center transition-transform duration-300 group-hover:scale-110" style={`background: ${f.color}12;`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-linecap="round" stroke-linejoin="round" set:html={f.icon}/>
          </div>
          <h3 class="font-display font-semibold text-[1.05rem] text-text mb-2 tracking-[-0.01em]">{f.title}</h3>
          <p class="text-[13.5px] leading-relaxed text-text-secondary mb-3">{f.desc}</p>
          <p class="text-[11px] font-mono text-text-tertiary">{f.tech}</p>
          {(f as any).link && (
            <a href={(f as any).link.href} class="inline-flex items-center gap-1.5 mt-3 text-[12px] font-semibold text-brand hover:underline">
              {(f as any).link.label}
              <svg width="11" height="11" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ TACHOGRAF G2V2 — DEEP DIVE ============ -->
<section class="py-20 sm:py-28 bg-surface px-5">
  <div class="max-w-[1000px] mx-auto">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-5">
        <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-[#FF3B30] mb-4">Termin krytyczny</p>
        <h2 class="font-display text-[clamp(1.8rem,4vw,2.4rem)] font-bold tracking-[-0.03em] text-text leading-[1.12] mb-5">
          Tachograf G2V2.<br/>2 lipca 2026.<br/>Bez planu — stoisz.
        </h2>
        <p class="text-[14.5px] leading-relaxed text-text-secondary mb-5">
          Od 2 lipca 2026 wszystkie pojazdy o DMC powyżej 2,5 t w transporcie międzynarodowym muszą mieć tachograf cyfrowy drugiej generacji wersja 2. Bez tego: kara ITD do 10 000 zł, zatrzymanie pojazdu na granicy i straty ze stojącego zlecenia.
        </p>
        <p class="text-[14.5px] leading-relaxed text-text-secondary">
          BusiKM pokazuje które pojazdy w Twojej flocie muszą zostać wymienione, jakie są terminy ostatecznych wymian (na podstawie daty pierwszej rejestracji) i kiedy zacząć rezerwować wizyty w serwisach.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-[20px] bg-surface-2 p-6 sm:p-7">
          <p class="text-[11px] font-semibold uppercase tracking-[0.06em] text-text-tertiary mb-4">Plan wymiany G2V2 — Twoja flota</p>
