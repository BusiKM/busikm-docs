---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { APP_LOGIN_URL } from '../lib/app-url';
import PhoneFrame from '../components/mockups/PhoneFrame.astro';
import BottomNavDriver from '../components/mockups/BottomNavDriver.astro';
import BottomNavOwner from '../components/mockups/BottomNavOwner.astro';
import DriverHomeScreen from '../components/mockups/screens/DriverHomeScreen.astro';
import OwnerHomeScreen from '../components/mockups/screens/OwnerHomeScreen.astro';

// FAQ na home — kluczowe pytania o program pilotażowy. Schema.org FAQPage
// generowany na końcu sekcji (BKM-291 SEO).
const homeFaq = [
  {
    q: 'Ile kosztuje BusiKM?',
    a: 'Jesteśmy na etapie programu pilotażowego. Pierwsze firmy i biura rachunkowe biorą udział dożywotnio gratis w zamian za feedback i miesięczną rozmowę. Cennik komercyjny zostanie ogłoszony po zakończeniu pilotażu — pilotażowi pozostaną na 0 zł na zawsze.',
  },
  {
    q: 'Jak dołączyć do pilotażu?',
    a: 'Umów się z nami na spotkanie 30 min — pokażemy aplikację, odpowiemy na pytania, sprawdzimy czy Twój przypadek pasuje do programu. Po pozytywnej weryfikacji firmy przygotowujemy komplet dokumentów i umów między naszymi firmami, a następnie wysyłamy Ci zaproszenie do programu pilotażowego z linkiem do rejestracji firmy lub biura rachunkowego.',
  },
  {
    q: 'Czy moje dane są bezpieczne?',
    a: 'Tak. Hosting w UE (Railway europe-west4), pełen GDPR compliance, JWT auth + httpOnly cookies, audit log każdej operacji. Multi-tenant izolacja danych — Twoja firma nie widzi danych innej.',
  },
  {
    q: 'Czy aplikacja działa offline?',
    a: 'Tak — aplikacja kierowcy (mobilna) ma pełen tryb offline. GPS, paragony, dokumenty zapisują się lokalnie i synchronizują automatycznie po powrocie zasięgu. Dla transportu międzynarodowego to kluczowe.',
  },
  {
    q: 'Czy współpracujemy z moją księgową?',
    a: 'Tak. BusiKM eksportuje faktury kosztowe do Insert GT, Comarch ERP Optima i Symfonia FK. Dla biur rachunkowych jest osobny panel multi-tenant — biuro obsługuje wielu klientów z jednego konta z osobnymi danymi i fakturowaniem za pojazd.',
  },
  {
    q: 'Co z tachografem G2V2 i deadline 2 lipca 2026?',
    a: 'BusiKM monitoruje legalizację tachografów G2V2 i ostrzega 14/30/90 dni przed wygaśnięciem. Aplikacja w pełni wspiera nowe regulacje UE (Mobility Package) — czasy pracy AETR, przerwy, powroty cotygodniowe.',
  },
];
---

<MarketingLayout
  title="BusiKM — e-TMS dla busów 2,5–3,5 t z AETR i księgowością"
  description="Pierwszy w Polsce e-TMS dla busów 2,5–3,5 t. AETR, tachograf G2V2, eksport do Insert/Comarch/Symfonia, KSeF, diety. MVP dostępne — szukamy firm do pilotażu (do 22 sierpnia 2026)."
>

<!-- ======================== HERO ======================== -->
<section class="relative flex flex-col items-center overflow-hidden bg-surface px-5">
  <div class="absolute inset-0 pointer-events-none">
    <div class="hero-glow absolute top-[-10%] left-1/2 -translate-x-1/2 w-[900px] h-[900px] rounded-full bg-[#005CE8]/[0.04] blur-[140px]"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-[#34C759]/[0.03] blur-[100px]"></div>
  </div>

  <div class="relative z-10 text-center max-w-[920px] mx-auto pt-20 sm:pt-28 pb-12">
    <div class="hero-seq-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#005CE8]/15 bg-[#005CE8]/[0.04] mb-10">
      <span class="w-1.5 h-1.5 rounded-full bg-[#005CE8] animate-pulse"></span>
      <span class="text-[12px] font-semibold uppercase tracking-[0.08em] text-[#005CE8]">Pierwszy e-TMS dla busów 2,5–3,5 t · nie dla TIRów</span>
    </div>

    <h1 class="hero-seq-2 font-display text-[clamp(2.6rem,7vw,5.25rem)] font-bold leading-[1.12] tracking-[-0.03em] text-text mb-6">
      <span class="block">e-TMS dla firm</span>
      <span class="block bg-gradient-to-r from-[#005CE8] to-[#3380FF] bg-clip-text text-transparent pb-2">operujących busami 2,5–3,5&nbsp;t</span>
    </h1>

    <p class="hero-seq-3 text-[clamp(1.05rem,2vw,1.3rem)] leading-[1.55] text-text-secondary max-w-[720px] mx-auto mb-4">
      BusiKM to <strong class="text-text">e-TMS</strong> — Transport Management System nowej generacji — zaprojektowany od zera pod transport międzynarodowy busami klasy 2,5–3,5&nbsp;t. Segment, dla którego nie ma na rynku dedykowanego oprogramowania. <strong class="text-text">Nie konkurujemy z TMS-ami dla flot TIR-owych</strong> — mamy własny segment, własne reguły, własną stawkę. Łączymy zarządzanie flotą, zleceniami, czasem pracy kierowców (AETR), tachografem G2V2 i&nbsp;eksportem do polskich systemów księgowych w jednym narzędziu.
    </p>

    <p class="hero-seq-3 text-[12.5px] text-text-tertiary mb-10">
      MVP dostępne od 19 czerwca 2026 · pilotaż do 22 sierpnia 2026 · dożywotnio gratis dla pilotów · 100% RODO
    </p>

    <div class="hero-seq-4 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={APP_LOGIN_URL} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-brand text-white text-[15px] font-semibold tracking-[-0.01em] hover:bg-brand-dark transition-all duration-200" style="box-shadow:0 1px 3px rgba(0,92,232,0.4)">
        Zaloguj
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/funkcje" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-border text-text text-[15px] font-semibold tracking-[-0.01em] hover:bg-surface-2 transition-all duration-200">
        Co umie BusiKM
      </a>
    </div>

    <!-- WOW pasek — konkretne value-prop trafiające w bóle właściciela -->
    <div class="hero-seq-5 mt-14 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-[1000px] mx-auto">
      <div class="p-4 sm:p-5 rounded-2xl bg-surface-2 border border-border-subtle text-left">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[#FF9500]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L3 7v6c0 5 3.5 9.5 9 11 5.5-1.5 9-6 9-11V7l-9-5z"/><path d="M9 12l2 2 4-4"/></svg>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-[#FF9500]">Tachograf G2V2</p>
        </div>
        <p class="text-[13.5px] font-semibold text-text leading-snug mb-1">Gotowi na deadline 2 lipca 2026</p>
        <p class="text-[11.5px] text-text-tertiary leading-snug">Monitoring legalizacji, alerty 90/30/14 dni, kara ITD do 10 000 zł odsunięta.</p>
      </div>
      <div class="p-4 sm:p-5 rounded-2xl bg-surface-2 border border-border-subtle text-left">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[#005CE8]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="14" x2="9" y2="20"/><line x1="15" y1="14" x2="15" y2="20"/></svg>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-[#005CE8]">Diety zagraniczne</p>
        </div>
        <p class="text-[13.5px] font-semibold text-text leading-snug mb-1">Rozliczenie kierowcy w 5 minut</p>
        <p class="text-[11.5px] text-text-tertiary leading-snug">Stawki MPiPS Dz.U. 2013 poz. 167, per kraj per dzień, automat z trasy GPS.</p>
      </div>
      <div class="p-4 sm:p-5 rounded-2xl bg-surface-2 border border-border-subtle text-left">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[#34C759]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-[#34C759]">VAT-REF z UE</p>
        </div>
        <p class="text-[13.5px] font-semibold text-text leading-snug mb-1">Odzyskaj VAT z paliwa, Mautu, promów</p>
        <p class="text-[11.5px] text-text-tertiary leading-snug">DE, FR, IT, AT — paczka roczna gotowa do wniosku. Tysiące zł rocznie.</p>
      </div>
      <div class="p-4 sm:p-5 rounded-2xl bg-surface-2 border border-border-subtle text-left">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[#8B5CF6]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.08em] text-[#8B5CF6]">Eksport FK</p>
        </div>
        <p class="text-[13.5px] font-semibold text-text leading-snug mb-1">Insert GT · Comarch · Symfonia · KSeF</p>
        <p class="text-[11.5px] text-text-tertiary leading-snug">Trzy największe polskie systemy księgowe, eksport jednym kliknięciem.</p>
      </div>
    </div>
  </div>

  <!-- Hero — real dashboard screenshot -->
  <div class="relative w-full max-w-[1100px] mx-auto px-5 pb-20 sm:pb-28">
    <div class="relative rounded-[16px] overflow-hidden shadow-[0_20px_80px_rgba(0,0,0,0.12)] border border-border-subtle bg-surface">
      <!-- Browser chrome -->
      <div class="flex items-center gap-2 px-5 py-3 bg-[#F5F5F7] dark:bg-[#16161A] border-b border-border-subtle">
        <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
        <div class="ml-4 flex-1 max-w-[300px] rounded-md bg-surface/70 px-3 py-1 text-[11px] text-text-tertiary font-mono">app.busikm.pl/dashboard</div>
        <div class="hidden sm:flex items-center gap-1.5 ml-auto">
          <span class="w-2 h-2 rounded-full bg-[#34C759] animate-pulse"></span>
          <span class="text-[11px] text-[#34C759] font-semibold">odświeżane na żywo</span>
        </div>
      </div>
      <img src="/screens/owner-dashboard-web.png" alt="Dashboard BusiKM — pełen przegląd firmy transportowej: zysk, przychód, koszty, aktywne zlecenia w czasie rzeczywistym" class="w-full h-auto block" loading="eager" decoding="async" />
    </div>

    <!-- Floating alert — Tachograf -->
    <div class="hidden md:flex absolute -top-3 -right-3 lg:top-8 lg:-right-6 z-10 bg-surface rounded-[14px] shadow-[0_8px_32px_rgba(0,0,0,0.16)] px-3.5 py-2.5 items-center gap-2.5 border border-border-subtle">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF3B30" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div>
        <p class="text-[10.5px] font-bold text-text">Tachograf Sprinter DK 12345</p>
        <p class="text-[10px] text-[#FF3B30]">Legalizacja wygasa za 14 dni</p>
      </div>
    </div>

    <!-- Floating success — marża -->
    <div class="hidden md:flex absolute -bottom-3 -left-3 lg:bottom-8 lg:-left-6 z-10 bg-surface rounded-[14px] shadow-[0_8px_32px_rgba(0,0,0,0.16)] px-3.5 py-2.5 items-center gap-2.5 border border-border-subtle">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34C759" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
      <div>
        <p class="text-[10.5px] font-bold text-text">Marża maj 2026</p>
        <p class="text-[10px] text-[#34C759]">35% · cel 32% osiągnięty</p>
      </div>
    </div>
  </div>

</section>

<!-- ======================== TRYBY WYŚWIETLANIA — DARK / LIGHT ======================== -->
<section class="bg-surface py-20 sm:py-28 px-5">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-12 reveal">
      <p class="text-[12.5px] font-semibold uppercase tracking-[0.1em] text-brand mb-4">Tryby wyświetlania</p>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.03em] text-text leading-[1.15] mb-4">
        Dwa tryby. Dbamy o Twój wzrok.
      </h2>
      <p class="text-[15px] text-text-secondary max-w-[640px] mx-auto leading-relaxed">
        Spędzasz przed laptopem długie godziny — od porannego rozliczania zleceń po wieczorne odbieranie potwierdzeń od kierowców na trasie. BusiKM ma tryb jasny i ciemny — przełączasz jednym kliknięciem, system zapamiętuje wybór per użytkownik.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 reveal-stagger">

      <!-- LIGHT MODE -->
      <article class="rounded-[20px] bg-[#F8FAFC] border border-[#E2E8F0] p-7 sm:p-9">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-[12px] bg-white shadow-[0_1px_3px_rgba(0,0,0,0.08)]">
              <svg class="w-4.5 h-4.5 text-[#FF9500]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </span>
            <p class="text-[11.5px] font-bold uppercase tracking-[0.08em] text-[#FF9500]">Tryb jasny</p>
          </div>
          <span class="text-[10.5px] font-mono text-[#94A3B8]">domyślny w dzień</span>
        </div>
        <h3 class="font-display text-[1.15rem] font-bold text-[#0F172A] mb-2 leading-snug">Praca w dzień, jasne biuro</h3>
        <p class="text-[13.5px] leading-relaxed text-[#475569] mb-5">
          Białe tło, ciepłe akcenty kolorów, kontrast tekstu zgodny z WCAG AA. Najlepszy w sztucznym świetle biurowym i przy oknie w słoneczny dzień.
        </p>
        <!-- Mini mock — light -->
        <div class="rounded-xl bg-white border border-[#E2E8F0] p-3.5 shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-[#FF5F57]"></span>
            <span class="w-2 h-2 rounded-full bg-[#FFBD2E]"></span>
            <span class="w-2 h-2 rounded-full bg-[#28C840]"></span>
            <span class="ml-2 text-[10px] text-[#94A3B8] font-mono">app.busikm.pl/dashboard</span>
          </div>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.06em] text-[#94A3B8] mb-1">Zysk · maj 2026</p>
          <p class="font-display text-[1.5rem] font-bold text-[#0F172A] mb-2 leading-none">6 226 zł</p>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#34C759]/15 text-[#34C759]">marża 35%</span>
            <span class="text-[10.5px] text-[#94A3B8]">cel 55 000 zł</span>
          </div>
          <div class="h-1 rounded-full bg-[#E2E8F0] overflow-hidden">
            <div class="h-full w-[11%] bg-[#34C759] rounded-full"></div>
          </div>
        </div>
      </article>

      <!-- DARK MODE -->
      <article class="rounded-[20px] bg-[#0F1115] border border-white/8 p-7 sm:p-9">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-[12px] bg-white/5 border border-white/10">
              <svg class="w-4.5 h-4.5 text-[#3380FF]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            </span>
            <p class="text-[11.5px] font-bold uppercase tracking-[0.08em] text-[#3380FF]">Tryb ciemny</p>
          </div>
          <span class="text-[10.5px] font-mono text-white/40">domyślny wieczorem</span>
        </div>
        <h3 class="font-display text-[1.15rem] font-bold text-white mb-2 leading-snug">Wieczorne planowanie tras</h3>
        <p class="text-[13.5px] leading-relaxed text-white/65 mb-5">
          Czarne tło, ograniczona luminancja, mniejsze zmęczenie oczu po godzinie 21:00. Akcenty kolorystyczne dopasowane do trybu ciemnego — bez krzykliwości.
        </p>
        <!-- Mini mock — dark -->
        <div class="rounded-xl bg-[#16191F] border border-white/8 p-3.5">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-[#FF5F57]"></span>
            <span class="w-2 h-2 rounded-full bg-[#FFBD2E]"></span>
            <span class="w-2 h-2 rounded-full bg-[#28C840]"></span>
            <span class="ml-2 text-[10px] text-white/40 font-mono">app.busikm.pl/dashboard</span>
          </div>
          <p class="text-[10.5px] font-bold uppercase tracking-[0.06em] text-white/40 mb-1">Zysk · maj 2026</p>
          <p class="font-display text-[1.5rem] font-bold text-white mb-2 leading-none">6 226 zł</p>
          <div class="flex items-center gap-2 mb-3">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#34C759]/20 text-[#34C759]">marża 35%</span>
            <span class="text-[10.5px] text-white/40">cel 55 000 zł</span>
          </div>
          <div class="h-1 rounded-full bg-white/8 overflow-hidden">
            <div class="h-full w-[11%] bg-[#34C759] rounded-full"></div>
          </div>
        </div>
      </article>

    </div>

    <p class="text-center mt-8 text-[13px] text-text-tertiary reveal">
      Przełącznik trybu w nagłówku każdej strony — wybór zapisywany lokalnie. Automatycznie szanuje preferencję systemową urządzenia.
    </p>
  </div>
</section>

<!-- ======================== APP PREVIEW — DWIE APLIKACJE ======================== -->
<section class="bg-surface-2 py-20 sm:py-28 px-5">
  <div class="max-w-[1100px] mx-auto">
    <div class="reveal text-center max-w-[720px] mx-auto mb-14 sm:mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border-subtle text-[11px] font-semibold uppercase tracking-[0.08em] text-text-tertiary mb-5">Aplikacja mobilna · iOS + Android</span>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.025em] leading-[1.1] text-text mb-4">
        Ten sam system. Dwie aplikacje.
      </h2>
      <p class="text-[15px] leading-relaxed text-text-secondary">
        Kierowca rejestruje trasę i paragony w 5 sekund. Właściciel widzi to natychmiast w swojej aplikacji. Bez papierów, bez Excela, bez maili.
      </p>
    </div>

    <div class="reveal grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-14 justify-items-center items-start max-w-[860px] mx-auto">
      <div class="flex flex-col items-center gap-5 max-w-[340px]">
        <PhoneFrame label="Aplikacja kierowcy — start trasy" width={280}>
          <DriverHomeScreen />
          <BottomNavDriver slot="nav" active="home" />
        </PhoneFrame>
        <div class="text-center">
          <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#005CE8] mb-2">Aplikacja kierowcy</p>
          <h3 class="font-display text-[1.15rem] font-bold tracking-[-0.01em] text-text mb-2">Trasa, paragony, AETR</h3>
          <p class="text-[13.5px] leading-relaxed text-text-secondary mb-3">Start trasy z OCR drogomierza, mapa z licznikiem czasu pracy, paragony z DE/IT/FR/ES jednym zdjęciem. Działa offline.</p>
          <a href="/dla-kierowcow" class="inline-flex items-center gap-1.5 text-[12.5px] font-semibold text-brand hover:text-brand-dark">
            Wszystkie ekrany kierowcy
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>

